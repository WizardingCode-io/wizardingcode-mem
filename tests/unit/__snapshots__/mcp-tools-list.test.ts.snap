exports[`MCP tool list with the default modules inside a project 1`] = `
{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search notes saved from earlier sessions in this project and its linked projects, by words and, when the optional model is installed, by meaning; returns one heading per note.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "kind": {
            "enum": [
              "decision",
              "fix",
              "gotcha",
              "convention",
              "change",
              "discovery",
            ],
            "type": "string",
          },
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer",
          },
          "project": {
            "description": "Only this project or one linked project (its name).",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "query": {
            "description": "Words, symbols or file names. Empty lists the most important notes.",
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "memory_search",
      "title": "Search memories",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Read saved notes in full, by the ids that memory_search returned.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ids": {
            "items": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "ids",
        ],
        "type": "object",
      },
      "name": "memory_get",
      "title": "Read memories",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Save something worth knowing in later sessions: a decision and its reason, a rule the user stated, a pitfall, a fix.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "files": {
            "description": "Project-relative paths it is about.",
            "items": {
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "importance": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
          },
          "kind": {
            "enum": [
              "decision",
              "fix",
              "gotcha",
              "convention",
              "change",
              "discovery",
            ],
            "type": "string",
          },
          "text": {
            "description": "Self-contained; the first sentence becomes the title.",
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "text",
          "kind",
        ],
        "type": "object",
      },
      "name": "memory_save",
      "title": "Save a memory",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search what was said in this project's past agent sessions, word for word, including before wizardingcode-mem was installed. Use it when memory_search finds nothing and the user refers to an earlier conversation.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "Words, symbols or file names.",
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "history_search",
      "title": "Search past conversations",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "List, link or unlink the projects whose notes this project reads (same product, or one it uses), and confirm or reject suggested links; only when the user asks.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "action": {
            "enum": [
              "list",
              "link",
              "unlink",
              "confirm",
              "reject",
            ],
            "type": "string",
          },
          "id": {
            "description": "For confirm and reject: a suggestion's id from list.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "kind": {
            "description": "For link: product (one product, both see each other) or uses (this project uses it, one way).",
            "enum": [
              "product",
              "uses",
            ],
            "type": "string",
          },
          "project": {
            "description": "For link and unlink: the other project, by name or key.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "action",
        ],
        "type": "object",
      },
      "name": "project_links",
      "title": "Link projects",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search this project's curated knowledge (decisions, rules, glossary, architecture, how-tos kept in its repository), by words and their forms; returns one heading per entry.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "Words, names or file names; their other forms are found too. Empty lists the entries.",
            "maxLength": 500,
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "knowledge_search",
      "title": "Search knowledge",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Read knowledge entries in full, by the slugs that knowledge_search returned.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slugs": {
            "items": {
              "description": "The entry's file name without .md.",
              "maxLength": 200,
              "type": "string",
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "slugs",
        ],
        "type": "object",
      },
      "name": "knowledge_get",
      "title": "Read knowledge",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Write a new knowledge entry into the project's repository (.wizardingcode/knowledge), only when the user asks to keep something as knowledge; never replaces an existing entry.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "body": {
            "description": "Markdown: the why, the consequences, links to code.",
            "maxLength": 50000,
            "minLength": 1,
            "type": "string",
          },
          "essential": {
            "description": "Shown at every session start; for the few that always matter.",
            "type": "boolean",
          },
          "kind": {
            "enum": [
              "decision",
              "rule",
              "glossary",
              "architecture",
              "howto",
            ],
            "type": "string",
          },
          "slug": {
            "description": "The file name without .md; from the title when left out.",
            "maxLength": 200,
            "type": "string",
          },
          "tags": {
            "items": {
              "maxLength": 60,
              "type": "string",
            },
            "maxItems": 20,
            "type": "array",
          },
          "title": {
            "description": "One line; it also names the file.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "title",
          "kind",
          "body",
        ],
        "type": "object",
      },
      "name": "knowledge_save",
      "title": "Save knowledge",
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Change an existing knowledge entry's fields or body (for example mark it superseded), only when the user asks.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "body": {
            "description": "Replaces the whole body.",
            "maxLength": 50000,
            "minLength": 1,
            "type": "string",
          },
          "essential": {
            "type": "boolean",
          },
          "kind": {
            "enum": [
              "decision",
              "rule",
              "glossary",
              "architecture",
              "howto",
            ],
            "type": "string",
          },
          "slug": {
            "description": "The entry's file name without .md.",
            "maxLength": 200,
            "type": "string",
          },
          "status": {
            "description": "superseded when it no longer holds.",
            "enum": [
              "active",
              "draft",
              "superseded",
            ],
            "type": "string",
          },
          "tags": {
            "description": "Replaces the tags.",
            "items": {
              "maxLength": 60,
              "type": "string",
            },
            "maxItems": 20,
            "type": "array",
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "slug",
        ],
        "type": "object",
      },
      "name": "knowledge_update",
      "title": "Update knowledge",
    },
  ],
}
`;

