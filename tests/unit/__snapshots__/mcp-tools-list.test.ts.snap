      },
      "name": "memory_projects",
      "title": "List projects",
    },
  ],
}
`;

exports[`the OpenCode bridge's names with memory alone an unknown name is refused with the names it accepts 1`] = `
"wizardingcode-mem tool: unknown tool "nope"
Usage: wizardingcode-mem tool <memory_search|memory_get|memory_save|history_search|project_links> --project <dir>  (JSON arguments on stdin)
       wizardingcode-mem tool <memory_search|memory_get|memory_save|history_search|memory_projects> --global   (every project)
"
`;

