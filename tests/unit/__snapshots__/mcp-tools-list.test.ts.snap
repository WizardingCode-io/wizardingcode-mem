exports[`the OpenCode bridge's names with the default modules an unknown name is refused with the names it accepts 1`] = `
"wizardingcode-mem tool: unknown tool "nope"
Usage: wizardingcode-mem tool <memory_search|memory_get|memory_save|history_search|project_links|knowledge_search|knowledge_get|knowledge_save|knowledge_update> --project <dir>  (JSON arguments on stdin)
       wizardingcode-mem tool <memory_search|memory_get|memory_save|history_search|memory_projects> --global   (every project)
"
`;
