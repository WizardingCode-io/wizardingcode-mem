      "title": "Save a memory",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search what was said in any of the user's projects' past agent sessions, word for word, including before wizardingcode-mem was installed; each result names its project. Use it when memory_search finds nothing and the user refers to an earlier conversation.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer",
          },
          "project": {
            "description": "Only this project (its name); every project when left out.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "query": {
            "description": "Words, symbols or file names.",
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "history_search",
      "title": "Search past conversations",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "List the user's projects, most recently active first, to pick one to save into.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
          },
        },
        "type": "object",
      },
      "name": "memory_projects",
      "title": "List projects",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search the team's curated knowledge (strategies, personas, patterns, facts kept on purpose) by words; one line per entry with its scope/slug, kind, area and version. Not for what happened in earlier sessions: that is memory_search.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "area": {
            "description": "An area id.",
            "type": "string",
          },
          "kind": {
            "enum": [
              "knowledge",
              "strategy",
              "persona",
              "pattern",
            ],
            "type": "string",
          },
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "Words. Empty lists the pinned entries, then the newest.",
            "type": "string",
          },
          "repo": {
            "enum": [
              "all",
              "workspace",
              "shared",
            ],
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "knowledge_search",
      "title": "Search knowledge",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Read knowledge entries whole, by the scope/slug references knowledge_search returned.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "refs": {
            "description": "scope/slug references, as knowledge_search returns them.",
            "items": {
              "pattern": "^(workspace|shared|project)\\/[a-z0-9][a-z0-9-]{0,79}$",
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "refs",
        ],
        "type": "object",
      },
      "name": "knowledge_get",
      "title": "Read knowledge",
    },
  ],
}
