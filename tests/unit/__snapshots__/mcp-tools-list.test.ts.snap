            "description": "For link and unlink: the other project, by name or key.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "action",
        ],
        "type": "object",
      },
      "name": "project_links",
      "title": "Link projects",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Search the team's curated knowledge (strategies, personas, patterns, facts kept on purpose) by words; one line per entry with its scope/slug, kind, area and version. Not for what happened in earlier sessions: that is memory_search.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "area": {
            "description": "An area id.",
            "type": "string",
          },
          "kind": {
            "enum": [
              "knowledge",
              "strategy",
              "persona",
              "pattern",
            ],
            "type": "string",
          },
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer",
          },
          "query": {
            "description": "Words. Empty lists the pinned entries, then the newest.",
            "type": "string",
          },
          "repo": {
            "enum": [
              "all",
              "workspace",
              "project",
              "shared",
            ],
            "type": "string",
          },
        },
        "required": [
          "query",
        ],
        "type": "object",
      },
      "name": "knowledge_search",
      "title": "Search knowledge",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true,
      },
      "description": "Read knowledge entries whole, by the scope/slug references knowledge_search returned.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "refs": {
            "description": "scope/slug references, as knowledge_search returns them.",
            "items": {
              "pattern": "^(workspace|shared|project)\\/[a-z0-9][a-z0-9-]{0,79}$",
              "type": "string",
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "refs",
        ],
        "type": "object",
      },
      "name": "knowledge_get",
      "title": "Read knowledge",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Propose a new knowledge entry, or a change to one (give its slug and base version). A person accepts it before it becomes knowledge; the area is one of the taxonomy's. Not for session facts, decisions or fixes: those are memory_save.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "area": {
            "description": "code: Code (workspace, shared); management: Management (workspace, shared); marketing: Marketing (workspace, shared); sales: Sales (workspace, shared); video: Video (workspace, shared); design: Design (workspace, shared); operations: Operations (workspace, shared); finance: Finance (workspace, shared); people: People (workspace, shared)",
            "enum": [
              "code",
              "management",
              "marketing",
              "sales",
              "video",
              "design",
              "operations",
              "finance",
              "people",
            ],
            "type": "string",
          },
          "base_version": {
            "description": "For a change: the entry's version the change is based on.",
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
          },
          "body": {
            "minLength": 1,
            "type": "string",
          },
          "context": {
            "maxLength": 120,
            "type": "string",
          },
          "kind": {
            "enum": [
              "knowledge",
              "strategy",
              "persona",
              "pattern",
            ],
            "type": "string",
          },
          "repo": {
            "enum": [
              "workspace",
              "project",
              "shared",
            ],
            "type": "string",
          },
          "slug": {
            "description": "For a change: the entry's slug.",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string",
          },
          "subject": {
            "maxLength": 120,
            "type": "string",
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "repo",
          "title",
          "kind",
          "area",
          "body",
        ],
        "type": "object",
      },
      "name": "knowledge_propose",
      "title": "Propose knowledge",
    },
  ],
}
`;

