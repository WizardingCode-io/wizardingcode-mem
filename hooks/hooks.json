{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/wizardingcode-mem.sh",
              "hook",
              "claude-code",
              "session-start"
            ],
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/wizardingcode-mem.sh",
              "hook",
              "claude-code",
              "prompt"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/wizardingcode-mem.sh",
              "hook",
              "claude-code",
              "turn-end"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/wizardingcode-mem.sh",
              "hook",
              "claude-code",
              "session-end"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/wizardingcode-mem.sh",
              "hook",
              "claude-code",
              "file-read"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/wizardingcode-mem.sh",
              "hook",
              "claude-code",
              "tool-failed"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
