{
  "id": "2026-11-08-001-record-why-the-drain-skips-a-turn-saved",
  "title": "Record why the drain skips a turn (saved, empty, not-worth, no-title) in turns.l",
  "input": "Record why the drain skips a turn (saved, empty, not-worth, no-title) in turns.last_error, count skips per reason in the drain report and in status, so a loss of knowledge after the memory-quality release is visible (docs/real-use/findings.md, row 11)",
  "type": "feature",
  "route": "standard",
  "routeReasons": [
    "feature, scope level 2, clear request"
  ],
  "riskAreas": [],
  "phase": "learn",
  "awaiting": "role",
  "criteria": [
    {
      "id": "AC-1",
      "kind": "behavior",
      "text": "A turn the drain skips keeps its reason in last_error: skip:saved when the agent saved a memory, skip:empty when no sentence is left after the filter, skip:not-worth when the verdict is below SAVE_THRESHOLD or kind none, skip:no-title when no sentence reaches KNOWLEDGE_THRESHOLD; a done turn has none"
    },
    {
      "id": "AC-2",
      "kind": "behavior",
      "text": "drainQueue's report counts skipped turns per reason (skippedBy) and the distill command prints them"
    },
    {
      "id": "AC-3",
      "kind": "behavior",
      "text": "status shows the project's skipped turns per reason; a skipped turn with no reason (from before this change) counts as unknown"
    }
  ],
