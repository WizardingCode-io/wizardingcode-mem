+    "## Turns where stripHost removed text",
+    "",
+    ...host.map(
+      (o) =>
+        `- ${o.item.turn} (${o.label.label})${o.quoteRemoved ? ": a quoted candidate is gone" : ""}`,
+    ),
+  ].join("\n");
+}
