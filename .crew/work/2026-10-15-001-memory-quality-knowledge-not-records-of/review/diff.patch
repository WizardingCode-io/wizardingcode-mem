+    ...lines,
+    "",
+    "## Every turn (full: never commit)",
+    "",
+    "| sample | turn | label | TypeSafe v1 | TypeSafe v2 | Heuristic v1 | Heuristic v2 |",
+    "|---|---|---|---|---|---|---|",
+    ...outcomes.map(
+      (o) =>
+        `| ${o.sample} | ${o.item.turn} | ${o.label.label} | ${VERSIONS.map((v) => shown(o, v)).join(" | ")} |`,
+    ),
+    "",
+    "## Lost by v2, kept by v1",
+    "",
+    ...v2LostV1Kept.map(
