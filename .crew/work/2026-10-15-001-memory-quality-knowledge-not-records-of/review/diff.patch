+/** `n` items drawn without replacement, in the order drawn. */
+export function sample<T>(items: T[], n: number, next: (max: number) => number): T[] {
+  const pool = [...items];
+  const out: T[] = [];
+  while (out.length < n && pool.length > 0) out.push(pool.splice(next(pool.length), 1)[0] as T);
+  return out;
+}
