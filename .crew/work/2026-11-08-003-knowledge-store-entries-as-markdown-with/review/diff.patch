+    expect(check.status).toBe("warn");
+    expect(check.detail).toContain(join(repo.path, "entries"));
+    expect(check.detail).toContain("a link");
+    expect(check.detail).toContain("0 entries");
+  });
+
+  test("a link where every project's repository goes is a warning, and nothing is read through it", () => {
+    writeEntry(store, WORKSPACE, change(), person());
+    // A repository of another folder, as the link would reach it.
+    const outside = join(fx.dir, "outside-projects");
+    mkdirSync(join(outside, "abc", ".git"), { recursive: true });
+    const projects = join(fx.dataDir, "knowledge", "projects");
+    rmSync(projects, { recursive: true, force: true });
+    symlinkSync(outside, projects);
+    const check = knowledge();
+    expect(check.status).toBe("warn");
+    expect(check.detail).toContain(projects);
+    expect(check.detail).not.toContain("abc");
+  });
+
+  test("with no database, a link where the project repositories go is still not read through", () => {
+    writeEntry(store, WORKSPACE, change(), person());
+    const outside = join(fx.dir, "outside-projects");
+    mkdirSync(join(outside, "abc", ".git"), { recursive: true });
+    const projects = join(fx.dataDir, "knowledge", "projects");
+    rmSync(projects, { recursive: true, force: true });
+    symlinkSync(outside, projects);
+    const elsewhere = join(fx.dir, "no-database-here");
+    mkdirSync(elsewhere);
+    const check = knowledge({ storeDir: elsewhere });
+    expect(check.status).toBe("warn");
+    expect(check.detail).toContain(projects);
+    expect(check.detail).not.toContain("abc");
+  });
+
+  /** The workspace and one project, an entry each; and a store directory that holds no database. */
+  function workspaceAndProject() {
+    const ref = { scope: "project", projectId: fx.addProject("path:/work/site") } as const;
+    writeEntry(store, WORKSPACE, change(), person());
+    writeEntry(store, ref, change({ title: "In the project" }), person());
+    const elsewhere = join(fx.dir, "no-database-here");
+    mkdirSync(elsewhere);
+    const relative = (openRepo(store, ref) as Repo).relative;
+    return { relative, folder: repoPath(fx.dataDir, relative), elsewhere };
+  }
+
+  test("a projects folder it cannot read is a warning that names it, with a database and with none", () => {
+    if (process.platform === "win32" || process.getuid?.() === 0) return;
+    const { elsewhere } = workspaceAndProject();
+    const projects = join(fx.dataDir, "knowledge", "projects");
+    // Neither listed nor searched; then listed and not searched.
+    for (const bits of [0o000, 0o600]) {
+      chmodSync(projects, bits);
+      try {
+        for (const check of [knowledge(), knowledge({ storeDir: elsewhere })]) {
+          expect(check.status).toBe("warn");
+          expect(check.detail).toContain(projects);
+          expect(check.detail).toContain("EACCES");
+        }
+      } finally {
+        chmodSync(projects, 0o700);
+      }
+    }
+    expect(knowledge({ storeDir: elsewhere }).detail).toContain("2 repositories, 2 entries");
+  });
+
+  test("a link or a file where a project's repository was is a warning that names it, and is never read through", () => {
+    const { relative, folder, elsewhere } = workspaceAndProject();
+    const aside = join(fx.dir, "moved-aside");
+    renameSync(folder, aside);
+    for (const [put, said] of [
+      [() => symlinkSync(aside, folder), "is a link"],
+      [() => writeFileSync(folder, "not a folder"), "is not a folder"],
+    ] as const) {
+      put();
+      for (const check of [knowledge(), knowledge({ storeDir: elsewhere })]) {
+        expect(check.status).toBe("warn");
+        expect(check.detail).toContain(`${relative}: ${folder} ${said}`);
+        // Neither counted nor read: the entry behind the link is not in the totals.
+        expect(check.detail).toContain("1 repository, 1 entry");
+      }
+      rmSync(folder, { force: true });
+    }
+  });
+
+  test("a link or a file where the workspace's repository was is a warning that names it, with a database and with none", () => {
+    const { elsewhere } = workspaceAndProject();
+    const folder = repoPath(fx.dataDir, "knowledge/workspace");
+    const aside = join(fx.dir, "moved-aside");
+    renameSync(folder, aside);
+    // Behind the link, a taxonomy without the area of the project's entry: read through
+    // the link, it would list that entry among the ones with problems.
+    const taxonomy = join(aside, "taxonomy.md");
+    writeFileSync(
+      taxonomy,
+      readFileSync(taxonomy, "utf8")
+        .split("\n")
+        .filter((line) => !line.includes("sales"))
+        .join("\n"),
+    );
+    for (const [put, said] of [
+      [() => symlinkSync(aside, folder), "is a link"],
+      [() => writeFileSync(folder, "not a folder"), "is not a folder"],
+    ] as const) {
+      put();
+      for (const check of [knowledge(), knowledge({ storeDir: elsewhere })]) {
+        expect(check.status).toBe("warn");
+        expect(check.detail).toContain(`knowledge/workspace: ${folder} ${said}`);
+        // The project's repository is still read, and nothing through the link.
+        expect(check.detail).toContain("1 repository, 1 entry");
+        expect(check.detail).not.toContain("in-the-project");
+      }
+      rmSync(folder, { force: true });
+    }
+  });
+
+  test("an entries folder it cannot read is a warning for that repository, and the others are still checked", () => {
+    if (process.platform === "win32" || process.getuid?.() === 0) return;
+    const { relative, folder, elsewhere } = workspaceAndProject();
+    const entries = join(folder, "entries");
+    for (const bits of [0o000, 0o600]) {
+      chmodSync(entries, bits);
+      try {
+        for (const check of [knowledge(), knowledge({ storeDir: elsewhere })]) {
+          expect(check.status).toBe("warn");
+          expect(check.detail).toContain(`${relative}: `);
+          expect(check.detail).toContain(entries);
+          expect(check.detail).toContain("EACCES");
+          expect(check.detail).toContain("2 repositories, 1 entry");
+        }
+      } finally {
+        chmodSync(entries, 0o700);
+      }
+    }
+  });
+
+  test("with no database, the checks that need it are skipped and said", () => {
+    writeEntry(store, WORKSPACE, change(), person());
+    const elsewhere = join(fx.dir, "no-database-here");
+    mkdirSync(elsewhere);
+    const check = knowledge({
+      storeDir: elsewhere,
+      env: env({ WIZARDINGCODE_MEM_AUTHOR: undefined }),
+      now: NOW,
+    });
+    expect(check.detail).toContain("no database");
+    expect(check.detail).not.toContain("no author configured");
+    expect(check.detail).toContain("1 repository");
+    expect(check.status).toBe("ok");
+  });
+});
diff --git a/tests/unit/knowledge-author.test.ts b/tests/unit/knowledge-author.test.ts
new file mode 100644
index 0000000..cd7ee45
--- /dev/null
+++ b/tests/unit/knowledge-author.test.ts
@@ -0,0 +1,150 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { agentWriter, identityOf, personAuthor } from "../../src/modules/knowledge/author.ts";
+import { KnowledgeError } from "../../src/modules/knowledge/errors.ts";
+import { resetGitCaches } from "../../src/modules/knowledge/repo.ts";
+import { openStore } from "../../src/modules/knowledge/store-open.ts";
+import { loadSettings, publicSettings, validatePatch } from "../../src/settings/settings.ts";
+import { type Db, openDb } from "../../src/store/db.ts";
+
+let dir: string;
+let home: string;
+let db: Db;
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "wizardingcode-mem-knowledge-author-"));
+  home = join(dir, "home");
+  mkdirSync(home);
+  db = openDb({ dataDir: dir, busyTimeoutMs: 2000 });
+  resetGitCaches();
+});
+afterEach(() => {
+  db.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+const storeWith = (env: Record<string, string | undefined>) =>
+  openStore({ db, dataDir: dir, env: { PATH: process.env.PATH, HOME: home, ...env } });
+
+function codeOf(fn: () => unknown): string | null {
+  try {
+    fn();
+  } catch (error) {
+    return error instanceof KnowledgeError ? error.code : `other: ${String(error)}`;
+  }
+  return null;
+}
+
+describe("the person's author name", () => {
+  test("the setting comes first", () => {
+    writeFileSync(join(home, ".gitconfig"), "[user]\n\tname = First Writer\n");
+    expect(personAuthor(storeWith({ WIZARDINGCODE_MEM_AUTHOR: "Zoë" }))).toEqual({
+      kind: "person",
+      name: "Zoë",
+      source: "setting",
+    });
+  });
+
+  test("then the global git user.name", () => {
+    writeFileSync(join(home, ".gitconfig"), "[user]\n\tname = First Writer\n");
+    expect(personAuthor(storeWith({}))).toEqual({
+      kind: "person",
+      name: "First Writer",
+      source: "git",
+    });
+  });
+
+  test("then the word you, named as the default", () => {
+    expect(personAuthor(storeWith({}))).toEqual({ kind: "person", name: "you", source: "default" });
+  });
+
+  test("the git name is looked up once per home", () => {
+    writeFileSync(join(home, ".gitconfig"), "[user]\n\tname = First Writer\n");
+    const store = storeWith({});
+    expect(personAuthor(store).name).toBe("First Writer");
+    writeFileSync(join(home, ".gitconfig"), "[user]\n\tname = Second Writer\n");
+    expect(personAuthor(store).name).toBe("First Writer");
+    resetGitCaches();
+    expect(personAuthor(store).name).toBe("Second Writer");
+  });
+
+  test("a setting that names an agent is dropped and the author falls through", () => {
+    expect(loadSettings({ WIZARDINGCODE_MEM_AUTHOR: "agent:x" }, dir).author).toBeNull();
+    expect(loadSettings({ WIZARDINGCODE_MEM_AUTHOR: "Zoë" }, dir).author).toBe("Zoë");
+    expect(loadSettings({}, dir).author).toBeNull();
+    expect(personAuthor(storeWith({ WIZARDINGCODE_MEM_AUTHOR: "agent:x" }))).toEqual({
+      kind: "person",
+      name: "you",
+      source: "default",
+    });
+  });
+
+  test("a git name that could pass for an agent is not taken", () => {
+    writeFileSync(join(home, ".gitconfig"), "[user]\n\tname = agent:codex\n");
+    expect(personAuthor(storeWith({})).source).toBe("default");
+  });
+
+  test("with no git at all the author is still the default", () => {
+    const empty = join(dir, "empty-bin");
+    mkdirSync(empty);
+    expect(personAuthor(storeWith({ PATH: empty }))).toEqual({
+      kind: "person",
+      name: "you",
+      source: "default",
+    });
+  });
+});
+
+describe("the settings key", () => {
+  test("validatePatch refuses an agent, a long name and a newline; accepts a name", () => {
+    expect(validatePatch({ WIZARDINGCODE_MEM_AUTHOR: "agent:x" }).ok).toBe(false);
+    expect(validatePatch({ WIZARDINGCODE_MEM_AUTHOR: "n".repeat(81) }).ok).toBe(false);
+    expect(validatePatch({ WIZARDINGCODE_MEM_AUTHOR: "a\nb" }).ok).toBe(false);
+    expect(validatePatch({ WIZARDINGCODE_MEM_AUTHOR: "n".repeat(80) }).ok).toBe(true);
+    expect(validatePatch({ WIZARDINGCODE_MEM_AUTHOR: "Zoë" })).toEqual({
+      ok: true,
+      changes: { WIZARDINGCODE_MEM_AUTHOR: "Zoë" },
+    });
+  });
+
+  test("publicSettings lists the key with its source", () => {
+    expect(
+      publicSettings({ WIZARDINGCODE_MEM_AUTHOR: "Zoë" }, dir).WIZARDINGCODE_MEM_AUTHOR,
+    ).toEqual({
+      value: "Zoë",
+      source: "env",
+    });
+    expect(publicSettings({}, dir).WIZARDINGCODE_MEM_AUTHOR).toEqual({
+      value: null,
+      source: "default",
+    });
+  });
+});
+
+describe("writers and identities", () => {
+  test("an agent id follows the host ids' pattern", () => {
+    expect(agentWriter("claude-code")).toEqual({ kind: "agent", id: "claude-code" });
+    expect(codeOf(() => agentWriter("Claude Code"))).toBe("invalid");
+    expect(codeOf(() => agentWriter(""))).toBe("invalid");
+  });
+
+  test("a person's e-mail comes from the name, at the .invalid domain", () => {
+    const hex = createHash("sha256").update("Zoë Writer").digest("hex").slice(0, 8);
+    expect(identityOf({ kind: "person", name: "Zoë Writer", source: "setting" })).toEqual({
+      name: "Zoë Writer",
+      email: `zoe-writer.${hex}@people.wizardingcode.invalid`,
+    });
+    const other = identityOf({ kind: "person", name: "Zoe Writer", source: "git" });
+    expect(other.email).not.toBe(`zoe-writer.${hex}@people.wizardingcode.invalid`);
+    expect(other.email).toEndWith("@people.wizardingcode.invalid");
+  });
+
+  test("an agent's identity names the agent", () => {
+    expect(identityOf({ kind: "agent", id: "codex" })).toEqual({
+      name: "agent:codex",
+      email: "codex@agents.wizardingcode.invalid",
+    });
+  });
+});
diff --git a/tests/unit/knowledge-entry.test.ts b/tests/unit/knowledge-entry.test.ts
