diff --git a/tests/helpers/knowledge.ts b/tests/helpers/knowledge.ts
new file mode 100644
index 0000000..0bd3c1f
--- /dev/null
+++ b/tests/helpers/knowledge.ts
@@ -0,0 +1,100 @@
+// What the knowledge store's tests share: a data directory, a throwaway home, a database,
+// and stores whose environment the test controls. No test touches the person's git
+// configuration or depends on the shell beyond `PATH`.
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { KnowledgeError } from "../../src/modules/knowledge/errors.ts";
+import { resetGitCaches } from "../../src/modules/knowledge/repo.ts";
+import { openStore } from "../../src/modules/knowledge/store-open.ts";
+import type { KnowledgeStore } from "../../src/modules/knowledge/types.ts";
+import { type Db, openDb } from "../../src/store/db.ts";
+
+export interface StoreOverrides {
+  env?: Record<string, string | undefined>;
+  now?: () => number;
+  gitTimeoutMs?: number;
+  dataDir?: string;
+}
+
+export interface Fixture {
+  dir: string;
+  dataDir: string;
+  home: string;
+  db: Db;
+  /** A store on the fixture's data directory; `env` is merged over `PATH` and `HOME`. */
+  store(overrides?: StoreOverrides): KnowledgeStore;
+  /** A `PATH` with `first` ahead of the test's own. */
+  pathWith(first: string): string;
+  /** A folder with no programs in it, for a `PATH` without git. */
+  emptyBin(): string;
+  /** A project row with its aliases; the first alias is its key. Returns the project id. */
+  addProject(...aliases: string[]): number;
+  close(): void;
+}
+
+export function knowledgeFixture(name: string): Fixture {
+  const dir = mkdtempSync(join(tmpdir(), `wizardingcode-mem-${name}-`));
+  const dataDir = join(dir, "data");
+  const home = join(dir, "home");
+  mkdirSync(dataDir);
+  mkdirSync(home);
+  const db = openDb({ dataDir, busyTimeoutMs: 2000 });
+  resetGitCaches();
+  return {
+    dir,
+    dataDir,
+    home,
+    db,
+    store: (overrides = {}) =>
+      openStore({
+        db,
+        dataDir: overrides.dataDir ?? dataDir,
+        env: { PATH: process.env.PATH, HOME: home, ...overrides.env },
+        ...(overrides.now === undefined ? {} : { now: overrides.now }),
+        ...(overrides.gitTimeoutMs === undefined ? {} : { gitTimeoutMs: overrides.gitTimeoutMs }),
+      }),
+    pathWith: (first) => `${first}:${process.env.PATH ?? ""}`,
+    emptyBin: () => {
+      const empty = join(dir, "empty-bin");
+      mkdirSync(empty, { recursive: true });
+      return empty;
+    },
+    addProject: (...aliases) => {
+      const key = aliases[0] as string;
+      const id = db
+        .query<{ id: number }, [string, string]>(
+          "INSERT INTO projects (key, name, created_at) VALUES (?, ?, 1) RETURNING id",
+        )
+        .get(key, key.split("/").pop() ?? key)?.id as number;
+      for (const alias of aliases) {
+        db.run("INSERT INTO project_aliases (alias, project_id) VALUES (?, ?)", [alias, id]);
+      }
+      return id;
+    },
+    close: () => {
+      db.close();
+      rmSync(dir, { recursive: true, force: true });
+    },
+  };
+}
+
+/** The code of the `KnowledgeError` a call throws; null when it does not throw. */
+export function codeOf(fn: () => unknown): string | null {
+  try {
+    fn();
+  } catch (error) {
+    return error instanceof KnowledgeError ? error.code : `other: ${String(error)}`;
+  }
+  return null;
+}
+
+/** The error a call throws, for a test that reads its message. */
+export function thrown(fn: () => unknown): Error {
+  try {
+    fn();
+  } catch (error) {
+    return error as Error;
+  }
+  throw new Error("expected the call to throw");
+}
diff --git a/tests/helpers/stub-git.ts b/tests/helpers/stub-git.ts
new file mode 100644
index 0000000..88be5b2
--- /dev/null
+++ b/tests/helpers/stub-git.ts
@@ -0,0 +1,97 @@
+import { chmodSync, mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+export interface StubBehaviour {
+  /** The first call of this subcommand exits 1 with `stderr`; later ones reach the real git. */
+  failOnce?: string;
+  /** Every call of this subcommand exits 1 with `stderr`. */
+  fail?: string;
+  /** Sleeps this long before anything else. */
+  sleepMs?: number;
+  stderr?: string;
+  /** What `--version` prints as the version. */
+  version?: string;
+  /** The script writes its environment here on every call. */
+  dumpEnvTo?: string;
+  /** Arguments put ahead of the caller's on every call that reaches the real git. */
+  prepend?: string[];
+}
+
+const REAL_GIT = Bun.which("git");
+
+const quoted = (value: string) => `'${value.replaceAll("'", "'\\''")}'`;
+
+/**
+ * Writes an executable `git` into `dir` that forwards to the real git, except for what
+ * `behaviour` asks. Returns the folder to put first on `PATH`.
+ *
+ * The subcommand is the first argument that does not start with `-` and is not the value
+ * of `--git-dir`, `--work-tree`, `-c` or `-C`.
+ */
+export function stubGit(dir: string, behaviour: StubBehaviour): string {
+  if (REAL_GIT === null) throw new Error("stubGit needs a real git on PATH");
+  mkdirSync(dir, { recursive: true });
+  const stderr = quoted(behaviour.stderr ?? "fatal: stub");
+  const lines = ["#!/bin/sh"];
+  if (behaviour.sleepMs !== undefined) lines.push(`sleep ${behaviour.sleepMs / 1000}`);
+  if (behaviour.dumpEnvTo !== undefined) lines.push(`env > ${quoted(behaviour.dumpEnvTo)}`);
+  if (behaviour.version !== undefined) {
+    // The caller's `-c` settings come before `--version`, so every argument is looked at.
+    lines.push(
+      'for arg in "$@"; do',
+      `  if [ "$arg" = "--version" ]; then echo ${quoted(`git version ${behaviour.version}`)}; exit 0; fi`,
+      "done",
+    );
+  }
+  lines.push(
+    'sub=""',
+    "skip=0",
+    'for arg in "$@"; do',
+    '  if [ "$skip" = 1 ]; then skip=0; continue; fi',
+    '  case "$arg" in',
+    "    --git-dir|--work-tree|-c|-C) skip=1 ;;",
+    "    -*) ;;",
+    '    *) sub="$arg"; break ;;',
+    "  esac",
+    "done",
+  );
+  if (behaviour.fail !== undefined) {
+    lines.push(`if [ "$sub" = ${quoted(behaviour.fail)} ]; then echo ${stderr} >&2; exit 1; fi`);
+  }
+  if (behaviour.failOnce !== undefined) {
+    const marker = quoted(join(dir, ".failed-once"));
+    lines.push(
+      `if [ "$sub" = ${quoted(behaviour.failOnce)} ] && [ ! -e ${marker} ]; then`,
+      `  : > ${marker}`,
+      `  echo ${stderr} >&2`,
+      "  exit 1",
+      "fi",
+    );
+  }
+  const prepended = (behaviour.prepend ?? []).map((arg) => `${quoted(arg)} `).join("");
+  lines.push(`exec ${quoted(REAL_GIT)} ${prepended}"$@"`);
+  const script = join(dir, "git");
+  writeFileSync(script, `${lines.join("\n")}\n`);
+  chmodSync(script, 0o755);
+  return dir;
+}
+
+/** The real git, for a test that inspects a repository itself. Never the stub. */
+export function realGit(cwd: string, ...args: string[]): string {
+  if (REAL_GIT === null) throw new Error("realGit needs a real git on PATH");
+  const result = Bun.spawnSync([REAL_GIT, ...args], {
+    cwd,
+    env: {
+      PATH: process.env.PATH ?? "",
+      GIT_CONFIG_NOSYSTEM: "1",
+      GIT_CONFIG_GLOBAL: "/dev/null",
+      GIT_TERMINAL_PROMPT: "0",
+    },
+    stdout: "pipe",
+    stderr: "pipe",
+  });
+  if (result.exitCode !== 0) {
+    throw new Error(`git ${args.join(" ")} failed: ${result.stderr.toString()}`);
+  }
+  return result.stdout.toString();
+}
