+    .query<{ key: string }, [string, string]>("SELECT key FROM meta WHERE key >= ? AND key < ?")
+    .all(KNOWLEDGE_LEASE_PREFIX, KNOWLEDGE_LEASE_END);
+  return keys.some((row) => leaseActive(db, row.key, now));
+}
