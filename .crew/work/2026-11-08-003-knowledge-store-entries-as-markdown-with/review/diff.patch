+    expect(moduleSchemaState(db, "knowledge", 6)).toBe("too-new");
+    db.close();
+    const again = open();
+    expect(moduleSchemaState(again, "knowledge", 6)).toBe("too-new");
+    expect(rows(again).map((row) => row.version)).toEqual([6, 7]);
