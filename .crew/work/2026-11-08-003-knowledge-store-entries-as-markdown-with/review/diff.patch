@@ -0,0 +1,53 @@
+// Who wrote a change. The store cannot tell a person from an agent: its caller says which,
+// and this file turns that into the name in the frontmatter and the identity on the commit.
+import { createHash } from "node:crypto";
+import { authorNameProblem } from "../../settings/settings.ts";
+import { AGENT_ID, slugify } from "./entry.ts";
+import { KnowledgeError } from "./errors.ts";
+import { gitUserName } from "./repo.ts";
+import type { AgentWriter, Identity, KnowledgeStore, PersonWriter, Writer } from "./types.ts";
+
+/** The name when nothing names the person. `source: "default"` tells it from a person named so. */
+const DEFAULT_NAME = "you";
+
+/** The author setting, else the global git `user.name`, else `you`. */
+export function personAuthor(store: KnowledgeStore): PersonWriter {
+  const setting = store.settings.author;
+  if (setting !== null) return { kind: "person", name: setting, source: "setting" };
+  const fromGit = gitUserName(store);
+  if (fromGit !== null && authorNameProblem(fromGit) === null) {
+    return { kind: "person", name: fromGit, source: "git" };
+  }
+  return { kind: "person", name: DEFAULT_NAME, source: "default" };
+}
+
+export function agentWriter(id: string): AgentWriter {
+  if (!AGENT_ID.test(id)) {
+    throw new KnowledgeError(
+      "invalid",
+      "agent id: lower-case letters, digits and hyphens, starting with a letter or a digit",
+    );
+  }
+  return { kind: "agent", id };
+}
+
+/**
+ * The commit identity. The addresses are at `.invalid`, a reserved domain that never
+ * routes: a commit names its writer without carrying anyone's real address.
+ */
+export function identityOf(writer: Writer): Identity {
+  if (writer.kind === "agent") {
+    return { name: `agent:${writer.id}`, email: `${writer.id}@agents.wizardingcode.invalid` };
+  }
+  // The hash keeps two names apart when their slugs are the same.
+  const hash = createHash("sha256").update(writer.name).digest("hex").slice(0, 8);
+  return {
+    name: writer.name,
+    email: `${slugify(writer.name)}.${hash}@people.wizardingcode.invalid`,
+  };
+}
+
+/** The `author` value of an entry: the person's name, or `agent:<id>`. */
+export function authorOf(writer: Writer): string {
+  return writer.kind === "agent" ? `agent:${writer.id}` : writer.name;
+}
diff --git a/src/modules/knowledge/entry.ts b/src/modules/knowledge/entry.ts
new file mode 100644
index 0000000..11b8691
--- /dev/null
+++ b/src/modules/knowledge/entry.ts
@@ -0,0 +1,547 @@
+// The file formats of the knowledge store: an entry, a proposal, the taxonomy. The
+// frontmatter is a small YAML subset this file reads and writes itself (no dependency):
+// `key: value` lines, plain scalars, double-quoted strings, whole numbers, block lists.
+// Parsing never throws: a file that cannot be read as an entry becomes a draft with a problem.
+import { clip } from "../../util/text.ts";
+import { KnowledgeError } from "./errors.ts";
+import type { KnowledgeEntry, KnowledgeProposal, ListItem, Taxonomy } from "./types.ts";
+
+export const KINDS = /^(?:knowledge|strategy|persona|pattern)$/;
+export const STATUSES = /^(?:active|draft|archived)$/;
+export const SLUG = /^[a-z0-9][a-z0-9-]*$/;
+export const AGENT_ID = /^[a-z0-9][a-z0-9-]*$/;
+export const AREA_ID = /^[a-z0-9][a-z0-9-]*$/;
+/** Lower case only: ids name files, and a case-insensitive file system must not merge two. */
+export const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;
+
+export const ENTRY_MAX_BYTES = 262144;
+export const TITLE_MAX = 200;
+export const FIELD_MAX = 120;
+export const LABEL_MAX = 60;
+export const AREA_MAX = 40;
+const SLUG_MAX = 80;
+/** Past this length a slug is cut at its last hyphen, so it does not end mid-word. */
+const SLUG_CUT_AFTER = 40;
+/** File names Windows refuses, whatever the extension. */
+const RESERVED = /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$/;
+
+export const DEFAULT_AREAS: { id: string; label: string }[] = [
+  { id: "code", label: "Code" },
+  { id: "management", label: "Management" },
+  { id: "marketing", label: "Marketing" },
+  { id: "sales", label: "Sales" },
+  { id: "video", label: "Video" },
+  { id: "design", label: "Design" },
+  { id: "operations", label: "Operations" },
+  { id: "finance", label: "Finance" },
+  { id: "people", label: "People" },
+];
+
+export function nowIso(ms: number): string {
+  return new Date(ms).toISOString();
+}
+
+// --- Slugs ------------------------------------------------------------------------
+
+export function slugify(title: string): string {
+  let slug = title
+    .normalize("NFKD")
+    .replace(/\p{M}+/gu, "")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "");
+  if (slug.length > SLUG_MAX) {
+    slug = slug.slice(0, SLUG_MAX);
+    const hyphen = slug.lastIndexOf("-");
+    if (hyphen > SLUG_CUT_AFTER) slug = slug.slice(0, hyphen);
+    slug = slug.replace(/-+$/, "");
+  }
+  if (slug === "") return "entry";
+  return RESERVED.test(slug) ? `${slug}-entry` : slug;
+}
+
+/** A caller's slug is checked, never normalised: what was asked is what is written, or nothing. */
+export function checkSlug(raw: string): string {
+  if (!SLUG.test(raw) || raw.length > SLUG_MAX || RESERVED.test(raw)) {
+    throw new KnowledgeError(
+      "invalid",
+      `slug: lower-case letters, digits and hyphens, starting with a letter or a digit, at most ${SLUG_MAX} characters, and not a reserved file name`,
+    );
+  }
+  return raw;
+}
+
+// --- Frontmatter ------------------------------------------------------------------
+
+export type FrontValue = string | number | ListItem[];
+
+export interface Frontmatter {
+  map: Map<string, FrontValue>;
+  order: string[];
+  body: string;
+  /** Each key's own lines as written (its list items included), for the keys kept verbatim. */
+  raw: Map<string, string[]>;
+}
+
+const KEY_LINE = /^([A-Za-z_][A-Za-z0-9_-]*):(?:[ \t]+(.*))?$/;
+const ITEM_LINE = /^[ \t]*-(?:[ \t]+(.*))?$/;
+const ITEM_PAIR = /^([^\s:"]+):(?:[ \t]+(.*))?$/;
+
+/** A double-quoted string with `\"` and `\\`; null when the quotes do not close the value. */
+function unquote(text: string): string | null {
+  let out = "";
+  for (let i = 1; i < text.length; i++) {
+    const char = text[i] as string;
+    if (char === "\\" && (text[i + 1] === '"' || text[i + 1] === "\\")) {
+      out += text[i + 1];
+      i++;
+    } else if (char === '"') {
+      return text.slice(i + 1).trim() === "" ? out : null;
+    } else {
+      out += char;
+    }
+  }
+  return null;
+}
+
+/** A whole number only when writing it back gives the same text, so `0012` and a long hash stay text. */
+function scalarOf(text: string): string | number | null {
+  const trimmed = text.trim();
+  if (trimmed.startsWith('"')) return unquote(trimmed);
+  if (/^\d+$/.test(trimmed)) {
+    const n = Number(trimmed);
+    if (Number.isSafeInteger(n) && String(n) === trimmed) return n;
+  }
+  return trimmed;
+}
+
+export function parseFrontmatter(text: string): Frontmatter | { problem: string } {
+  const lines = text.replace(/^﻿/, "").replaceAll("\r\n", "\n").split("\n");
+  if (lines[0]?.trimEnd() !== "---")
+    return { problem: "no frontmatter: the file does not start with ---" };
+  const end = lines.findIndex((line, index) => index > 0 && line.trimEnd() === "---");
+  if (end === -1) return { problem: "the frontmatter has no closing ---" };
+
+  const map = new Map<string, FrontValue>();
+  const raw = new Map<string, string[]>();
+  const order: string[] = [];
+  let listKey: string | null = null;
+  for (let i = 1; i < end; i++) {
+    const line = lines[i] as string;
+    const trimmed = line.trim();
+    if (trimmed === "" || trimmed.startsWith("#")) continue;
+
+    const key = KEY_LINE.exec(line);
+    if (key !== null) {
+      const name = key[1] as string;
+      if (map.has(name)) return { problem: `the frontmatter names ${name} twice` };
+      const value = scalarOf(key[2] ?? "");
+      if (value === null)
+        return { problem: `line ${i + 1}: the quoted value of ${name} does not close` };
+      map.set(name, value);
+      raw.set(name, [line]);
+      order.push(name);
+      // Only a key written with no value can be followed by a block list.
+      listKey = (key[2] ?? "").trim() === "" ? name : null;
+      continue;
+    }
+
+    const item = ITEM_LINE.exec(line);
+    if (item !== null && listKey !== null) {
+      const content = (item[1] ?? "").trim();
+      const pair = ITEM_PAIR.exec(content);
+      const value = scalarOf(pair === null ? content : (pair[2] ?? ""));
+      if (value === null) return { problem: `line ${i + 1}: a quoted value does not close` };
+      const list = map.get(listKey);
+      const items: ListItem[] = Array.isArray(list) ? list : [];
+      items.push(pair === null ? String(value) : { key: pair[1] as string, value: String(value) });
+      map.set(listKey, items);
+      raw.get(listKey)?.push(line);
+      continue;
+    }
+
+    return {
+      problem: `line ${i + 1} is neither key: value, a list item nor a comment: ${clipLine(trimmed)}`,
+    };
+  }
+
+  let body = lines.slice(end + 1).join("\n");
+  if (body.endsWith("\n")) body = body.slice(0, -1);
+  return { map, order, body, raw };
+}
+
+/** A line of a file, short enough to quote in a problem: 60 characters and an ellipsis. */
+const clipLine = (line: string): string => clip(line, 61, "…");
+
+const quote = (value: string) => `"${value.replaceAll("\\", "\\\\").replaceAll('"', '\\"')}"`;
+
+/** Plain where a plain scalar reads back as the same text, quoted otherwise. */
+function scalar(value: string): string {
+  return /^[A-Za-z0-9][^"\\\n]*$/.test(value) && value === value.trim() ? value : quote(value);
+}
+
+function document(lines: string[], body: string): string {
+  return `---\n${lines.join("\n")}\n---\n${body === "" ? "" : `${body}\n`}`;
+}
+
+// --- Reading the fields -----------------------------------------------------------
+
+/** Collects the first failures of one file; the row keeps what could be read. */
+class Reader {
+  readonly problems: string[] = [];
+  constructor(private readonly front: Frontmatter) {}
+
+  text(key: string): string | null {
+    const value = this.front.map.get(key);
+    if (value === undefined) return null;
+    if (Array.isArray(value)) {
+      this.problems.push(`${key} must be one value, not a list`);
+      return null;
+    }
+    return String(value);
+  }
+
+  /** A whole number of at least `min`, or null with a problem. Absent is null without one. */
+  whole(key: string, min: number, required: boolean): number | null {
+    const value = this.front.map.get(key);
+    if (value === undefined) {
+      if (required) this.problems.push(`${key} is missing`);
+      return null;
+    }
+    if (typeof value === "number" && value >= min) return value;
+    this.problems.push(`${key} must be a whole number from ${min}`);
+    return null;
+  }
+
+  /** The lines of every key outside `known`, in the file's order. */
+  extra(known: readonly string[]): string[] {
+    return this.front.order
+      .filter((key) => !known.includes(key))
+      .flatMap((key) => this.front.raw.get(key) ?? []);
+  }
+}
+
+interface Catalogued {
+  title: string;
+  kind: string;
+  area: string;
+  context: string;
+  subject: string;
+  status: string;
+}
+
+/** The fields an entry and a proposal share, checked the same way. */
+function catalogued(reader: Reader, fallbackTitle: string, taxonomy: Taxonomy | null): Catalogued {
+  const problems = reader.problems;
+  let title = reader.text("title") ?? "";
+  if (title === "") {
+    problems.push("title is missing");
+    title = fallbackTitle;
+  } else if (title.length > TITLE_MAX) {
+    problems.push(`title is over ${TITLE_MAX} characters`);
+  }
+
+  let kind = reader.text("kind") ?? "";
+  if (!KINDS.test(kind)) {
+    problems.push(kind === "" ? "kind is missing" : `kind ${clipLine(kind)} is not a kind`);
+    kind = "knowledge";
+  }
+
+  const area = reader.text("area") ?? "";
+  if (area === "") problems.push("area is missing");
+  else if (taxonomy !== null && !taxonomy.areas.some((known) => known.id === area)) {
+    problems.push(`area ${clipLine(area)} is not in the taxonomy`);
+  }
+
+  const free = (key: "context" | "subject") => {
+    const value = reader.text(key) ?? "";
+    if (value.length > FIELD_MAX) problems.push(`${key} is over ${FIELD_MAX} characters`);
+    return value;
+  };
+  const context = free("context");
+  const subject = free("subject");
+
+  let status = reader.text("status") ?? "";
+  if (!STATUSES.test(status)) {
+    problems.push(
+      status === "" ? "status is missing" : `status ${clipLine(status)} is not a status`,
+    );
+    status = "draft";
+  }
+  return { title, kind, area, context, subject, status };
+}
+
+const titleFromName = (name: string) => name.replace(/\.md$/, "").replaceAll("-", " ");
+
+const overCap = (text: string) =>
+  Buffer.byteLength(text) > ENTRY_MAX_BYTES
+    ? "the file is over 256 KiB, the cap for one file; it was not read"
+    : null;
+
+// --- An entry ---------------------------------------------------------------------
+
+const ENTRY_KEYS = [
+  "id",
+  "title",
+  "kind",
+  "area",
+  "context",
+  "subject",
+  "status",
+  "author",
+  "version",
+  "created",
+  "updated",
+  "supersedes",
+] as const;
+
+/** The row of a file that could not be read as an entry: listed by its name, with why. */
+export function unreadEntry(slug: string, problem: string): KnowledgeEntry {
+  return {
+    id: "",
+    slug,
+    title: titleFromName(slug),
+    kind: "knowledge",
+    area: "",
+    context: "",
+    subject: "",
+    status: "draft",
+    author: "",
+    version: 0,
+    created: null,
+    updated: null,
+    supersedes: null,
+    body: "",
+    extra: [],
+    problem,
+  };
+}
+
+/** `taxonomy` null skips the area check: for a caller that has no root repository to ask. */
+export function parseEntry(text: string, slug: string, taxonomy: Taxonomy | null): KnowledgeEntry {
+  const tooBig = overCap(text);
+  if (tooBig !== null) return unreadEntry(slug, tooBig);
+  const front = parseFrontmatter(text);
+  if ("problem" in front) return unreadEntry(slug, front.problem);
+
+  const reader = new Reader(front);
+  let id = reader.text("id") ?? "";
+  if (!UUID.test(id)) {
+    reader.problems.push(id === "" ? "id is missing" : "id is not a UUID");
+    id = "";
+  }
+  const fields = catalogued(reader, titleFromName(slug), taxonomy);
+  const version = reader.whole("version", 1, true) ?? 0;
+  const entry: KnowledgeEntry = {
+    id,
+    slug,
+    ...fields,
+    author: reader.text("author") ?? "",
+    version,
+    created: reader.text("created"),
+    updated: reader.text("updated"),
+    supersedes: reader.text("supersedes"),
+    body: front.body,
+    extra: reader.extra(ENTRY_KEYS),
+    problem: null,
+  };
+  if (reader.problems.length === 0) return entry;
+  // Listed, never counted active: a file with a problem is a draft whatever it says.
+  return { ...entry, status: "draft", problem: reader.problems.join("; ") };
+}
+
+export function renderEntry(entry: KnowledgeEntry): string {
+  const lines = [
+    `id: ${scalar(entry.id)}`,
+    `title: ${quote(entry.title)}`,
+    `kind: ${scalar(entry.kind)}`,
+    `area: ${scalar(entry.area)}`,
+    `context: ${quote(entry.context)}`,
+    `subject: ${quote(entry.subject)}`,
+    `status: ${scalar(entry.status)}`,
+    `author: ${quote(entry.author)}`,
+    `version: ${entry.version}`,
+  ];
+  if (entry.created !== null) lines.push(`created: ${scalar(entry.created)}`);
+  if (entry.updated !== null) lines.push(`updated: ${scalar(entry.updated)}`);
+  if (entry.supersedes !== null) lines.push(`supersedes: ${scalar(entry.supersedes)}`);
+  return document([...lines, ...entry.extra], entry.body);
+}
+
+// --- A proposal -------------------------------------------------------------------
+
+const PROPOSAL_KEYS = [
+  "id",
+  "entry",
+  "slug",
+  "base_version",
+  "base_hash",
+  "proposed_by",
+  "proposed_at",
+  "title",
+  "kind",
+  "area",
+  "context",
+  "subject",
+  "status",
+  "decision",
+  "decided_by",
+  "decided_at",
+  "decided_version",
+] as const;
+
+/** The row of a file that could not be read as a proposal. */
+export function unreadProposal(fileName: string, problem: string): KnowledgeProposal {
+  return {
+    id: "",
+    entryId: "",
+    slug: "",
+    baseVersion: 0,
+    baseHash: "",
+    proposedBy: "",
+    proposedAt: null,
+    title: titleFromName(fileName),
+    kind: "knowledge",
+    area: "",
+    context: "",
+    subject: "",
+    status: "draft",
+    body: "",
+    decision: null,
+    decidedBy: null,
+    decidedAt: null,
+    decidedVersion: null,
+    extra: [],
+    problem,
+  };
+}
+
+export function parseProposal(
+  text: string,
+  fileName: string,
+  taxonomy: Taxonomy | null,
+): KnowledgeProposal {
+  const tooBig = overCap(text);
+  if (tooBig !== null) return unreadProposal(fileName, tooBig);
+  const front = parseFrontmatter(text);
+  if ("problem" in front) return unreadProposal(fileName, front.problem);
+
+  const reader = new Reader(front);
+  const problems = reader.problems;
+  let id = reader.text("id") ?? "";
+  if (!UUID.test(id)) {
+    problems.push(id === "" ? "id is missing" : "id is not a UUID");
+    id = "";
+  }
+  // Kept as written even when malformed: the accept names it when it refuses.
+  const entryId = reader.text("entry") ?? "";
+  if (!UUID.test(entryId))
+    problems.push(entryId === "" ? "entry is missing" : "entry is not a UUID");
+  const slug = reader.text("slug") ?? "";
+  if (!SLUG.test(slug) || slug.length > SLUG_MAX) {
+    problems.push(slug === "" ? "slug is missing" : "slug is not a slug");
+  }
+  const baseVersion = reader.whole("base_version", 0, true) ?? 0;
+  const proposedBy = reader.text("proposed_by") ?? "";
+  if (proposedBy === "") problems.push("proposed_by is missing");
+  const fields = catalogued(reader, titleFromName(fileName), taxonomy);
+
+  const decided = reader.text("decision");
+  let decision: KnowledgeProposal["decision"] = null;
+  if (decided === "accepted" || decided === "rejected") decision = decided;
+  else if (decided !== null)
+    problems.push(`decision ${clipLine(decided)} is neither accepted nor rejected`);
+
+  const proposal: KnowledgeProposal = {
+    id,
+    entryId,
+    slug,
+    baseVersion,
+    baseHash: reader.text("base_hash") ?? "",
+    proposedBy,
+    proposedAt: reader.text("proposed_at"),
+    ...fields,
+    body: front.body,
+    decision,
+    decidedBy: reader.text("decided_by"),
+    decidedAt: reader.text("decided_at"),
+    decidedVersion: reader.whole("decided_version", 1, false),
+    extra: reader.extra(PROPOSAL_KEYS),
+    problem: null,
+  };
+  return problems.length === 0 ? proposal : { ...proposal, problem: problems.join("; ") };
+}
+
+export function renderProposal(proposal: KnowledgeProposal): string {
+  const lines = [
+    `id: ${scalar(proposal.id)}`,
+    `entry: ${scalar(proposal.entryId)}`,
+    `slug: ${scalar(proposal.slug)}`,
+    `base_version: ${proposal.baseVersion}`,
+    `base_hash: ${scalar(proposal.baseHash)}`,
+    `proposed_by: ${scalar(proposal.proposedBy)}`,
+  ];
+  if (proposal.proposedAt !== null) lines.push(`proposed_at: ${scalar(proposal.proposedAt)}`);
+  lines.push(
+    `title: ${quote(proposal.title)}`,
+    `kind: ${scalar(proposal.kind)}`,
+    `area: ${scalar(proposal.area)}`,
+    `context: ${quote(proposal.context)}`,
+    `subject: ${quote(proposal.subject)}`,
+    `status: ${scalar(proposal.status)}`,
+  );
+  if (proposal.decision !== null) lines.push(`decision: ${proposal.decision}`);
+  if (proposal.decidedBy !== null) lines.push(`decided_by: ${quote(proposal.decidedBy)}`);
+  if (proposal.decidedAt !== null) lines.push(`decided_at: ${scalar(proposal.decidedAt)}`);
+  if (proposal.decidedVersion !== null) lines.push(`decided_version: ${proposal.decidedVersion}`);
+  return document([...lines, ...proposal.extra], proposal.body);
+}
+
+// --- The taxonomy -----------------------------------------------------------------
+
+export function parseTaxonomy(text: string): Taxonomy | { problem: string } {
+  const tooBig = overCap(text);
+  if (tooBig !== null) return { problem: tooBig };
+  const front = parseFrontmatter(text);
+  if ("problem" in front) return front;
+
+  const reader = new Reader(front);
+  const version = reader.whole("version", 1, true);
+  const updated = reader.text("updated");
+  if (updated === null) reader.problems.push("updated is missing");
+  const list = front.map.get("areas");
+  const areas: Taxonomy["areas"] = [];
+  if (!Array.isArray(list)) reader.problems.push("areas must be a list of - id: Label items");
+  for (const item of Array.isArray(list) ? list : []) {
+    if (typeof item === "string") {
+      reader.problems.push(`area ${clipLine(item)} has no label`);
+      continue;
+    }
+    const { key: id, value: label } = item;
+    if (!AREA_ID.test(id) || id.length > AREA_MAX) {
+      reader.problems.push(`area id ${clipLine(id)} is not an area id`);
+    } else if (label.length === 0 || label.length > LABEL_MAX) {
+      reader.problems.push(`the label of ${id} must have 1 to ${LABEL_MAX} characters`);
+    } else if (areas.some((known) => known.id === id)) {
+      reader.problems.push(`area ${id} is listed twice`);
+    } else {
+      areas.push({ id, label });
+    }
+  }
+  if (reader.problems.length > 0 || version === null || updated === null) {
+    return { problem: reader.problems.join("; ") };
+  }
+  return { version, updated, areas };
+}
+
+export function renderTaxonomy(taxonomy: Taxonomy): string {
+  return document(
+    [
+      `version: ${taxonomy.version}`,
+      `updated: ${scalar(taxonomy.updated)}`,
+      "areas:",
+      ...taxonomy.areas.map((area) => `  - ${area.id}: ${scalar(area.label)}`),
+    ],
+    "",
+  );
+}
diff --git a/src/modules/knowledge/errors.ts b/src/modules/knowledge/errors.ts
new file mode 100644
index 0000000..d4c91e8
--- /dev/null
+++ b/src/modules/knowledge/errors.ts
@@ -0,0 +1,49 @@
+export type KnowledgeErrorCode =
+  | "invalid"
+  | "stale"
+  | "exists"
+  | "missing"
+  | "dirty"
+  | "locked"
+  | "git"
+  | "quota"
+  | "too-new";
+
+/** A refusal of the knowledge store. The code is what a caller branches on; the message is for the person. */
+export class KnowledgeError extends Error {
+  readonly code: KnowledgeErrorCode;
+
+  constructor(code: KnowledgeErrorCode, message: string) {
+    super(message);
+    this.name = "KnowledgeError";
+    this.code = code;
+  }
+}
+
+/**
+ * Whether an error is the store refusing what it was given as it stands (code `invalid`:
+ * a repository it did not make, or a request it cannot take), rather than a fault such as
+ * a missing git or a lease held elsewhere. The one place that says so: a command over
+ * several repositories sets a refusal aside and goes on.
+ */
+export const isRefusal = (error: unknown): error is KnowledgeError =>
+  error instanceof KnowledgeError && error.code === "invalid";
+
+/** A git call that was killed for running past its time: not the same as a git that is missing. */
+export class GitTimeoutError extends KnowledgeError {
+  constructor(message: string) {
+    super("git", message);
+    this.name = "GitTimeoutError";
+  }
+}
+
+/** The knowledge tables were written by a newer wizardingcode-mem. The store leaves them alone. */
+export class ModuleSchemaTooNewError extends KnowledgeError {
+  constructor(module: string, supported: number) {
+    super(
+      "too-new",
+      `the ${module} tables are newer than this wizardingcode-mem supports (${supported}); upgrade wizardingcode-mem`,
+    );
+    this.name = "ModuleSchemaTooNewError";
+  }
+}
diff --git a/src/modules/knowledge/index-store.ts b/src/modules/knowledge/index-store.ts
new file mode 100644
index 0000000..6a1aa73
--- /dev/null
+++ b/src/modules/knowledge/index-store.ts
@@ -0,0 +1,632 @@
+// The index of the knowledge store: rows in the engine's database, rebuilt from the files.
+// The files in the repositories are the truth; nothing here is the only copy of anything.
+import { join } from "node:path";
+import { withWrite } from "../../store/db.ts";
+import { parseEntry, parseProposal, UUID, unreadEntry, unreadProposal } from "./entry.ts";
+import { isRefusal, KnowledgeError } from "./errors.ts";
+import {
+  DECIDED_DIR,
+  ENTRIES_DIR,
+  fingerprintOf,
+  hashOf,
+  headOf,
+  kindAt,
+  knowledgeRoot,
+  lookAt,
+  namesIn,
+  OPEN_DIR,
+  openRepo,
+  readRegularFile,
+  repoPath,
+  statusOf,
+  taxonomyFor,
+  withRepoLeases,
+} from "./repo.ts";
+import { listRepos } from "./resolve.ts";
+import { requireSchema } from "./schema.ts";
+import type {
+  KnowledgeEntry,
+  KnowledgeProposal,
+  KnowledgeStore,
+  Repo,
+  ScopeRef,
+  Taxonomy,
+} from "./types.ts";
+
+/** A file with no usable id is indexed under its name, so it is listed and never lost. */
+const rowId = (id: string, name: string) =>
+  UUID.test(id) || id.startsWith("dup:") ? id : `file:${name}`;
+
+/**
+ * How a proposal file is named in such an id: with its folder, `open/<file>` or
+ * `decided/<file>`, since the same file name can sit under both.
+ */
+const proposalName = (path: string) => path.slice("proposals/".length);
+
+/** One row per slug: a problem row and a later good row for the same file never collide. */
+export function upsertEntry(
+  store: KnowledgeStore,
+  repoId: number,
+  entry: KnowledgeEntry,
+  path: string,
+  hash: string,
+): void {
+  store.db.run("DELETE FROM knowledge_entries WHERE repo_id = ? AND slug = ?", [
+    repoId,
+    entry.slug,
+  ]);
+  store.db.run(
+    `INSERT OR REPLACE INTO knowledge_entries
+       (repo_id, id, slug, path, title, kind, area, context, subject, status, author, version,
+        created, updated, supersedes, body, problem, hash)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    [
+      repoId,
+      rowId(entry.id, entry.slug),
+      entry.slug,
+      path,
+      entry.title,
+      entry.kind,
+      entry.area,
+      entry.context,
+      entry.subject,
+      entry.status,
+      entry.author,
+      entry.version,
+      entry.created,
+      entry.updated,
+      entry.supersedes,
+      entry.body,
+      entry.problem,
+      hash,
+    ],
+  );
+}
+
+/** The folder says whether a proposal is open; a decided one says how in its frontmatter. */
+function stateOf(proposal: KnowledgeProposal, path: string): "open" | "accepted" | "rejected" {
+  if (path.startsWith(`${OPEN_DIR}/`)) return "open";
+  return proposal.decision ?? "rejected";
+}
+
+/** A decided proposal is indexed without its body: the file keeps it. */
+export function upsertProposal(
+  store: KnowledgeStore,
+  repoId: number,
+  proposal: KnowledgeProposal,
+  path: string,
+  hash: string,
+): void {
+  const state = stateOf(proposal, path);
+  store.db.run(
+    `INSERT OR REPLACE INTO knowledge_proposals
+       (repo_id, id, path, state, entry_id, slug, base_version, base_hash, proposed_by,
+        proposed_at, decided_by, decided_at, decided_version, title, kind, area, context,
+        subject, status, body, problem, hash)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    [
+      repoId,
+      rowId(proposal.id, proposalName(path)),
+      path,
+      state,
+      proposal.entryId,
+      proposal.slug,
+      proposal.baseVersion,
+      proposal.baseHash,
+      proposal.proposedBy,
+      proposal.proposedAt,
+      proposal.decidedBy,
+      proposal.decidedAt,
+      proposal.decidedVersion,
+      proposal.title,
+      proposal.kind,
+      proposal.area,
+      proposal.context,
+      proposal.subject,
+      proposal.status,
+      state === "open" ? proposal.body : "",
+      proposal.problem,
+      hash,
+    ],
+  );
+}
+
+/**
+ * What the index was built from: `ensureFresh` compares these with the repository. A null
+ * fingerprint says the folders were not read as they are now, so the next refresh rebuilds.
+ */
+export function recordRepo(
+  store: KnowledgeStore,
+  repoId: number,
+  head: string | null,
+  fingerprint: string | null,
+  overCap: number,
+  dirtyChecked: boolean,
+): void {
+  store.db.run(
+    `UPDATE knowledge_repos
+        SET head = ?, fingerprint = ?, over_cap = ?, dirty_checked = ?, indexed_at = ?
+      WHERE id = ?`,
+    [head, fingerprint, overCap, dirtyChecked ? 1 : 0, store.now(), repoId],
+  );
+}
+
+/** The fingerprint the index holds for the repository; null when it holds none. */
+export function recordedFingerprint(store: KnowledgeStore, repo: Repo): string | null {
+  return (
+    store.db
+      .query<{ fingerprint: string | null }, [number]>(
+        "SELECT fingerprint FROM knowledge_repos WHERE id = ?",
+      )
+      .get(repo.id)?.fingerprint ?? null
+  );
+}
+
+/**
+ * Records the head and the fingerprint a write took before its transaction, keeping what
+ * the last rebuild found about the folders (the files over the cap, the dirty check).
+ */
+export function recordRepoAfter(
+  store: KnowledgeStore,
+  repo: Repo,
+  head: string | null,
+  fingerprint: string | null,
+): void {
+  const row = store.db
+    .query<{ over_cap: number; dirty_checked: number }, [number]>(
+      "SELECT over_cap, dirty_checked FROM knowledge_repos WHERE id = ?",
+    )
+    .get(repo.id);
+  recordRepo(
+    store,
+    repo.id,
+    head,
+    fingerprint,
+    row?.over_cap ?? 0,
+    (row?.dirty_checked ?? 1) === 1,
+  );
+}
+
+interface EntryRow {
+  id: string;
+  slug: string;
+  title: string;
+  kind: string;
+  area: string;
+  context: string;
+  subject: string;
+  status: string;
+  author: string;
+  version: number;
+  created: string | null;
+  updated: string | null;
+  supersedes: string | null;
+  body: string;
+  problem: string | null;
+}
+
+/** The repository's entries as indexed, by slug. Unknown frontmatter keys are in the files only. */
+export function listEntries(store: KnowledgeStore, repoId: number): KnowledgeEntry[] {
+  return store.db
+    .query<EntryRow, [number]>(
+      `SELECT id, slug, title, kind, area, context, subject, status, author, version, created,
+              updated, supersedes, body, problem
+         FROM knowledge_entries WHERE repo_id = ? ORDER BY slug`,
+    )
+    .all(repoId)
+    .map((row) => ({ ...row, extra: [] }));
+}
+
+interface ProposalRow {
+  id: string;
+  state: "open" | "accepted" | "rejected";
+  entry_id: string;
+  slug: string;
+  base_version: number;
+  base_hash: string;
+  proposed_by: string;
+  proposed_at: string | null;
+  decided_by: string | null;
+  decided_at: string | null;
+  decided_version: number | null;
+  title: string;
+  kind: string;
+  area: string;
+  context: string;
+  subject: string;
+  status: string;
+  body: string;
+  problem: string | null;
+}
+
+/** The repository's proposals as indexed: the open ones first, then by id. */
+export function listProposals(
+  store: KnowledgeStore,
+  repoId: number,
+  state?: "open" | "accepted" | "rejected",
+): KnowledgeProposal[] {
+  return store.db
+    .query<ProposalRow, [number, string | null, string | null]>(
+      `SELECT id, state, entry_id, slug, base_version, base_hash, proposed_by, proposed_at,
+              decided_by, decided_at, decided_version, title, kind, area, context, subject,
+              status, body, problem
+         FROM knowledge_proposals
+        WHERE repo_id = ? AND (? IS NULL OR state = ?)
+        ORDER BY state = 'open' DESC, id`,
+    )
+    .all(repoId, state ?? null, state ?? null)
+    .map((row) => ({
+      id: row.id,
+      entryId: row.entry_id,
+      slug: row.slug,
+      baseVersion: row.base_version,
+      baseHash: row.base_hash,
+      proposedBy: row.proposed_by,
+      proposedAt: row.proposed_at,
+      title: row.title,
+      kind: row.kind,
+      area: row.area,
+      context: row.context,
+      subject: row.subject,
+      status: row.status,
+      body: row.body,
+      decision: row.state === "open" ? null : row.state,
+      decidedBy: row.decided_by,
+      decidedAt: row.decided_at,
+      decidedVersion: row.decided_version,
+      extra: [],
+      problem: row.problem,
+    }));
+}
+
+/** Open proposals for one target: by entry id for an existing entry, by slug for a new one. */
+export function countOpen(
+  store: KnowledgeStore,
+  repoId: number,
+  target: { entryId: string } | { slug: string },
+): number {
+  const [column, value] =
+    "entryId" in target ? ["entry_id", target.entryId] : ["slug", target.slug];
+  return (
+    store.db
+      .query<{ n: number }, [number, string]>(
+        `SELECT count(*) AS n FROM knowledge_proposals WHERE repo_id = ? AND state = 'open' AND ${column} = ?`,
+      )
+      .get(repoId, value)?.n ?? 0
+  );
+}
+
+export function countOpenAll(store: KnowledgeStore, repoId: number): number {
+  return (
+    store.db
+      .query<{ n: number }, [number]>(
+        "SELECT count(*) AS n FROM knowledge_proposals WHERE repo_id = ? AND state = 'open'",
+      )
+      .get(repoId)?.n ?? 0
+  );
+}
+
+/** The root's taxonomy, or null when it does not exist or cannot be read: a rebuild never fails on it. */
+export function taxonomyOrNull(store: KnowledgeStore, repo: Repo): Taxonomy | null {
+  try {
+    return taxonomyFor(store, repo.ref);
+  } catch (error) {
+    if (error instanceof KnowledgeError) return null;
+    throw error;
+  }
+}
+
+/** How many names of one folder are indexed; the rest are counted, printed and warned about. */
+export const FOLDER_CAP = 5000;
+/** A long rebuild extends its leases once per this many files. */
+const RENEW_EVERY = 500;
+const CHANGED_OUTSIDE = "changed outside the engine; run wizardingcode-mem knowledge adopt";
+
+const also = (problem: string | null, more: string) =>
+  problem === null ? more : `${problem}; ${more}`;
+
+/**
+ * The names of a folder to index: the visible ones, in byte order so that two rebuilds
+ * agree, cut at the cap. Only `.md` files are knowledge; `over` counts what the cap left out.
+ * A folder that is not there holds none (git does not keep an empty one); a folder that
+ * cannot be listed is a refusal (`namesIn`), so its rows are never replaced by none.
+ */
+function listFolder(repo: Repo, folder: string): { names: string[]; over: number } {
+  const visible = namesIn(join(repo.path, ...folder.split("/")))
+    .filter((name) => !name.startsWith("."))
+    .sort((a, b) => Buffer.compare(Buffer.from(a), Buffer.from(b)));
+  return {
+    names: visible.slice(0, FOLDER_CAP).filter((name) => name.endsWith(".md")),
+    over: Math.max(0, visible.length - FOLDER_CAP),
+  };
+}
+
+/**
+ * A listed file's bytes, or why it was not read. A link, a folder or anything else that
+ * is not a regular file is never opened: it is listed with its problem. Null only for a
+ * name that went away since it was listed; a name that cannot be looked at is a refusal
+ * (`lookAt`), so a folder that lists and cannot be searched does not read as empty.
+ */
+function readListed(path: string): { bytes: Uint8Array } | { problem: string } | null {
+  const stat = lookAt(path);
+  if (stat === null) return null;
+  if (stat.isSymbolicLink()) {
+    return { problem: "a symbolic link; the knowledge store never follows links" };
+  }
+  if (!stat.isFile()) return { problem: "not a regular file" };
+  try {
+    const bytes = readRegularFile(path);
+    return bytes === null ? null : { bytes };
+  } catch (error) {
+    if (error instanceof KnowledgeError) return { problem: error.message };
+    throw error;
+  }
+}
+
+/** The paths git lists as changed; null when git cannot be asked, and the check is skipped. */
+function changedPaths(store: KnowledgeStore, repo: Repo): Set<string> | null {
+  try {
+    return new Set(statusOf(store, repo, [ENTRIES_DIR, "proposals"]).map((line) => line.slice(3)));
+  } catch (error) {
+    if (error instanceof KnowledgeError && error.code === "git") return null;
+    throw error;
+  }
+}
+
+export interface RebuildResult {
+  entries: number;
+  proposals: number;
+  open: number;
+  problems: number;
+  overCap: number;
+  dirtyChecked: boolean;
+}
+
+/** What a repository's files hold, read and parsed, before git or the database has a say. */
+export interface RepoFiles {
+  entries: { entry: KnowledgeEntry; path: string; hash: string }[];
+  proposals: { proposal: KnowledgeProposal; path: string; hash: string }[];
+  /** Files the folder caps left out. */
+  overCap: number;
+}
+
+/**
+ * Reads a repository's entries and proposals from its files. No file fails it: one that
+ * cannot be read, has no usable id, or shares another's id is listed under its name with
+ * its problem. What does fail it is a folder that cannot be listed, or a name in it that
+ * cannot be looked at: a refusal that names the path (`listFolder`, `readListed`), so
+ * that no caller replaces the repository's rows with fewer than its files. It touches
+ * neither git nor the database, so `doctor` reads the same way.
+ */
+export function readRepoFiles(store: KnowledgeStore, repo: Repo): RepoFiles {
+  const taxonomy = taxonomyOrNull(store, repo);
+  const decode = (bytes: Uint8Array) => new TextDecoder().decode(bytes);
+  let read = 0;
+  let overCap = 0;
+  const renewed = () => {
+    if (++read % RENEW_EVERY === 0) store.renew?.();
+  };
+
+  const entries: { entry: KnowledgeEntry; path: string; hash: string }[] = [];
+  const entryIds = new Map<string, string>();
+  const listed = listFolder(repo, ENTRIES_DIR);
+  overCap += listed.over;
+  for (const name of listed.names) {
+    const path = `${ENTRIES_DIR}/${name}`;
+    const slug = name.slice(0, -".md".length);
+    const file = readListed(join(repo.path, ENTRIES_DIR, name));
+    if (file === null) continue;
+    renewed();
+    let entry =
+      "problem" in file
+        ? unreadEntry(slug, file.problem)
+        : parseEntry(decode(file.bytes), slug, taxonomy);
+    if (UUID.test(entry.id)) {
+      // Of the files that share an id, the first name in byte order keeps it.
+      const first = entryIds.get(entry.id);
+      if (first === undefined) entryIds.set(entry.id, slug);
+      else {
+        entry = {
+          ...entry,
+          id: `dup:${slug}`,
+          status: "draft",
+          problem: also(
+            entry.problem,
+            `its id is also the id of ${first}; one of them needs its own`,
+          ),
+        };
+      }
+    }
+    entries.push({ entry, path, hash: "problem" in file ? "" : hashOf(file.bytes) });
+  }
+
+  const proposals: { proposal: KnowledgeProposal; path: string; hash: string }[] = [];
+  const proposalIds = new Set<string>();
+  // The open folder first: of an id under both folders, the open file keeps it.
+  for (const folder of [OPEN_DIR, DECIDED_DIR]) {
+    const names = listFolder(repo, folder);
+    overCap += names.over;
+    for (const name of names.names) {
+      const path = `${folder}/${name}`;
+      const file = readListed(join(repo.path, ...folder.split("/"), name));
+      if (file === null) continue;
+      renewed();
+      let proposal =
+        "problem" in file
+          ? unreadProposal(name, file.problem)
+          : parseProposal(decode(file.bytes), name, taxonomy);
+      if (UUID.test(proposal.id)) {
+        if (proposalIds.has(proposal.id)) {
+          proposal = {
+            ...proposal,
+            id: `dup:${proposalName(path)}`,
+            problem: also(proposal.problem, "its id is also the id of another proposal file"),
+          };
+        } else proposalIds.add(proposal.id);
+      }
+      // A file moved here by hand says nothing of how it was decided: listed, with why.
+      if (folder === DECIDED_DIR && proposal.decision === null && !("problem" in file)) {
+        proposal = {
+          ...proposal,
+          problem: also(proposal.problem, "under proposals/decided with no decision"),
+        };
+      }
+      proposals.push({ proposal, path, hash: "problem" in file ? "" : hashOf(file.bytes) });
+    }
+  }
+  return { entries, proposals, overCap };
+}
+
+/**
+ * Replaces the repository's rows with what its files hold, in one transaction. A file git
+ * lists as changed is a draft with a problem until a person adopts it.
+ */
+export function rebuildRepo(store: KnowledgeStore, repo: Repo): RebuildResult {
+  requireSchema(store);
+  // Taken before the files are read: a file added while they are read then shows as a
+  // fingerprint the index does not hold, and the next refresh reads the repository again.
+  const head = headOf(repo.path);
+  const fingerprint = fingerprintOf(repo.path);
+  const changed = changedPaths(store, repo);
+  const files = readRepoFiles(store, repo);
+  const { overCap } = files;
+  const entries = files.entries.map((file) =>
+    changed?.has(file.path)
+      ? {
+          ...file,
+          entry: {
+            ...file.entry,
+            status: "draft",
+            problem: also(file.entry.problem, CHANGED_OUTSIDE),
+          },
+        }
+      : file,
+  );
+  const proposals = files.proposals.map((file) =>
+    changed?.has(file.path)
+      ? {
+          ...file,
+          proposal: { ...file.proposal, problem: also(file.proposal.problem, CHANGED_OUTSIDE) },
+        }
+      : file,
+  );
+
+  store.renew?.();
+  withWrite(store.db, () => {
+    store.db.run("DELETE FROM knowledge_entries WHERE repo_id = ?", [repo.id]);
+    store.db.run("DELETE FROM knowledge_proposals WHERE repo_id = ?", [repo.id]);
+    for (const { entry, path, hash } of entries) upsertEntry(store, repo.id, entry, path, hash);
+    for (const { proposal, path, hash } of proposals) {
+      upsertProposal(store, repo.id, proposal, path, hash);
+    }
+    recordRepo(store, repo.id, head, fingerprint, overCap, changed !== null);
+  });
+  return {
+    entries: entries.length,
+    proposals: proposals.length,
+    open: proposals.filter(({ path }) => path.startsWith(`${OPEN_DIR}/`)).length,
+    problems:
+      entries.filter(({ entry }) => entry.problem !== null).length +
+      proposals.filter(({ proposal }) => proposal.problem !== null).length,
+    overCap,
+    dirtyChecked: changed !== null,
+  };
+}
+
+/** What a command over several repositories did: one result each, or why one was refused. */
+export type InEachRepo<T> = ReturnType<typeof listRepos> & {
+  results: Map<string, T>;
+  /** The repositories the store refused, each with why. */
+  refused: Map<string, string>;
+};
+
+/**
+ * Opens each listed repository of a scope (every scope when none is given) and does
+ * `work` in it. A repository the store refuses, at its opening or during the work, is set
+ * aside with why and does not stop the others; any other failure stops the command. A
+ * listed folder with no repository in it has no result. The one place this rule lives,
+ * for `rebuild`, `list` and `adopt`.
+ */
+export function inEachRepo<T>(
+  store: KnowledgeStore,
+  scope: ScopeRef["scope"] | undefined,
+  work: (repo: Repo) => T,
+): InEachRepo<T> {
+  const listed = listRepos(store);
+  const repos = listed.repos.filter((repo) => scope === undefined || repo.ref.scope === scope);
+  const results = new Map<string, T>();
+  const refused = new Map<string, string>();
+  for (const found of repos) {
+    try {
+      const repo = openRepo(store, found.ref);
+      if (repo !== null) results.set(repo.relative, work(repo));
+    } catch (error) {
+      if (!isRefusal(error)) throw error;
+      refused.set(found.relative, error.message);
+    }
+  }
+  return { ...listed, repos, results, refused };
+}
+
+/**
+ * Rebuilds every repository under the data directory (or every one of a scope), and
+ * forgets the rows of repositories whose folder is gone: the ones with nothing at their
+ * name. A link or a file put where a folder was is set aside by name, and its rows stay.
+ * A project folder is mapped to its project by its row, else through its manifest; a
+ * folder no project claims is reported and indexes nothing. Refused, with nothing
+ * forgotten, when the data directory has no knowledge folder at all and the index holds
+ * repositories: the rows are another data directory's until the person says otherwise.
+ */
+export function rebuildAll(
+  store: KnowledgeStore,
+  scope?: ScopeRef["scope"],
+): InEachRepo<RebuildResult> {
+  requireSchema(store);
+  const held = () =>
+    store.db
+      .query<{ id: number; scope: string; path: string }, []>(
+        "SELECT id, scope, path FROM knowledge_repos",
+      )
+      .all()
+      .filter((row) => scope === undefined || row.scope === scope);
+  // No knowledge folder at all under this data directory, and repositories in the index:
+  // they were written under another data directory that shares this database, or the
+  // folder was removed whole, and the store cannot tell which. Read as "every repository
+  // is gone", the first would forget the rows of repositories that are all still on the
+  // disk. So the person says which: an empty folder made by hand means they are gone.
+  const root = knowledgeRoot(store.dataDir);
+  const known = held().length;
+  if (known > 0 && kindAt(root) === "absent") {
+    throw new KnowledgeError(
+      "invalid",
+      `${root} is not there, and the index holds ${known === 1 ? "a repository" : `${known} repositories`} under it; nothing was forgotten. If the knowledge is under another data directory (WIZARDINGCODE_MEM_DATA_DIR, WIZARDINGCODE_HOME), run rebuild under that one. If the folder was removed on purpose, make it again, empty, and run rebuild once more`,
+    );
+  }
+  const all = inEachRepo(store, scope, (repo) =>
+    withRepoLeases(store, [repo.relative], () => rebuildRepo(store, repo)),
+  );
+  for (const row of held()) {
+    // Only a name with nothing at it is gone. A folder that cannot be looked at refuses
+    // the rebuild (`kindAt`); a link or a file put where the folder was has been set aside
+    // by name above (`inEachRepo`). The rows of both stay.
+    if (kindAt(repoPath(store.dataDir, row.path)) !== "absent") continue;
+    withWrite(store.db, () => {
+      store.db.run("DELETE FROM knowledge_entries WHERE repo_id = ?", [row.id]);
+      store.db.run("DELETE FROM knowledge_proposals WHERE repo_id = ?", [row.id]);
+      store.db.run("DELETE FROM knowledge_repos WHERE id = ?", [row.id]);
+    });
+  }
+  return all;
+}
+
+/** Rebuilds the repository's rows when its HEAD or its fingerprint is not what was indexed. */
+export function ensureFresh(store: KnowledgeStore, repo: Repo): void {
+  requireSchema(store);
+  const row = store.db
+    .query<{ head: string | null; fingerprint: string | null }, [number]>(
+      "SELECT head, fingerprint FROM knowledge_repos WHERE id = ?",
+    )
+    .get(repo.id);
+  if (row?.head === headOf(repo.path) && row.fingerprint === fingerprintOf(repo.path)) return;
+  rebuildRepo(store, repo);
+}
