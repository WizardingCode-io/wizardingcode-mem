+  LEVELS,
+  memoryUid,
+  ROOTS,
+  SHARE_AREA,
+  widens,
+} from "../../src/sharing/types.ts";
+
+const ROOTS_KEY = "WIZARDINGCODE_MEM_SHARE_ROOTS";
+const AREAS_KEY = "WIZARDINGCODE_MEM_SHARE_AREAS";
+
+const made: string[] = [];
