diff --git a/tests/unit/share-confirm.test.ts b/tests/unit/share-confirm.test.ts
new file mode 100644
index 0000000..09e73aa
--- /dev/null
+++ b/tests/unit/share-confirm.test.ts
@@ -0,0 +1,216 @@
+// The question a command asks before it lets more leave, and the lines `share status` prints.
+import { describe, expect, test } from "bun:test";
+import { confirmWidening, formatShareStatus } from "../../src/cli/commands/share.ts";
+import { askYesNo } from "../../src/cli/prompt.ts";
+import { policyWith } from "../../src/sharing/levels.ts";
+import type { Report } from "../../src/sharing/report.ts";
+import type { ChangeRow } from "../../src/sharing/store.ts";
+
+/** A terminal that answers with one line, and counts how often it was read. */
+function answering(line: string | null, isTTY = true) {
+  let reads = 0;
+  return {
+    io: {
+      isTTY,
+      read: () => {
+        reads++;
+        return line;
+      },
+    },
+    reads: () => reads,
+  };
+}
+
+/** What a call printed on standard output, and what it returned. */
+function captured<T>(fn: () => T): { result: T; printed: string } {
+  const write = process.stdout.write;
+  let printed = "";
+  process.stdout.write = ((chunk: string | Uint8Array) => {
+    printed += String(chunk);
+    return true;
+  }) as typeof process.stdout.write;
+  try {
+    const result = fn();
+    return { result, printed };
+  } finally {
+    process.stdout.write = write;
+  }
+}
+
+const ask = (line: string | null, defaultYes: boolean) =>
+  captured(() => askYesNo("Q", defaultYes, answering(line).io)).result;
+
+describe("askYesNo", () => {
+  test("without a terminal the answer is no, and nobody is asked", () => {
+    for (const defaultYes of [false, true]) {
+      const terminal = answering("y", false);
+      const { result, printed } = captured(() => askYesNo("Q", defaultYes, terminal.io));
+      expect(result).toBe(false);
+      expect(terminal.reads()).toBe(0);
+      expect(printed).toBe("");
+    }
+  });
+
+  test("yes is y, yes, s or sim, whatever the case and the space around it", () => {
+    for (const line of ["y", "Y", "yes ", "s", "sim", " YES\n", "Sim\n"]) {
+      expect(ask(line, false)).toBe(true);
+      expect(ask(line, true)).toBe(true);
+    }
+  });
+
+  test("anything else is no", () => {
+    for (const line of ["n", "maybe", "no\n", "yess"]) {
+      expect(ask(line, false)).toBe(false);
+      expect(ask(line, true)).toBe(false);
+    }
+  });
+
+  test("an empty line is the default", () => {
+    for (const line of ["", "\n", "  \n"]) {
+      expect(ask(line, false)).toBe(false);
+      expect(ask(line, true)).toBe(true);
+    }
+  });
+
+  test("the end of input is no, whatever the default", () => {
+    expect(ask(null, false)).toBe(false);
+    expect(ask(null, true)).toBe(false);
+  });
+
+  test("the question shows which answer Enter gives", () => {
+    const no = answering("y");
+    expect(captured(() => askYesNo("Q", false, no.io)).printed).toBe("Q [y/N] ");
+    expect(no.reads()).toBe(1);
+    expect(captured(() => askYesNo("Q", true, answering("n").io)).printed).toBe("Q [Y/n] ");
+  });
+});
+
+describe("confirmWidening", () => {
+  test("--yes answers, and nobody is asked", () => {
+    for (const isTTY of [true, false]) {
+      const terminal = answering("n", isTTY);
+      const { result, printed } = captured(() => confirmWidening("Q", ["--yes"], terminal.io));
+      expect(result).toBe(true);
+      expect(terminal.reads()).toBe(0);
+      expect(printed).toBe("");
+    }
+  });
+
+  test("without --yes and without a terminal it is no, and nobody is asked", () => {
+    const terminal = answering("y", false);
+    expect(captured(() => confirmWidening("Q", [], terminal.io)).result).toBe(false);
+    expect(captured(() => confirmWidening("Q", ["all"], terminal.io)).result).toBe(false);
+    expect(terminal.reads()).toBe(0);
+  });
+
+  test("on a terminal the person is asked, and Enter alone is no", () => {
+    const yes = captured(() => confirmWidening("Q", [], answering("y").io));
+    expect(yes).toEqual({ result: true, printed: "Q [y/N] " });
+    expect(captured(() => confirmWidening("Q", [], answering("\n").io)).result).toBe(false);
+    expect(captured(() => confirmWidening("Q", [], answering(null).io)).result).toBe(false);
+  });
+});
+
+describe("formatShareStatus", () => {
+  const counts = (entries: number, memories: number): Report => ({
+    counts: { entries, memories },
+    perRoot: {
+      workspace: { entries, areaTotals: {} },
+      shared: { entries: 0, areaTotals: {} },
+    },
+    perProject: [
+      { id: 1, level: "knowledge", entries: 0, memories: 0 },
+      { id: 2, level: "all", entries: 0, memories: 0 },
+      { id: 3, level: "local", entries: 0, memories: 0 },
+      { id: 4, level: "local", entries: 0, memories: 0 },
+    ],
+  });
+  const change: ChangeRow = {
+    id: 7,
+    at: Date.UTC(2026, 10, 9, 8, 0, 0),
+    source: "cli",
+    what: "roots",
+    old: "none",
+    new: "shared,workspace",
+  };
+
+  test("says the epoch and the last change, the lists, the projects, this one, and what leaves", () => {
+    const policy = policyWith({
+      epoch: 2097361,
+      roots: new Set(["shared", "workspace"]),
+      areas: new Set(["workspace:sales"]),
+      inert: ["workspace:nope", "shared:gone"],
+      problems: [
+        "areas not in the taxonomy, ignored: workspace:nope, shared:gone",
+        "memory is off for gears; its level is Nothing until you turn memory on and set it again",
+      ],
+    });
+    const project = {
+      name: "widgets",
+      level: "knowledge" as const,
+      boundAlias: "remote:github.com/acme/widgets",
+    };
+    expect(formatShareStatus(policy, counts(12, 1), project, change)).toEqual([
+      "sharing   epoch 2097361 · last change: roots none → shared,workspace, 2026-11-09T08:00:00.000Z, from the cli",
+      "roots     shared,workspace",
+      "areas     workspace:sales (workspace:nope, shared:gone not in the taxonomy; ignored)",
+      "problem   memory is off for gears; its level is Nothing until you turn memory on and set it again",
+      "projects  1 knowledge · 1 knowledge and memories · 2 nothing",
+      "this      widgets: Knowledge (bound to remote:github.com/acme/widgets)",
+      "leaves    12 entries · 1 memory",
+    ]);
+  });
+
+  test("with nothing chosen, nothing changed and no project here", () => {
+    const report: Report = { ...counts(0, 0), perProject: [] };
+    expect(formatShareStatus(policyWith({}), report, null, null)).toEqual([
+      "sharing   epoch 0 · no change yet",
+      "roots     none",
+      "areas     none",
+      "projects  0 knowledge · 0 knowledge and memories · 0 nothing",
+      "this      not a known project",
+      "leaves    0 entries · 0 memories",
+    ]);
+  });
+
+  test("a project that shares nothing is bound to no remote", () => {
+    const project = { name: "widgets", level: "local" as const, boundAlias: "" };
+    const lines = formatShareStatus(policyWith({}), counts(1, 0), project, null);
+    expect(lines).toContain("this      widgets: Nothing");
+    expect(lines).toContain("leaves    1 entry · 0 memories");
+  });
+
+  test("a list names the entries and the memories, and how many more there are", () => {
+    const report: Report = {
+      ...counts(503, 501),
+      items: {
+        entries: [
+          {
+            scope: "workspace",
+            projectId: 0,
+            slug: "sales-one",
+            title: "Sales one",
+            area: "sales",
+          },
+          { scope: "project", projectId: 1, slug: "deploys", title: "How we deploy", area: "code" },
+        ],
+        memories: [{ id: 12, projectId: 1, title: "Deploys need the staging flag" }],
+        more: { entries: 3, memories: 1 },
+      },
+    };
+    const lines = formatShareStatus(policyWith({}), report, null, null);
+    expect(lines.slice(5)).toEqual([
+      "leaves    503 entries · 501 memories",
+      "entry   workspace/sales-one  sales  Sales one",
+      "entry   project/deploys  code  How we deploy",
+      "+3 more",
+      "memory  12  Deploys need the staging flag",
+      "+1 more",
+    ]);
+    const exact: Report = {
+      ...report,
+      items: { entries: [], memories: [], more: { entries: 0, memories: 0 } },
+    };
+    expect(formatShareStatus(policyWith({}), exact, null, null)).toHaveLength(6);
+  });
+});
diff --git a/tests/unit/sharing-contract.test.ts b/tests/unit/sharing-contract.test.ts
new file mode 100644
index 0000000..e68fd7c
--- /dev/null
+++ b/tests/unit/sharing-contract.test.ts
@@ -0,0 +1,236 @@
+// The contract a sync is built against (ADR 0025): what the predicate reads, what leaves
+// with an item, how a memory is hashed, the reasons, redaction at the edge, and the keys
+// and uids. A field added to one of the four shapes fails here until the lists, and the
+// ADR with them, change too.
+import { describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { redactForSend } from "../../src/sharing/edge.ts";
+import { memoryHash } from "../../src/sharing/hash.ts";
+import { levelKey } from "../../src/sharing/levels.ts";
+import {
+  ENTRY_ITEM_KEYS,
+  type EntryItem,
+  entryUid,
+  MEMORY_HASH_FIELDS,
+  MEMORY_ITEM_KEYS,
+  type MemoryItem,
+  memoryUid,
+  OUTGOING_ENTRY_KEYS,
+  OUTGOING_MEMORY_KEYS,
+  type OutgoingEntry,
+  type OutgoingMemory,
+  REASON_TEXT,
+  REASONS,
+} from "../../src/sharing/types.ts";
+
+const keysOf = (sample: object) => Object.keys(sample).sort();
+
+describe("what the predicate reads", () => {
+  test("an entry is these nine fields and nothing else", () => {
+    const sample: EntryItem = {
+      kind: "entry",
+      uid: "workspace:u",
+      scope: "workspace",
+      projectId: 0,
+      area: "sales",
+      status: "active",
+      problem: null,
+      version: 1,
+      hash: "h",
+    };
+    expect(keysOf(sample)).toEqual([...ENTRY_ITEM_KEYS]);
+    expect(ENTRY_ITEM_KEYS).toEqual([
+      "area",
+      "hash",
+      "kind",
+      "problem",
+      "projectId",
+      "scope",
+      "status",
+      "uid",
+      "version",
+    ]);
+  });
+
+  test("a memory is these ten fields and nothing else", () => {
+    const sample: MemoryItem = {
+      kind: "memory",
+      uid: "ab12cd34:7",
+      projectId: 1,
+      status: "active",
+      stale: false,
+      scope: "project",
+      origin: "distilled",
+      isUserRule: false,
+      version: 1,
+      hash: null,
+    };
+    expect(keysOf(sample)).toEqual([...MEMORY_ITEM_KEYS]);
+    expect(MEMORY_ITEM_KEYS).toEqual([
+      "hash",
+      "isUserRule",
+      "kind",
+      "origin",
+      "projectId",
+      "scope",
+      "stale",
+      "status",
+      "uid",
+      "version",
+    ]);
+  });
+});
+
+describe("what leaves with an item", () => {
+  test("an entry leaves as these nine fields and nothing else", () => {
+    const sample: OutgoingEntry = {
+      kind: "entry",
+      uid: "project:remote:github.com/x/y:u",
+      scope: "project",
+      slug: "pricing-rules",
+      remoteAlias: "remote:github.com/x/y",
+      frontmatter: "title: Pricing rules",
+      body: "The rules.",
+      version: 3,
+      hash: "h",
+    };
+    expect(keysOf(sample)).toEqual([...OUTGOING_ENTRY_KEYS]);
+    expect(OUTGOING_ENTRY_KEYS).toEqual([
+      "body",
+      "frontmatter",
+      "hash",
+      "kind",
+      "remoteAlias",
+      "scope",
+      "slug",
+      "uid",
+      "version",
+    ]);
+  });
+
+  test("a memory leaves as these twelve fields and nothing else", () => {
+    const sample: OutgoingMemory = {
+      kind: "memory",
+      uid: "ab12cd34:7",
+      remoteAlias: "remote:github.com/x/y",
+      title: "A title",
+      body: "A body.",
+      memoryKind: "decision",
+      importance: 3,
+      status: "active",
+      createdAt: 1,
+      updatedAt: 2,
+      version: 2,
+      hash: "h",
+    };
+    expect(keysOf(sample)).toEqual([...OUTGOING_MEMORY_KEYS]);
+    expect(OUTGOING_MEMORY_KEYS).toEqual([
+      "body",
+      "createdAt",
+      "hash",
+      "importance",
+      "kind",
+      "memoryKind",
+      "remoteAlias",
+      "status",
+      "title",
+      "uid",
+      "updatedAt",
+      "version",
+    ]);
+  });
+});
+
+describe("a memory's hash", () => {
+  const fields = {
+    memoryKind: "decision",
+    importance: 3,
+    status: "active",
+    title: "A title",
+    body: "A body.",
+  };
+
+  test("covers the kind, the importance, the status, the title and the body, in that order", () => {
+    expect(MEMORY_HASH_FIELDS).toEqual(["memoryKind", "importance", "status", "title", "body"]);
+  });
+
+  test("is the first sixteen hex characters of the SHA-256 of the five values, one per line", () => {
+    const expected = createHash("sha256")
+      .update("decision\n3\nactive\nA title\nA body.")
+      .digest("hex")
+      .slice(0, 16);
+    expect(memoryHash(fields)).toBe(expected);
+    expect(memoryHash(fields)).toMatch(/^[0-9a-f]{16}$/);
+    expect(memoryHash({ ...fields })).toBe(memoryHash(fields));
+  });
+
+  test("changes with each field it covers", () => {
+    expect(memoryHash({ ...fields, importance: 4 })).not.toBe(memoryHash(fields));
+    expect(memoryHash({ ...fields, memoryKind: "pattern" })).not.toBe(memoryHash(fields));
+    expect(memoryHash({ ...fields, status: "archived" })).not.toBe(memoryHash(fields));
+    expect(memoryHash({ ...fields, title: "Another title" })).not.toBe(memoryHash(fields));
+    expect(memoryHash({ ...fields, body: "Another body." })).not.toBe(memoryHash(fields));
+  });
+
+  test("covers nothing else: a use count or a date beside the fields changes nothing", () => {
+    const more = { ...fields, uses: 9, updatedAt: 5 };
+    expect(memoryHash(more)).toBe(memoryHash(fields));
+  });
+});
+
+describe("the reasons", () => {
+  test("every reason has its sentence, and no sentence is without a reason", () => {
+    expect<string[]>([...REASONS].sort()).toEqual(Object.keys(REASON_TEXT).sort());
+    expect(new Set(REASONS).size).toBe(REASONS.length);
+  });
+
+  test("every sentence ends with a full stop", () => {
+    for (const reason of REASONS) {
+      expect(REASON_TEXT[reason].endsWith(".")).toBe(true);
+    }
+  });
+});
+
+describe("redaction at the edge", () => {
+  const sent = (text: string, env: Record<string, string | undefined> = {}): string =>
+    redactForSend(text, env);
+
+  test("a private block leaves as its marker", () => {
+    expect(sent("<private>x</private>")).toBe("[PRIVATE]");
+  });
+
+  test("a key in the text is replaced", () => {
+    const letters = "abcdefghijklmnopqrstuvwxyzabcdefghijklmn";
+    expect(letters).toHaveLength(40);
+    const text = sent(`key sk-ant-api03-${letters}`);
+    expect(text).toContain("[REDACTED:");
+    expect(text).not.toContain(letters);
+  });
+
+  test("a secret of the environment it is given is removed, and of no other", () => {
+    const text = "it is hunter2-hunter2 today";
+    expect(sent(text, { DEPLOY_TOKEN: "hunter2-hunter2" })).toBe(
+      "it is [REDACTED:env-value] today",
+    );
+    expect(sent(text)).toBe(text);
+  });
+});
+
+describe("keys and uids", () => {
+  test("a level is keyed by its project and its destination", () => {
+    expect(levelKey(3, "team")).toBe("3@team");
+  });
+
+  test("an entry's uid is its id scoped by its repository", () => {
+    expect(entryUid("workspace", null, "u")).toBe("workspace:u");
+    expect(entryUid("shared", null, "u")).toBe("shared:u");
+    expect(entryUid("project", "remote:github.com/x/y", "u")).toBe(
+      "project:remote:github.com/x/y:u",
+    );
+    expect(() => entryUid("project", null, "u")).toThrow();
+  });
+
+  test("a memory's uid is its row id scoped by the store's generation", () => {
+    expect(memoryUid("ab12cd34", 7)).toBe("ab12cd34:7");
+  });
+});
diff --git a/tests/unit/sharing-levels.test.ts b/tests/unit/sharing-levels.test.ts
