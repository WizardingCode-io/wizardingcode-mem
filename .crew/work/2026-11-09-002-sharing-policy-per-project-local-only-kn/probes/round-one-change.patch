+    `this      ${project === null ? "not a known project" : `${project.name}: ${LEVEL_LABELS[project.level]}${bound}`}`,
+    `leaves    ${plural(report.counts.entries, "entry", "entries")} · ${plural(report.counts.memories, "memory", "memories")}`,
