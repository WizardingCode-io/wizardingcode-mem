+    LONG,
+  );
+
+  test("a project with memory off cannot share", async () => {
+    withDb((db) => db.run("UPDATE projects SET disabled = 1 WHERE id = ?", [projectId]));
+    const result = await share("project", "knowledge", "--yes");
