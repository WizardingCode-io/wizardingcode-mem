+
+  test("an empty environment variable is unset", () => {
+    const dataDir = dir(`${ROOTS_KEY}=workspace`);
+    for (const value of ["", "  "]) {
+      const env = { [ROOTS_KEY]: value };
+      expect(loadSettings(env, dataDir).sharing).toEqual({
+        roots: ["workspace"],
+        areas: [],
+        problems: [],
