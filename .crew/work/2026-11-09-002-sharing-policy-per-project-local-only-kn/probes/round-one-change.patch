+    db = openDb({ dataDir: storeDir, busyTimeoutMs: 5000 });
+    const now = Date.now();
+    act({ db, dataDir, now, policy: policyInForce(db, dataDir, now) });
+    return 0;
+  } catch (error) {
+    if (error instanceof UsageError) {
+      process.stderr.write(`wizardingcode-mem: ${error.message}\n\n${USAGE}`);
