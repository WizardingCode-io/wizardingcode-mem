+
+  test("an environment that only adds changes nothing, and says how much it added", () => {
+    const dataDir = dir(`${ROOTS_KEY}=workspace`);
+    const env = { [ROOTS_KEY]: "workspace,shared" };
+    expect(loadSettings(env, dataDir).sharing).toEqual({
