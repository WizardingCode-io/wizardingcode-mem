+  const options = new Set<string>();
+  const rest: string[] = [];
+  for (const arg of argv) {
+    if (!arg.startsWith("--")) rest.push(arg);
+    else if (allowed.includes(arg)) options.add(arg);
+    else throw new UsageError(`unknown option ${arg}`);
+  }
+  return { options, rest };
