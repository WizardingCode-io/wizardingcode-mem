+import type { Migration } from "../../store/migration.ts";
+import knowledgeStore from "./migrations/0006_knowledge_store.sql" with { type: "text" };
+import knowledgeAgent from "./migrations/0007_knowledge_agent.sql" with { type: "text" };
+
+export const KNOWLEDGE_MODULE = "knowledge";
+
+/**
+ * Versions 1 to 5 of this module id belong to the module withdrawn before 0.6.0 (ADR 0020):
+ * a store that ran it still holds those rows, for other tables. This module starts at 6.
+ */
+export const KNOWLEDGE_SCHEMA_VERSION = 7;
+
+/** Forward-only, like the core's. */
+export const KNOWLEDGE_MIGRATIONS: readonly Migration[] = [
+  { version: 6, name: "knowledge_store", sql: knowledgeStore },
+  { version: 7, name: "knowledge_agent", sql: knowledgeAgent },
+];
diff --git a/src/modules/knowledge/migrations/0006_knowledge_store.sql b/src/modules/knowledge/migrations/0006_knowledge_store.sql
new file mode 100644
index 0000000..90262d2
--- /dev/null
+++ b/src/modules/knowledge/migrations/0006_knowledge_store.sql
@@ -0,0 +1,92 @@
+-- The knowledge store's index (ADR 0024). The files in the repositories are the truth;
+-- every row here is rebuilt from them.
+
+-- What the withdrawn module (ADR 0020, versions 1 to 5 of this module id) created, on a
+-- store that ran it. Its index of knowledge kept inside project folders is dropped, with
+-- the three triggers and the two indexes on its own tables, which go with their tables.
+DROP TABLE IF EXISTS knowledge_fts;
+DROP TABLE IF EXISTS knowledge_entries;
+DROP TABLE IF EXISTS knowledge_state;
+DROP TABLE IF EXISTS knowledge_shown;
+DROP TABLE IF EXISTS knowledge_proposals;
+DROP TABLE IF EXISTS promoted_memories;
+-- Two indexes that module added to the core table `injections`, for its own promotion
+-- pass. No core query uses them: memory reads `injections` as it did before that module.
+DROP INDEX IF EXISTS injections_memory_shown;
+DROP INDEX IF EXISTS injections_memory_contexts;
+-- Three rows its promotion pass kept in the core table `meta`: a cursor, a list and a
+-- lease. Nothing reads them now, and the new leases are named `knowledge.lease:<path>`.
+DELETE FROM meta
+ WHERE key IN ('knowledge.promote.cursor', 'knowledge.not-standing', 'knowledge.promote.lease');
+
+-- One row per repository. `path` is relative to the data directory. `project_id` is 0 for
+-- the workspace and the shared repositories, and a plain integer for a project: no foreign
+-- key, so a core migration that rebuilds `projects` never cascades here.
+CREATE TABLE knowledge_repos (
+  id INTEGER PRIMARY KEY,
+  scope TEXT NOT NULL CHECK (scope IN ('workspace','project','shared')),
+  project_id INTEGER NOT NULL DEFAULT 0,
+  path TEXT NOT NULL UNIQUE,
+  head TEXT,
+  fingerprint TEXT,
+  -- Files left out of the index by the folder caps.
+  over_cap INTEGER NOT NULL DEFAULT 0,
+  -- 0 when the last rebuild skipped the dirty check for want of git.
+  dirty_checked INTEGER NOT NULL DEFAULT 1,
+  indexed_at INTEGER NOT NULL,
+  UNIQUE (scope, project_id)
+);
+
+CREATE TABLE knowledge_entries (
+  repo_id INTEGER NOT NULL REFERENCES knowledge_repos(id) ON DELETE CASCADE,
+  -- The entry's UUID; 'file:<slug>' or 'dup:<slug>' for a file with no usable id.
+  id TEXT NOT NULL,
+  slug TEXT NOT NULL,
+  path TEXT NOT NULL,
+  title TEXT NOT NULL,
+  kind TEXT NOT NULL,
+  area TEXT NOT NULL,
+  context TEXT NOT NULL DEFAULT '',
+  subject TEXT NOT NULL DEFAULT '',
+  status TEXT NOT NULL,
+  author TEXT NOT NULL,
+  version INTEGER NOT NULL,
+  created TEXT,
+  updated TEXT,
+  supersedes TEXT,
+  body TEXT NOT NULL,
+  problem TEXT,
+  hash TEXT NOT NULL,
+  PRIMARY KEY (repo_id, id),
+  UNIQUE (repo_id, slug)
+);
+
+-- A decided proposal is indexed without its body: the file keeps it.
+CREATE TABLE knowledge_proposals (
+  repo_id INTEGER NOT NULL REFERENCES knowledge_repos(id) ON DELETE CASCADE,
+  id TEXT NOT NULL,
+  path TEXT NOT NULL,
+  state TEXT NOT NULL CHECK (state IN ('open','accepted','rejected')),
+  entry_id TEXT NOT NULL,
+  slug TEXT NOT NULL,
+  base_version INTEGER NOT NULL,
+  base_hash TEXT NOT NULL DEFAULT '',
+  proposed_by TEXT NOT NULL,
+  proposed_at TEXT,
+  decided_by TEXT,
+  decided_at TEXT,
+  decided_version INTEGER,
+  title TEXT NOT NULL,
+  kind TEXT NOT NULL,
+  area TEXT NOT NULL,
+  context TEXT NOT NULL DEFAULT '',
+  subject TEXT NOT NULL DEFAULT '',
+  status TEXT NOT NULL,
+  body TEXT NOT NULL DEFAULT '',
+  problem TEXT,
+  hash TEXT NOT NULL,
+  PRIMARY KEY (repo_id, id)
+);
+-- The quota of open proposals per target: by entry for a change, by slug for a new entry.
+CREATE INDEX knowledge_proposals_entry ON knowledge_proposals(repo_id, state, entry_id);
+CREATE INDEX knowledge_proposals_slug ON knowledge_proposals(repo_id, state, slug);
diff --git a/src/modules/knowledge/migrations/0007_knowledge_agent.sql b/src/modules/knowledge/migrations/0007_knowledge_agent.sql
new file mode 100644
index 0000000..9294d23
--- /dev/null
+++ b/src/modules/knowledge/migrations/0007_knowledge_agent.sql
@@ -0,0 +1,46 @@
+-- What the agent is shown and what it proposes (ADR 0024, part 2). Migrations 6 and 7
+-- ship together and apply on an empty index: nothing here is filled from existing rows.
+
+-- An entry shown at every session start: set by a person only.
+ALTER TABLE knowledge_entries ADD COLUMN pinned INTEGER NOT NULL DEFAULT 0;
+-- The rowid of the entry's search row; null for an entry that is not searchable. A write
+-- and a rebuild delete search rows by it, so neither scans the search table.
+ALTER TABLE knowledge_entries ADD COLUMN fts_rowid INTEGER;
+
+-- What the judge found, and for whom the agent proposed: the entries contradicted, as a
+-- JSON list of ids.
+ALTER TABLE knowledge_proposals ADD COLUMN contradicts TEXT NOT NULL DEFAULT '[]';
+ALTER TABLE knowledge_proposals ADD COLUMN on_behalf_of TEXT;
+ALTER TABLE knowledge_proposals ADD COLUMN judged_by TEXT;
+ALTER TABLE knowledge_proposals ADD COLUMN judge_version TEXT;
+
+-- One row per active, problem-free entry, kept by the index writer. It holds its own copy
+-- of the text because (repo_id, id) has no stable rowid. The two ids are stored for the
+-- join and never matched: a query term cannot reach them.
+CREATE VIRTUAL TABLE knowledge_fts USING fts5(
+  title,
+  area,
+  context,
+  subject,
+  body,
+  repo_id UNINDEXED,
+  entry_id UNINDEXED,
+  tokenize = 'unicode61 remove_diacritics 2'
+);
+
+-- One row per entry shown in a context: the key is what showing an entry once per context
+-- needs; the event, the rule and the time are the record of how often each rule fires.
+CREATE TABLE knowledge_shown (
+  session_id INTEGER NOT NULL,
+  context_epoch INTEGER NOT NULL,
+  repo_id INTEGER NOT NULL,
+  entry_id TEXT NOT NULL,
+  -- 'session-start' or 'prompt'.
+  event TEXT NOT NULL,
+  -- 'code', 'title' or 'words' on a prompt; null at session start.
+  rule TEXT,
+  at INTEGER NOT NULL,
+  PRIMARY KEY (session_id, context_epoch, repo_id, entry_id)
+);
+CREATE INDEX knowledge_shown_entry ON knowledge_shown(repo_id, entry_id);
+CREATE INDEX knowledge_shown_at ON knowledge_shown(at);
