+
+  test("a manifest that is a link is not followed", () => {
+    const repo = ensureRepo(store, WORKSPACE);
+    const outside = join(fx.dir, "outside.json");
+    writeFileSync(outside, '{"format": 1, "scope": "workspace", "createdAt": "x"}');
