+++ b/src/modules/knowledge/store.ts
@@ -0,0 +1,957 @@
+// Writing knowledge. Every write is one commit by its author; a write on a stale version
+// is refused, never applied over the other; an agent's write is a proposal file until a
+// person accepts it. The store cannot tell a person from an agent: the entry point that
+// calls it says which, and passes the writer.
+import { randomUUID } from "node:crypto";
+import { lstatSync } from "node:fs";
+import { join } from "node:path";
+import { redact } from "../../core/redact.ts";
+import { withWrite } from "../../store/db.ts";
+import { authorOf, identityOf } from "./author.ts";
+import {
+  AREA_ID,
+  AREA_MAX,
+  checkSlug,
+  ENTRY_MAX_BYTES,
+  FIELD_MAX,
+  KINDS,
+  nowIso,
+  parseEntry,
+  parseFrontmatter,
+  parseProposal,
+  parseTaxonomy,
+  renderEntry,
+  renderProposal,
+  SLUG,
+  STATUSES,
+  slugify,
+  TITLE_MAX,
+  UUID,
+} from "./entry.ts";
+import { KnowledgeError } from "./errors.ts";
+import {
+  countOpen,
+  countOpenAll,
+  ensureFresh,
+  rebuildRepo,
+  recordedFingerprint,
+  recordRepoAfter,
+  taxonomyOrNull,
+  upsertEntry,
+  upsertProposal,
+} from "./index-store.ts";
+import {
+  type Change,
+  clearIntent,
+  commitChange,
+  commitPaths,
+  DECIDED_DIR,
+  dropKept,
+  ENTRIES_DIR,
+  ensureRepo,
+  existsOnDisk,
+  fingerprintOf,
+  hashOf,
+  headOf,
+  keepBytes,
+  keptFileName,
+  MANIFEST_FILE,
+  OPEN_DIR,
+  openRepo,
+  parseManifest,
+  pathsAtHead,
+  readRegularFile,
+  removePaths,
+  repoFolder,
+  requireGit,
+  restoreKept,
+  rootOf,
+  runGit,
+  showAtHead,
+  stagePaths,
+  statusOf,
+  TAXONOMY_FILE,
+  taxonomyFor,
+  unstage,
+  withRepoLeases,
+  writeFileAtomic,
+  writeIntent,
+} from "./repo.ts";
+import { requireSchema } from "./schema.ts";
+import type {
+  AgentWriter,
+  EntryChange,
+  KnowledgeEntry,
+  KnowledgeProposal,
+  KnowledgeStore,
+  PersonWriter,
+  Repo,
+  ScopeRef,
+  Taxonomy,
+  Writer,
+} from "./types.ts";
+
+/** How many proposals may wait for a person: for one target, and in one repository. */
+const OPEN_PER_TARGET = 5;
+const OPEN_PER_REPO = 200;
+
+const ADOPT = "wizardingcode-mem knowledge adopt";
+
+const invalid = (message: string) => new KnowledgeError("invalid", message);
+
+// --- The shape of what is written -------------------------------------------------------
+
+interface Fields {
+  title: string;
+  kind: string;
+  area: string;
+  context: string;
+  subject: string;
+  status: string;
+}
+
+const oneLine = (text: string) => !/[\r\n]/.test(text);
+
+/** The fields' patterns and lengths; a bad one is refused with the field named. */
+function checkFields(fields: Fields): Fields {
+  const title = fields.title.trim();
+  if (title === "" || title.length > TITLE_MAX || !oneLine(title)) {
+    throw invalid(`title: 1 to ${TITLE_MAX} characters, on one line`);
+  }
+  if (!KINDS.test(fields.kind)) {
+    throw invalid("kind: one of knowledge, strategy, persona, pattern");
+  }
+  if (!AREA_ID.test(fields.area) || fields.area.length > AREA_MAX) {
+    throw invalid("area: the id of an area of the taxonomy");
+  }
+  for (const key of ["context", "subject"] as const) {
+    if (fields[key].length > FIELD_MAX || !oneLine(fields[key])) {
+      throw invalid(`${key}: at most ${FIELD_MAX} characters, on one line`);
+    }
+  }
+  if (!STATUSES.test(fields.status)) throw invalid("status: one of active, draft, archived");
+  // Named one by one: a caller's object may carry more than these six.
+  return {
+    title,
+    kind: fields.kind,
+    area: fields.area,
+    context: fields.context,
+    subject: fields.subject,
+    status: fields.status,
+  };
+}
+
+export function checkArea(area: string, taxonomy: Taxonomy): void {
+  if (taxonomy.areas.some((known) => known.id === area)) return;
+  throw invalid(
+    `area: ${area} is not in the taxonomy (${taxonomy.areas.map((known) => known.id).join(", ")})`,
+  );
+}
+
+function checkBase(base: number | undefined): number {
+  if (base === undefined) return 0;
+  if (!Number.isSafeInteger(base) || base < 0) throw invalid("base version: a whole number from 0");
+  return base;
+}
+
+function checkSize(text: string): string {
+  if (Buffer.byteLength(text) > ENTRY_MAX_BYTES) {
+    throw invalid("the text is over 256 KiB, the cap for one file");
+  }
+  return text;
+}
+
+/** The body as it is stored: LF line endings, whatever the caller's were. */
+const bodyOf = (body: string) => body.replaceAll("\r\n", "\n");
+
+const entryPath = (slug: string) => `${ENTRIES_DIR}/${slug}.md`;
+const openPath = (id: string) => `${OPEN_DIR}/${id}.md`;
+const decidedPath = (id: string) => `${DECIDED_DIR}/${id}.md`;
+const absolute = (repo: Repo, path: string) => join(repo.path, ...path.split("/"));
+
+// --- The leases and the repository -----------------------------------------------------
+
+/**
+ * Runs `fn` on the repository holding its root's lease and then its own, both refreshed
+ * against their files. The area check and the commit happen under the same leases, so a
+ * taxonomy change cannot slip between them.
+ */
+function underLeases<T>(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  create: boolean,
+  fn: (repo: Repo, taxonomy: Taxonomy) => T,
+): T {
+  const rootRef = rootOf(ref);
+  const rootFolder = repoFolder(rootRef);
+  return withRepoLeases(store, [rootFolder], () => {
+    const repo = create ? ensureRepo(store, ref) : openRepo(store, ref);
+    if (repo === null) {
+      throw new KnowledgeError("missing", `there is no ${ref.scope} knowledge repository yet`);
+    }
+    const run = () => {
+      if (repo.relative !== rootFolder) {
+        const root = openRepo(store, rootRef);
+        if (root !== null) ensureFresh(store, root);
+      }
+      ensureFresh(store, repo);
+      const taxonomy = taxonomyFor(store, ref);
+      if (taxonomy === null) {
+        throw new KnowledgeError("missing", `the ${rootRef.scope} repository has no taxonomy`);
+      }
+      return fn(repo, taxonomy);
+    };
+    return repo.relative === rootFolder ? run() : withRepoLeases(store, [repo.relative], run);
+  });
+}
+
+/**
+ * The target of a write must be a regular file or nothing, indexed without a problem that
+ * makes it unusable, and as the last commit left it (D-11: a hand edit is never swept
+ * into another author's commit).
+ */
+function checkTarget(store: KnowledgeStore, repo: Repo, slug: string): void {
+  const path = entryPath(slug);
+  let stat: ReturnType<typeof lstatSync> | null = null;
+  try {
+    stat = lstatSync(absolute(repo, path));
+  } catch {
+    // Nothing there: a new entry.
+  }
+  if (stat !== null && !stat.isFile()) {
+    throw invalid(
+      stat.isSymbolicLink()
+        ? `${path} is a symbolic link; the knowledge store never follows links`
+        : `${path} is not a regular file`,
+    );
+  }
+  const indexed = store.db
+    .query<{ id: string; problem: string | null }, [number, string]>(
+      "SELECT id, problem FROM knowledge_entries WHERE repo_id = ? AND slug = ?",
+    )
+    .get(repo.id, slug);
+  if (indexed?.problem != null && /^(?:file|dup):/.test(indexed.id)) {
+    throw invalid(
+      `${path} cannot be changed: ${indexed.problem}; fix the file by hand, then run ${ADOPT}`,
+    );
+  }
+  requireClean(store, repo, path);
+}
+
+/** Refuses a path that is not as the last commit left it: a hand edit is adopted first. */
+export function requireClean(store: KnowledgeStore, repo: Repo, path: string): void {
+  if (statusOf(store, repo, [path]).length === 0) return;
+  throw new KnowledgeError("dirty", `${path} was changed outside the engine; run ${ADOPT} first`);
+}
+
+interface Current {
+  entry: KnowledgeEntry;
+  hash: string;
+}
+
+function readCurrent(repo: Repo, slug: string, taxonomy: Taxonomy | null): Current | null {
+  const bytes = readRegularFile(absolute(repo, entryPath(slug)));
+  if (bytes === null) return null;
+  return {
+    entry: parseEntry(new TextDecoder().decode(bytes), slug, taxonomy),
+    hash: hashOf(bytes),
+  };
+}
+
+const stale = (current: number, based: number, what: string) =>
+  new KnowledgeError(
+    "stale",
+    `stale: the entry is at version ${current}, the ${what} was based on version ${based}`,
+  );
+
+// --- The commit and the failure rule -----------------------------------------------------
+
+/** What `commit` hands to `settle`: whether the index can trust the folders it finds after. */
+export interface Committed {
+  /**
+   * The folders were as the index knew them when the operation began to write. When they
+   * were not, a file was added or removed by hand since the last refresh: the index is
+   * then told to read the repository again, instead of recording folders it has not read.
+   */
+  undisturbed: boolean;
+}
+
+/**
+ * Commits a change (`commitChange`), and says whether the folders were as the index knew
+ * them when it began. The intent record stays until the caller has indexed the result.
+ */
+export function commit(store: KnowledgeStore, repo: Repo, change: Change): Committed {
+  const recorded = recordedFingerprint(store, repo);
+  const undisturbed = recorded !== null && recorded === fingerprintOf(repo.path);
+  commitChange(store, repo, change);
+  return { undisturbed };
+}
+
+/**
+ * Indexes what a commit changed, records the repository's new head, and forgets the
+ * intent. The head and the fingerprint are taken before the transaction, and the
+ * fingerprint is recorded only when nothing but this operation changed the folders.
+ */
+export function settle(
+  store: KnowledgeStore,
+  repo: Repo,
+  committed: Committed,
+  index: () => void,
+): void {
+  const head = headOf(repo.path);
+  const fingerprint = committed.undisturbed ? fingerprintOf(repo.path) : null;
+  store.renew?.();
+  withWrite(store.db, () => {
+    index();
+    recordRepoAfter(store, repo, head, fingerprint);
+  });
+  clearIntent(repo);
+}
+
+// --- A person's write ------------------------------------------------------------------
+
+/** The text of an entry's next version; refused when the base is not the current version. */
+function nextEntry(
+  current: Current | null,
+  base: number,
+  next: {
+    slug: string;
+    id: string;
+    fields: Fields;
+    body: string;
+    author: string;
+    now: string;
+    supersedes: string | null;
+    /** Undefined keeps the current entry's value; a new entry is not pinned. */
+    pinned: boolean | undefined;
+    what: string;
+  },
+): KnowledgeEntry {
+  if (base > 0) {
+    if (current === null) {
+      throw new KnowledgeError("missing", `there is no entry ${next.slug} to change`);
+    }
+    if (current.entry.version !== base) throw stale(current.entry.version, base, next.what);
+  }
+  return {
+    id: current === null ? next.id : current.entry.id,
+    slug: next.slug,
+    ...next.fields,
+    author: next.author,
+    version: base + 1,
+    created: current?.entry.created ?? next.now,
+    updated: next.now,
+    supersedes: next.supersedes ?? current?.entry.supersedes ?? null,
+    pinned: next.pinned ?? current?.entry.pinned ?? false,
+    body: next.body,
+    // Keys this version does not know are kept as they were written.
+    extra: current?.entry.extra ?? [],
+    problem: null,
+  };
+}
+
+/**
+ * Writes an entry. A person's write is a commit; an agent's is a proposal. `baseVersion`
+ * absent or 0 means a new entry. The id is the store's: a caller never sets one.
+ */
+export function writeEntry(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  change: EntryChange,
+  writer: Writer,
+): { kind: "written"; entry: KnowledgeEntry } | { kind: "proposed"; proposal: KnowledgeProposal } {
+  requireSchema(store);
+  requireGit(store);
+  if (change.supersedes !== undefined && !UUID.test(change.supersedes)) {
+    throw invalid("supersedes: the id of the entry this one replaces");
+  }
+  if (writer.kind === "agent") {
+    return { kind: "proposed", proposal: propose(store, ref, change, writer) };
+  }
+
+  const status = change.status;
+  const fields = checkFields({ ...change, status: status ?? "active" });
+  const slug = change.slug === undefined ? slugify(fields.title) : checkSlug(change.slug);
+  const base = checkBase(change.baseVersion);
+  const body = bodyOf(change.body);
+  return underLeases(store, ref, true, (repo, taxonomy) => {
+    checkArea(fields.area, taxonomy);
+    checkTarget(store, repo, slug);
+    const current = readCurrent(repo, slug, taxonomy);
+    if (base === 0 && current !== null) {
+      throw new KnowledgeError(
+        "exists",
+        `${entryPath(slug)} exists at version ${current.entry.version}; write with base version ${current.entry.version} to change it`,
+      );
+    }
+    const entry = nextEntry(current, base, {
+      slug,
+      id: randomUUID(),
+      // An unsaid status keeps the entry's own.
+      fields: { ...fields, status: status ?? current?.entry.status ?? "active" },
+      body,
+      author: authorOf(writer),
+      now: nowIso(store.now()),
+      supersedes: change.supersedes ?? null,
+      pinned: change.pinned,
+      what: "write",
+    });
+    const path = entryPath(slug);
+    const text = checkSize(renderEntry(entry));
+    const committed = commit(store, repo, {
+      operation: "write",
+      writer,
+      write: [{ path, text }],
+      remove: [],
+      existed: current === null ? [] : [path],
+      created: current === null ? [path] : [],
+      message: `knowledge: ${current === null ? "create" : "update"} ${slug} (v${entry.version})`,
+    });
+    settle(store, repo, committed, () =>
+      upsertEntry(store, repo.id, entry, path, hashOf(Buffer.from(text))),
+    );
+    return { kind: "written" as const, entry };
+  });
+}
+
+// --- An agent's write: a proposal ------------------------------------------------------
+
+/**
+ * The slug a proposal takes: the caller's, checked, or the one made from the redacted
+ * title. A caller's slug that redaction would change is refused: it would name a file
+ * after a secret.
+ */
+export function proposalSlug(store: KnowledgeStore, change: EntryChange): string {
+  if (change.slug !== undefined) {
+    checkSlug(change.slug);
+    if (redact(change.slug, { env: store.env }) !== change.slug) {
+      throw invalid("slug: it reads as a secret and would be redacted; choose another");
+    }
+    return change.slug;
+  }
+  return slugify(redact(change.title, { env: store.env }).trim());
+}
+
+/**
+ * The version a proposal is based on; 0 for a new entry. A caller's slug that names an
+ * entry is a change to it, at the current version unless the caller gave one; a slug made
+ * from the title is a new entry. Refused when the target does not match: an entry that
+ * exists for a new one, none for a change, another version than the base.
+ */
+export function proposalBase(
+  slug: string,
+  change: EntryChange,
+  current: { version: number } | null,
+): number {
+  const base =
+    change.baseVersion === undefined
+      ? change.slug !== undefined && current !== null
+        ? current.version
+        : 0
+      : checkBase(change.baseVersion);
+  if (base === 0 && current !== null) {
+    throw new KnowledgeError(
+      "exists",
+      `${entryPath(slug)} exists at version ${current.version}; propose a change with its slug and base version ${current.version}`,
+    );
+  }
+  if (base > 0 && current === null) {
+    throw new KnowledgeError("missing", `there is no entry ${slug} to change`);
+  }
+  if (current !== null && current.version !== base) {
+    throw stale(current.version, base, "proposal");
+  }
+  return base;
+}
+
+function propose(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  change: EntryChange,
+  writer: AgentWriter,
+): KnowledgeProposal {
+  // A proposal enters a history the engine never rewrites, and a session's text may carry
+  // a secret. The limits apply to what is stored: the text after redaction.
+  const clean = (text: string): string => redact(text, { env: store.env });
+  const slug = proposalSlug(store, change);
+  const status = change.status;
+  const fields = checkFields({
+    title: clean(change.title),
+    kind: change.kind,
+    area: change.area,
+    context: clean(change.context),
+    subject: clean(change.subject),
+    status: status ?? "active",
+  });
+  const body = bodyOf(clean(change.body));
+  const extras = change.proposal;
+
+  return underLeases(store, ref, true, (repo, taxonomy) => {
+    checkArea(fields.area, taxonomy);
+    checkTarget(store, repo, slug);
+    const current = readCurrent(repo, slug, taxonomy);
+    const base = proposalBase(slug, change, current === null ? null : current.entry);
+
+    const waiting = countOpen(
+      store,
+      repo.id,
+      current === null ? { slug } : { entryId: current.entry.id },
+    );
+    if (waiting >= OPEN_PER_TARGET) {
+      throw new KnowledgeError(
+        "quota",
+        `there are already ${OPEN_PER_TARGET} open proposals for ${slug}; a person decides them first`,
+      );
+    }
+    if (countOpenAll(store, repo.id) >= OPEN_PER_REPO) {
+      throw new KnowledgeError(
+        "quota",
+        `the repository has ${OPEN_PER_REPO} open proposals waiting for a person`,
+      );
+    }
+
+    const proposal: KnowledgeProposal = {
+      id: randomUUID(),
+      entryId: current?.entry.id ?? randomUUID(),
+      slug,
+      baseVersion: base,
+      baseHash: current?.hash ?? "",
+      proposedBy: authorOf(writer),
+      proposedAt: nowIso(store.now()),
+      ...fields,
+      status: status ?? current?.entry.status ?? "active",
+      body,
+      decision: null,
+      decidedBy: null,
+      decidedAt: null,
+      decidedVersion: null,
+      contradicts: extras?.contradicts ?? [],
+      onBehalfOf: extras?.onBehalfOf ?? null,
+      judgedBy: extras?.judgedBy ?? null,
+      judgeVersion: extras?.judgeVersion ?? null,
+      extra: [],
+      problem: null,
+    };
+    const path = openPath(proposal.id);
+    const text = checkSize(renderProposal(proposal));
+    const committed = commit(store, repo, {
+      operation: "write",
+      writer,
+      write: [{ path, text }],
+      remove: [],
+      existed: [],
+      created: [path],
+      message: `knowledge: propose ${proposal.id} for ${slug}`,
+      proposalId: proposal.id,
+    });
+    settle(store, repo, committed, () =>
+      upsertProposal(store, repo.id, proposal, path, hashOf(Buffer.from(text))),
+    );
+    return proposal;
+  });
+}
+
+// --- A person decides a proposal -------------------------------------------------------
+
+function checkDecider(person: PersonWriter, proposalId: string): void {
+  if (person.kind !== "person")
+    throw invalid("a proposal is decided by a person, never by an agent");
+  // Before any path is built: an id is a file name here.
+  if (!UUID.test(proposalId)) throw invalid("proposal id: the id of an open proposal");
+}
+
+/** The open proposal as its file holds it: open in the index, a regular file, and clean. */
+function openProposal(
+  store: KnowledgeStore,
+  repo: Repo,
+  proposalId: string,
+  taxonomy: Taxonomy | null,
+): KnowledgeProposal {
+  const row = store.db
+    .query<{ state: string }, [number, string]>(
+      "SELECT state FROM knowledge_proposals WHERE repo_id = ? AND id = ?",
+    )
+    .get(repo.id, proposalId);
+  const path = openPath(proposalId);
+  const bytes = row?.state === "open" ? readRegularFile(absolute(repo, path)) : null;
+  if (bytes === null) {
+    throw new KnowledgeError("missing", `there is no open proposal ${proposalId}`);
+  }
+  requireClean(store, repo, path);
+  const proposal = parseProposal(new TextDecoder().decode(bytes), `${proposalId}.md`, taxonomy);
+  // A proposal edited by hand can carry any text where an id should be.
+  if (!UUID.test(proposal.entryId)) {
+    throw invalid(`the proposal's entry id is not an id; fix ${path} by hand, then run ${ADOPT}`);
+  }
+  const owner = store.db
+    .query<{ slug: string }, [number, string, string]>(
+      "SELECT slug FROM knowledge_entries WHERE repo_id = ? AND id = ? AND slug <> ?",
+    )
+    .get(repo.id, proposal.entryId, proposal.slug);
+  if (owner !== null) {
+    throw invalid(`the proposal's entry id already belongs to the entry ${owner.slug}`);
+  }
+  return proposal;
+}
+
+/**
+ * Accepts an agent's proposal: the entry is written with the proposal's content and the
+ * proposal moves to `proposals/decided/`, in one commit by the person that names the agent.
+ */
+export function acceptProposal(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  proposalId: string,
+  person: PersonWriter,
+): KnowledgeEntry {
+  requireSchema(store);
+  requireGit(store);
+  checkDecider(person, proposalId);
+  return underLeases(store, ref, false, (repo, taxonomy) => {
+    const proposal = openProposal(store, repo, proposalId, taxonomy);
+    if (proposal.problem !== null) {
+      throw invalid(`the proposal cannot be accepted: ${proposal.problem}`);
+    }
+    const slug = checkSlug(proposal.slug);
+    const fields = checkFields(proposal);
+    checkArea(fields.area, taxonomy);
+    checkTarget(store, repo, slug);
+    const current = readCurrent(repo, slug, taxonomy);
+    if (proposal.baseVersion === 0 && current !== null) {
+      throw new KnowledgeError(
+        "exists",
+        `a proposal for a new entry ${slug}, but the entry now exists at version ${current.entry.version}; a person decides between them`,
+      );
+    }
+    const now = nowIso(store.now());
+    const entry = nextEntry(current, proposal.baseVersion, {
+      slug,
+      id: proposal.entryId,
+      fields,
+      body: proposal.body,
+      author: authorOf(person),
+      now,
+      supersedes: null,
+      // A proposal carries no pin: the entry keeps the one a person gave it.
+      pinned: undefined,
+      what: "proposal",
+    });
+    const decided: KnowledgeProposal = {
+      ...proposal,
+      decision: "accepted",
+      decidedBy: authorOf(person),
+      decidedAt: now,
+      decidedVersion: entry.version,
+    };
+    const paths = {
+      entry: entryPath(slug),
+      open: openPath(proposalId),
+      decided: decidedPath(proposalId),
+    };
+    const entryText = checkSize(renderEntry(entry));
+    const decidedText = renderProposal(decided);
+    const committed = commit(store, repo, {
+      operation: "accept",
+      writer: person,
+      write: [
+        { path: paths.entry, text: entryText },
+        { path: paths.decided, text: decidedText },
+      ],
+      remove: [paths.open],
+      existed: current === null ? [paths.open] : [paths.open, paths.entry],
+      created: current === null ? [paths.decided, paths.entry] : [paths.decided],
+      message: `knowledge: accept ${proposalId} into ${slug} (v${entry.version})\n\nProposed by ${proposal.proposedBy}.`,
+      proposalId,
+    });
+    settle(store, repo, committed, () => {
+      upsertEntry(store, repo.id, entry, paths.entry, hashOf(Buffer.from(entryText)));
+      upsertProposal(store, repo.id, decided, paths.decided, hashOf(Buffer.from(decidedText)));
+    });
+    return entry;
+  });
+}
+
+/** Rejects a proposal: the file moves to `proposals/decided/` with the decision. Nothing is deleted. */
+export function rejectProposal(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  proposalId: string,
+  person: PersonWriter,
+): KnowledgeProposal {
+  requireSchema(store);
+  requireGit(store);
+  checkDecider(person, proposalId);
+  return underLeases(store, ref, false, (repo) => {
+    // No taxonomy: a proposal that names an unknown area can still be rejected.
+    const proposal = openProposal(store, repo, proposalId, null);
+    if (proposal.id !== proposalId) {
+      throw invalid(
+        `the proposal's file cannot be read as a proposal; fix ${openPath(proposalId)} by hand, then run ${ADOPT}`,
+      );
+    }
+    const decided: KnowledgeProposal = {
+      ...proposal,
+      decision: "rejected",
+      decidedBy: authorOf(person),
+      decidedAt: nowIso(store.now()),
+      decidedVersion: null,
+      problem: null,
+    };
+    const paths = { open: openPath(proposalId), decided: decidedPath(proposalId) };
+    const text = renderProposal(decided);
+    const committed = commit(store, repo, {
+      operation: "reject",
+      writer: person,
+      write: [{ path: paths.decided, text }],
+      remove: [paths.open],
+      existed: [paths.open],
+      created: [paths.decided],
+      message: `knowledge: reject ${proposalId}`,
+      proposalId,
+    });
+    settle(store, repo, committed, () =>
+      upsertProposal(store, repo.id, decided, paths.decided, hashOf(Buffer.from(text))),
+    );
+    return decided;
+  });
+}
+
+// --- Reading -----------------------------------------------------------------------------
+
+/** The entry as its file holds it now; null when there is no such entry or no repository. */
+export function readEntry(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  slug: string,
+): KnowledgeEntry | null {
+  requireSchema(store);
+  checkSlug(slug);
+  const repo = openRepo(store, ref);
+  if (repo === null) return null;
+  ensureFresh(store, repo);
+  return readCurrent(repo, slug, taxonomyOrNull(store, repo))?.entry ?? null;
+}
+
+// --- Hand edits: adopt -------------------------------------------------------------------
+
+const ENTRY_FILE = new RegExp(`^${ENTRIES_DIR}/([^/]+)\\.md$`);
+/** The characters a terminal or a log acts on: line breaks, tabs, escapes. */
+// biome-ignore lint/suspicious/noControlCharactersInRegex: control characters are what is matched.
+const CONTROL = /[\x00-\x1f\x7f]/g;
+
+/**
+ * The text an entry file a person wrote by hand is committed as: an id when it has none,
+ * the next version, `updated` and the person as author, everything else as they left it.
+ * Null when the file is not an entry even so: it is then committed exactly as it is.
+ */
+function adoptedText(
+  text: string,
+  slug: string,
+  taxonomy: Taxonomy | null,
+  headVersion: number | null,
+  person: PersonWriter,
+  now: string,
+): string | null {
+  const front = parseFrontmatter(text);
+  if ("problem" in front) return null;
+  const asWritten = parseEntry(text, slug, null);
+  const id = UUID.test(asWritten.id) ? asWritten.id : randomUUID();
+  // A file HEAD does not hold starts at 1. One it holds moves forward from the higher of
+  // HEAD's version and the number in the file, whatever the person typed there.
+  const version = headVersion === null ? 1 : Math.max(headVersion, asWritten.version) + 1;
+  const others = front.order
+    .filter((key) => key !== "id" && key !== "version")
+    .flatMap((key) => front.raw.get(key) ?? []);
+  const repaired = parseEntry(
+    `---\nid: ${id}\nversion: ${version}\n${others.join("\n")}\n---\n${front.body}\n`,
+    slug,
+    taxonomy,
+  );
+  if (repaired.problem !== null) return null;
+  return renderEntry({
+    ...repaired,
+    author: authorOf(person),
+    created: repaired.created ?? now,
+    updated: now,
+  });
+}
+
+/**
+ * Commits the changes a person made outside the engine, as the person: files edited or
+ * added in an editor, files deleted, a taxonomy or a manifest changed by hand. Nothing is
+ * skipped or refused, since the person's work must be versioned; a file that is still not
+ * a valid entry is committed as it is and returned with its problem. When the commit
+ * fails, the person's files are put back byte for byte: their work exists nowhere else.
+ */
+export function adopt(
+  store: KnowledgeStore,
+  ref: ScopeRef,
+  person: PersonWriter,
+): { adopted: number; problems: string[] } {
+  requireSchema(store);
+  requireGit(store);
+  if (person.kind !== "person") throw invalid("changes are adopted by a person, never by an agent");
+  const rootFolder = repoFolder(rootOf(ref));
+  return withRepoLeases(store, [rootFolder], () => {
+    const repo = openRepo(store, ref);
+    if (repo === null) {
+      throw new KnowledgeError("missing", `there is no ${ref.scope} knowledge repository yet`);
+    }
+    const run = () => adoptIn(store, repo, person);
+    return repo.relative === rootFolder ? run() : withRepoLeases(store, [repo.relative], run);
+  });
+}
+
+function adoptIn(
+  store: KnowledgeStore,
+  repo: Repo,
+  person: PersonWriter,
+): { adopted: number; problems: string[] } {
+  // Nothing else counts: the `.gitignore` covers what editors and Finder leave behind.
+  const changed = statusOf(store, repo, [
+    ENTRIES_DIR,
+    "proposals",
+    TAXONOMY_FILE,
+    MANIFEST_FILE,
+  ]).map((line) => line.slice(3));
+  if (changed.length === 0) return { adopted: 0, problems: [] };
+  // git names a folder, not its files, only where the folder is a repository of its own.
+  const nested = changed.find((path) => path.endsWith("/"));
+  if (nested !== undefined) {
+    throw invalid(
+      `${nested} is a git repository of its own, and the knowledge store keeps none inside its folders; move it out of ${repo.relative}, then run ${ADOPT} again`,
+    );
+  }
+
+  const atHead = pathsAtHead(store, repo, changed, "adopt");
+  const present = changed.filter((path) => existsOnDisk(absolute(repo, path)));
+  const deleted = changed.filter((path) => !present.includes(path) && atHead.has(path));
+  // A file added to the index by hand and then deleted: there is nothing left to commit.
+  const vanished = changed.filter((path) => !present.includes(path) && !atHead.has(path));
+  const paths = [...present, ...deleted];
+
+  const taxonomy = taxonomyOrNull(store, repo);
+  const now = nowIso(store.now());
+  const kept = new Map<string, Uint8Array>();
+  const rewrites: { path: string; text: string }[] = [];
+  for (const path of present) {
+    const slug = ENTRY_FILE.exec(path)?.[1];
+    if (slug === undefined || !SLUG.test(slug)) continue;
+    let bytes: Uint8Array | null;
+    try {
+      bytes = readRegularFile(absolute(repo, path));
+    } catch {
+      // A link or a file over the cap is committed as it is and listed with its problem.
+      continue;
+    }
+    if (bytes === null) continue;
+    kept.set(path, bytes);
+    const head = atHead.has(path) ? showAtHead(store, repo, path) : null;
+    const headVersion = head === null ? null : parseEntry(head, slug, null).version;
+    const text = adoptedText(
+      new TextDecoder().decode(bytes),
+      slug,
+      taxonomy,
+      headVersion,
+      person,
+      now,
+    );
+    if (text !== null) rewrites.push({ path, text });
+  }
+
+  const keptName = keptFileName();
+  // What adopt leaves at each path: nothing where the file is gone, an entry's rewrite,
+  // and otherwise the person's bytes untouched. A file that cannot be read as a regular
+  // file has no line here, and an interrupted adopt leaves it as it finds it.
+  const written: Record<string, string | null> = {};
+  for (const path of [...deleted, ...vanished]) written[path] = null;
+  for (const path of present) {
+    try {
+      const bytes = kept.get(path) ?? readRegularFile(absolute(repo, path));
+      if (bytes !== null) written[path] = hashOf(bytes);
+    } catch (error) {
+      if (!(error instanceof KnowledgeError)) throw error;
+    }
+  }
+  for (const { path, text } of rewrites) written[path] = hashOf(Buffer.from(text));
+  writeIntent(repo, {
+    operation: "adopt",
+    writer: person,
+    existed: changed.filter((path) => atHead.has(path)),
+    created: changed.filter((path) => !atHead.has(path)),
+    written,
+    keptBytesFile: keptName,
+  });
+  // After the record that names them: kept bytes no record names would never be removed.
+  keepBytes(repo, kept, keptName);
+  const count = paths.length;
+  try {
+    for (const { path, text } of rewrites) writeFileAtomic(absolute(repo, path), text);
+    if (present.length > 0) stagePaths(store, repo, present, "adopt");
+    if (deleted.length > 0) removePaths(store, repo, deleted, "adopt");
+    if (vanished.length > 0) {
+      runGit(store, repo.path, ["rm", "--cached", "-q", "--ignore-unmatch", "--", ...vanished], {
+        operation: "adopt",
+      });
+    }
+    if (count > 0) {
+      // One line for each path, whatever the name holds: a line break in a file's name
+      // must not put a line of its own into the message.
+      const listed = paths.map((path) => path.replace(CONTROL, "?"));
+      commitPaths(
+        store,
+        repo,
+        paths,
+        `knowledge: adopt ${count} ${count === 1 ? "change" : "changes"} made outside the engine\n\n${listed.join("\n")}`,
+        identityOf(person),
+        "adopt",
+      );
+    }
+  } catch (error) {
+    try {
+      // The person's own work: only unstaged, and their bytes written back as they were.
+      unstage(store, repo, changed, "adopt");
+      restoreKept(repo, keptName);
+      clearIntent(repo);
+    } catch {
+      // The intent record stays: the next `openRepo` puts the person's bytes back.
+    }
+    throw error;
+  }
+  rebuildRepo(store, repo);
+  dropKept(repo, keptName);
+  clearIntent(repo);
+  return { adopted: count, problems: problemsOf(store, repo) };
+}
+
+/** Every problem the repository's files still carry, each with its path. */
+function problemsOf(store: KnowledgeStore, repo: Repo): string[] {
+  const rows = store.db
+    .query<{ path: string; problem: string }, [number, number]>(
+      `SELECT path, problem FROM knowledge_entries WHERE repo_id = ? AND problem IS NOT NULL
+       UNION ALL
+       SELECT path, problem FROM knowledge_proposals WHERE repo_id = ? AND problem IS NOT NULL
+       ORDER BY path`,
+    )
+    .all(repo.id, repo.id);
+  const problems = rows.map((row) => `${row.path}: ${row.problem}`);
+  const decode = (path: string) => {
+    try {
+      const bytes = readRegularFile(absolute(repo, path));
+      return bytes === null ? null : new TextDecoder().decode(bytes);
+    } catch (error) {
+      return error instanceof KnowledgeError ? "" : null;
+    }
+  };
+  const taxonomy = decode(TAXONOMY_FILE);
+  if (taxonomy !== null) {
+    const parsed = parseTaxonomy(taxonomy);
+    if ("problem" in parsed) problems.push(`${TAXONOMY_FILE}: ${parsed.problem}`);
+  }
+  const manifest = decode(MANIFEST_FILE);
+  if (manifest !== null) {
+    const parsed = parseManifest(manifest);
+    if ("problem" in parsed) problems.push(`${MANIFEST_FILE}: ${parsed.problem}`);
+  }
+  return problems;
+}
diff --git a/src/modules/knowledge/taxonomy.ts b/src/modules/knowledge/taxonomy.ts
new file mode 100644
index 0000000..7262986
--- /dev/null
+++ b/src/modules/knowledge/taxonomy.ts
@@ -0,0 +1,195 @@
+// The areas knowledge is catalogued by. An area has an immutable id and a label a person
+// can change: renaming an area touches the taxonomy file and no entry. Each change is a
+// person's write, one commit of `taxonomy.md` alone. An agent cannot change the taxonomy.
+import { AREA_ID, AREA_MAX, LABEL_MAX, nowIso, renderTaxonomy } from "./entry.ts";
+import { KnowledgeError } from "./errors.ts";
+import { rebuildRepo } from "./index-store.ts";
+import {
+  ensureRepo,
+  openRepo,
+  repoFolder,
+  requireGit,
+  TAXONOMY_FILE,
+  taxonomyFor,
+  withRepoLeases,
+} from "./repo.ts";
+import { listRepos } from "./resolve.ts";
+import { requireSchema } from "./schema.ts";
+import { commit, requireClean, settle } from "./store.ts";
+import type { KnowledgeStore, PersonWriter, Repo, RootRef, Taxonomy } from "./types.ts";
+
+const invalid = (message: string) => new KnowledgeError("invalid", message);
+
+/** The taxonomy of a root repository as its file holds it. */
+export function readTaxonomy(store: KnowledgeStore, root: RootRef): Taxonomy {
+  requireSchema(store);
+  const taxonomy = taxonomyFor(store, root);
+  if (taxonomy === null) {
+    throw new KnowledgeError("missing", `there is no ${root.scope} knowledge repository yet`);
+  }
+  return taxonomy;
+}
+
+function checkId(id: string): void {
+  if (!AREA_ID.test(id) || id.length > AREA_MAX) {
+    throw invalid(
+      `area id: lower-case letters, digits and hyphens, at most ${AREA_MAX} characters`,
+    );
+  }
+}
+
+function checkLabel(raw: string): string {
+  const label = raw.trim();
+  if (label === "" || label.length > LABEL_MAX || /[\r\n]/.test(label)) {
+    throw invalid(`area label: 1 to ${LABEL_MAX} characters, on one line`);
+  }
+  return label;
+}
+
+function checkPerson(person: PersonWriter): void {
+  if (person.kind !== "person")
+    throw invalid("the taxonomy is changed by a person, never by an agent");
+}
+
+/**
+ * Writes the next version of the taxonomy in one commit of `taxonomy.md`, under the
+ * leases its caller holds. `next` is given the current areas and the root repository, and
+ * returns the new areas, or refuses.
+ */
+function change(
+  store: KnowledgeStore,
+  root: RootRef,
+  person: PersonWriter,
+  action: string,
+  next: (areas: Taxonomy["areas"], repo: Repo) => Taxonomy["areas"],
+): Taxonomy {
+  const repo = ensureRepo(store, root);
+  requireClean(store, repo, TAXONOMY_FILE);
+  const current = readTaxonomy(store, root);
+  const taxonomy: Taxonomy = {
+    version: current.version + 1,
+    updated: nowIso(store.now()),
+    areas: next(current.areas, repo),
+  };
+  const committed = commit(store, repo, {
+    operation: "taxonomy",
+    writer: person,
+    write: [{ path: TAXONOMY_FILE, text: renderTaxonomy(taxonomy) }],
+    remove: [],
+    existed: [TAXONOMY_FILE],
+    created: [],
+    message: `knowledge: taxonomy ${action}`,
+  });
+  // No row changes: only the repository's head moved.
+  settle(store, repo, committed, () => undefined);
+  return taxonomy;
+}
+
+export function addArea(
+  store: KnowledgeStore,
+  root: RootRef,
+  id: string,
+  label: string,
+  person: PersonWriter,
+): Taxonomy {
+  requireSchema(store);
+  requireGit(store);
+  checkPerson(person);
+  checkId(id);
+  const text = checkLabel(label);
+  return withRepoLeases(store, [repoFolder(root)], () =>
+    change(store, root, person, `add ${id}`, (areas) => {
+      if (areas.some((area) => area.id === id)) {
+        throw new KnowledgeError("exists", `the area ${id} is already in the taxonomy`);
+      }
+      return [...areas, { id, label: text }];
+    }),
+  );
+}
+
+/** Changes the label only: the id is what entries carry, so no entry is touched. */
+export function renameArea(
+  store: KnowledgeStore,
+  root: RootRef,
+  id: string,
+  label: string,
+  person: PersonWriter,
+): Taxonomy {
+  requireSchema(store);
+  requireGit(store);
+  checkPerson(person);
+  checkId(id);
+  const text = checkLabel(label);
+  return withRepoLeases(store, [repoFolder(root)], () =>
+    change(store, root, person, `rename ${id}`, (areas) => {
+      if (!areas.some((area) => area.id === id)) {
+        throw new KnowledgeError("missing", `there is no area ${id} in the taxonomy`);
+      }
+      return areas.map((area) => (area.id === id ? { id, label: text } : area));
+    }),
+  );
+}
+
+/** The repositories that read a root's taxonomy: the root, and for the workspace every project's. */
+function readers(store: KnowledgeStore, root: RootRef): string[] {
+  const rootFolder = repoFolder(root);
+  if (root.scope === "shared") return [rootFolder];
+  const projects = listRepos(store)
+    .repos.filter((repo) => repo.ref.scope === "project")
+    .map((repo) => repo.relative)
+    .sort();
+  return [rootFolder, ...projects];
+}
+
+/**
+ * Removes an area nothing carries. Every repository that reads the taxonomy is held and
+ * read again from its files first, so that no write runs in any of them until the removal
+ * is committed and a stale index hides nothing. Refused while an entry or an open proposal
+ * carries the area, naming it.
+ */
+export function removeArea(
+  store: KnowledgeStore,
+  root: RootRef,
+  id: string,
+  person: PersonWriter,
+): Taxonomy {
+  requireSchema(store);
+  requireGit(store);
+  checkPerson(person);
+  checkId(id);
+  const folders = readers(store, root);
+  return withRepoLeases(store, folders, () =>
+    change(store, root, person, `remove ${id}`, (areas, rootRepo) => {
+      if (!areas.some((area) => area.id === id)) {
+        throw new KnowledgeError("missing", `there is no area ${id} in the taxonomy`);
+      }
+      const repos = listRepos(store).repos.filter((repo) => folders.includes(repo.relative));
+      for (const found of repos) {
+        const repo = found.relative === rootRepo.relative ? rootRepo : openRepo(store, found.ref);
+        if (repo === null) continue;
+        rebuildRepo(store, repo);
+        const entry = store.db
+          .query<{ slug: string }, [number, string]>(
+            "SELECT slug FROM knowledge_entries WHERE repo_id = ? AND area = ? ORDER BY slug LIMIT 1",
+          )
+          .get(repo.id, id);
+        if (entry !== null) {
+          throw invalid(
+            `the area ${id} is still carried by the entry ${entry.slug} (${repo.relative}); move it to another area first`,
+          );
+        }
+        const proposal = store.db
+          .query<{ id: string }, [number, string]>(
+            "SELECT id FROM knowledge_proposals WHERE repo_id = ? AND state = 'open' AND area = ? ORDER BY id LIMIT 1",
+          )
+          .get(repo.id, id);
+        if (proposal !== null) {
+          throw invalid(
+            `the area ${id} is still carried by the open proposal ${proposal.id} (${repo.relative}); a person decides it first`,
+          );
+        }
+      }
+      return areas.filter((area) => area.id !== id);
+    }),
+  );
+}
diff --git a/src/modules/knowledge/tools.ts b/src/modules/knowledge/tools.ts
new file mode 100644
index 0000000..b9480fe
--- /dev/null
+++ b/src/modules/knowledge/tools.ts
@@ -0,0 +1,515 @@
+// Knowledge's three tools, offered by the MCP server and the `tool` bridge (OpenCode) alike:
+// search, read and propose. Loaded only when a server or the bridge asks; a hook never pays
+// for zod, the store or the judge.
+import { join } from "node:path";
+import { resolveProject } from "../../core/project.ts";
+import type { ModuleTool, ToolCall, ToolMode } from "../../engine/module.ts";
+import { makeJudge } from "../../judge/index.ts";
+import type { Judge } from "../../judge/types.ts";
+import { inert } from "../../retrieve/render.ts";
+import { openDb } from "../../store/db.ts";
+import { logError } from "../../util/log.ts";
+import { resolvePaths } from "../../util/paths.ts";
+import { clip } from "../../util/text.ts";
+import { searchTokens } from "../../util/words.ts";
+import { agentWriter, personAuthor } from "./author.ts";
+import {
+  DEFAULT_AREAS,
+  FIELD_MAX,
+  parseTaxonomy,
+  SLUG,
+  TITLE_MAX,
+  UNKNOWN_AGENT,
+} from "./entry.ts";
+import { KnowledgeError } from "./errors.ts";
+import {
+  browseEntries,
+  ensureFresh,
+  entryAt,
+  type Hit,
+  requireKnowledgeRoot,
+  searchEntries,
+  taxonomyOrNull,
+} from "./index-store.ts";
+import {
+  GET_ANSWER_MAX,
+  GET_BODY_MAX,
+  GET_MAX_REFS,
+  PROPOSALS_PER_HOUR,
+  SEARCH_DEFAULT_LIMIT,
+  SEARCH_MAX_LIMIT,
+} from "./policy.ts";
+import { allowProposal, judgeProposal } from "./propose.ts";
+import {
+  kindAt,
+  openRepo,
+  readRegularFile,
+  repoFolder,
+  repoPath,
+  TAXONOMY_FILE,
+  taxonomyFor,
+  withRepoLeases,
+} from "./repo.ts";
+import { requireSchema } from "./schema.ts";
+import { checkArea, proposalBase, proposalSlug, writeEntry } from "./store.ts";
+import { openStore } from "./store-open.ts";
+import type { EntryChange, KnowledgeStore, ScopeRef, Taxonomy } from "./types.ts";
+import { visibleRepos } from "./visible.ts";
+
+export const KNOWLEDGE_TOOL_NAMES = [
+  "knowledge_search",
+  "knowledge_get",
+  "knowledge_propose",
+] as const;
+/** Without a project folder: the workspace's and the shared repositories, read only (D-15). */
+export const GLOBAL_KNOWLEDGE_TOOL_NAMES = ["knowledge_search", "knowledge_get"] as const;
+type ToolName = (typeof KNOWLEDGE_TOOL_NAMES)[number];
+
+/** Where a call was made: the project, or null without a project folder. */
+export type KnowledgeToolContext = { projectId: number | null };
+
+const KINDS = ["knowledge", "strategy", "persona", "pattern"] as const;
+type Scope = "workspace" | "project" | "shared";
+
+/** Sent to the model in every session: one sentence each. */
+const DESCRIPTIONS: Record<ToolName, string> = {
+  knowledge_search:
+    "Search the team's curated knowledge (strategies, personas, patterns, facts kept on purpose) by words; one line per entry with its scope/slug, kind, area and version. Not for what happened in earlier sessions: that is memory_search.",
+  knowledge_get:
+    "Read knowledge entries whole, by the scope/slug references knowledge_search returned.",
+  knowledge_propose:
+    "Propose a new knowledge entry, or a change to one (give its slug and base version). A person accepts it before it becomes knowledge; the area is one of the taxonomy's. Not for session facts, decisions or fixes: those are memory_save.",
+};
+
+const READS = {
+  readOnlyHint: true,
+  destructiveHint: false,
+  idempotentHint: true,
+  openWorldHint: false,
+};
+const META: Record<ToolName, { title: string; annotations: ModuleTool["annotations"] }> = {
+  knowledge_search: { title: "Search knowledge", annotations: READS },
+  knowledge_get: { title: "Read knowledge", annotations: READS },
+  knowledge_propose: {
+    title: "Propose knowledge",
+    annotations: {
+      readOnlyHint: false,
+      destructiveHint: false,
+      idempotentHint: false,
+      openWorldHint: false,
+    },
+  },
+};
+
+const TURNED_OFF = "Knowledge is turned off for this project.";
+const NO_MATCH = "No knowledge matches.";
+const QUOTA = `refused quota: ${PROPOSALS_PER_HOUR} proposals in the last hour; a person decides them first`;
+/** A reference as the agent gives it: a scope and a slug, never a path. */
+const REF = /^(workspace|shared|project)\/[a-z0-9][a-z0-9-]{0,79}$/;
+
+// --- The area enum ----------------------------------------------------------------------
+
+/** A root's areas: its taxonomy file's, or the defaults when the file cannot give them. */
+function rootAreas(dataDir: string, scope: "workspace" | "shared"): Taxonomy["areas"] {
+  try {
+    const folder = repoPath(dataDir, repoFolder({ scope }));
+    if (kindAt(folder) !== "folder") return DEFAULT_AREAS;
+    const bytes = readRegularFile(join(folder, TAXONOMY_FILE));
+    if (bytes === null) return DEFAULT_AREAS;
+    const taxonomy = parseTaxonomy(new TextDecoder().decode(bytes));
+    return "problem" in taxonomy ? DEFAULT_AREAS : taxonomy.areas;
+  } catch {
+    return DEFAULT_AREAS;
+  }
+}
+
+/**
+ * The ids `knowledge_propose` offers: the workspace's, then the shared root's not yet
+ * listed, each root's from its taxonomy file or the defaults the first write creates. The
+ * description names each id's label and the roots that hold it. Reads the two files and
+ * nothing else; never throws.
+ */
+export function areaEnum(dataDir: string): { ids: string[]; description: string } {
+  const workspace = rootAreas(dataDir, "workspace");
+  const shared = rootAreas(dataDir, "shared");
+  const ids = [...new Set([...workspace, ...shared].map((area) => area.id))];
+  const description = ids
+    .map((id) => {
+      const inWorkspace = workspace.find((area) => area.id === id);
+      const inShared = shared.find((area) => area.id === id);
+      const roots = [inWorkspace && "workspace", inShared && "shared"].filter(Boolean).join(", ");
+      return `${id}: ${(inWorkspace ?? inShared)?.label ?? id} (${roots})`;
+    })
+    .join("; ");
+  return { ids, description };
+}
+
+// --- Shared steps ------------------------------------------------------------------------
+
+/** A refusal of the store as one line, its code written once. */
+function refusal(error: KnowledgeError): string {
+  return error.message.startsWith(`${error.code}: `)
+    ? `refused ${error.message}`
+    : `refused ${error.code}: ${error.message}`;
+}
+
+const refOf = (scope: Scope, projectId: number | null): ScopeRef | null =>
+  scope === "project" ? (projectId === null ? null : { scope: "project", projectId }) : { scope };
+
+/**
+ * Brings the repositories a tool reads into the index (`ensureFresh`), each under its
+ * lease. A repository another process holds is read from the index as it is.
+ */
+function freshen(store: KnowledgeStore, scopes: Scope[], projectId: number | null): void {
+  for (const scope of new Set(scopes)) {
+    const ref = refOf(scope, projectId);
+    if (ref === null) continue;
+    try {
+      const repo = openRepo(store, ref);
+      if (repo !== null) withRepoLeases(store, [repo.relative], () => ensureFresh(store, repo));
+    } catch (error) {
+      if (error instanceof KnowledgeError && error.code === "locked") continue;
+      throw error;
+    }
+  }
+}
+
+const ALL_SCOPES: Scope[] = ["workspace", "shared", "project"];
+
+// --- Search ------------------------------------------------------------------------------
+
+export interface SearchArgs {
+  query: string;
+  repo?: "all" | Scope;
+  area?: string;
+  kind?: string;
+  limit?: number;
+}
+
+/**
+ * One line per matching active entry of the repositories the project sees, best first by
+ * bm25, with the area's label from its root's taxonomy (its id when none gives one). A
+ * query with no token lists the pinned entries first, then the newest. Never a proposal.
+ */
+export function searchKnowledge(
+  store: KnowledgeStore,
+  context: KnowledgeToolContext,
+  args: SearchArgs,
+): string {
+  const wanted = args.repo === undefined || args.repo === "all" ? null : args.repo;
+  freshen(store, wanted === null ? ALL_SCOPES : [wanted], context.projectId);
+  const ids = visibleRepos(store.db, context.projectId)
+    .filter((repo) => wanted === null || repo.scope === wanted)
+    .map((repo) => repo.id);
+  const tokens = searchTokens(args.query);
+  const limit = args.limit ?? SEARCH_DEFAULT_LIMIT;
+  const filters = {
+    ...(args.area === undefined ? {} : { area: args.area }),
+    ...(args.kind === undefined ? {} : { kind: args.kind }),
+  };
+  const hits =
+    tokens.length === 0
+      ? browseEntries(store.db, ids, filters, limit)
+      : searchEntries(store.db, tokens, ids, filters, null, limit);
+  if (hits.length === 0) return NO_MATCH;
+  const labels = new Map<string, Taxonomy | null>();
+  const labelOf = (hit: Hit) => {
+    const root = hit.scope === "shared" ? "shared" : "workspace";
+    if (!labels.has(root)) labels.set(root, taxonomyOrNull(store, { ref: { scope: root } }));
+    return labels.get(root)?.areas.find((area) => area.id === hit.area)?.label ?? hit.area;
+  };
+  return hits
+    .map((hit) =>
+      inert(
+        `${hit.scope}/${hit.slug}  ${hit.kind} · ${labelOf(hit)} · v${hit.version}  ${hit.title}`,
+      ),
+    )
+    .join("\n");
+}
+
+// --- Get ---------------------------------------------------------------------------------
+
+/** One entry whole: its heading, nine keys in a fixed order, a blank line and its body. */
+function renderBlock(hit: Hit): string {
+  const body =
+    hit.body.length > GET_BODY_MAX
+      ? `${clip(hit.body, GET_BODY_MAX)}\n[cut at ${GET_BODY_MAX.toLocaleString("en-US")} characters of ${hit.body.length}]`
+      : hit.body;
+  return inert(
+    [
+      `# ${hit.scope}/${hit.slug} (v${hit.version})`,
+      `id: ${hit.id}`,
+      `title: ${hit.title}`,
+      `kind: ${hit.kind}`,
+      `area: ${hit.area}`,
+      `version: ${hit.version}`,
+      `hash: ${hit.hash}`,
+      `author: ${hit.author}`,
+      hit.updated === null ? "updated:" : `updated: ${hit.updated}`,
+      `pinned: ${hit.pinned}`,
+      "",
+      body,
+    ].join("\n"),
+  );
+}
+
+/**
+ * Each reference's entry, in the order given, through the index of the repositories the
+ * project sees: only an active entry with no problem is found, and no reference is ever a
+ * path. Past `GET_ANSWER_MAX` characters the remaining references are counted, not rendered.
+ */
+export function getKnowledge(
+  store: KnowledgeStore,
+  context: KnowledgeToolContext,
+  args: { refs: string[] },
+): string {
+  const parsed = args.refs.map((ref) => {
+    const at = ref.indexOf("/");
+    return { ref, scope: ref.slice(0, at) as Scope, slug: ref.slice(at + 1) };
+  });
+  freshen(
+    store,
+    parsed.map((each) => each.scope),
+    context.projectId,
+  );
+  const visible = visibleRepos(store.db, context.projectId);
+  let answer = "";
+  for (const [at, each] of parsed.entries()) {
+    const repo = REF.test(each.ref) ? visible.find((r) => r.scope === each.scope) : undefined;
+    const hit = repo === undefined ? null : entryAt(store.db, repo.id, each.slug);
+    const block =
+      hit === null || hit.status !== "active" || hit.problem !== null
+        ? `Not found: ${each.ref}`
+        : renderBlock(hit);
+    const next = answer === "" ? block : `${answer}\n---\n${block}`;
+    if (answer !== "" && next.length > GET_ANSWER_MAX) {
+      return `${answer}\n[${parsed.length - at} more not shown: ask for them separately]`;
+    }
+    answer = next;
+  }
+  return answer;
+}
+
+// --- Propose -----------------------------------------------------------------------------
+
+export interface ProposeArgs {
+  repo: Scope;
+  title: string;
+  kind: string;
+  area: string;
+  context?: string;
+  subject?: string;
+  body: string;
+  slug?: string;
+  base_version?: number;
+}
+
+const invalid = (message: string) => new KnowledgeError("invalid", message);
+
+/**
+ * An agent's proposal, after the schema: the rate counter, the area against the target
+ * root's taxonomy, the target, the judge, then the store's write as the agent. Every
+ * refusal of the store answers as one line; a duplicate writes nothing.
+ */
+export async function proposeKnowledge(
+  store: KnowledgeStore,
+  context: KnowledgeToolContext,
+  args: ProposeArgs,
+  agentId: string,
+  judge: Judge,
+): Promise<string> {
+  try {
+    return await propose(store, context, args, agentId, judge);
+  } catch (error) {
+    if (error instanceof KnowledgeError) return refusal(error);
+    throw error;
+  }
+}
+
+async function propose(
+  store: KnowledgeStore,
+  context: KnowledgeToolContext,
+  args: ProposeArgs,
+  agentId: string,
+  judge: Judge,
+): Promise<string> {
+  const db = store.db;
+  if (!allowProposal(db, agentId, store.now())) return QUOTA;
+  // Part 1's rule: no write in the state rebuild refuses (the folder gone, rows in the index).
+  requireKnowledgeRoot(store, "written", "the agent");
+
+  const ref = refOf(args.repo, context.projectId);
+  if (ref === null) throw invalid("repo: a project's repository needs a project folder");
+  const defaults: Taxonomy = { version: 1, updated: "", areas: DEFAULT_AREAS };
+  checkArea(args.area, taxonomyFor(store, ref) ?? defaults);
+  if (args.base_version !== undefined && args.slug === undefined) {
+    throw invalid("base_version: a change names its entry by slug");
+  }
+
+  const change: EntryChange = {
+    title: args.title,
+    kind: args.kind,
+    area: args.area,
+    context: args.context ?? "",
+    subject: args.subject ?? "",
+    body: args.body,
+    ...(args.slug === undefined ? {} : { slug: args.slug }),
+    ...(args.base_version === undefined ? {} : { baseVersion: args.base_version }),
+  };
+  freshen(store, ALL_SCOPES, context.projectId);
+  const repos = visibleRepos(db, context.projectId);
+  const target = repos.find((repo) => repo.scope === args.repo);
+  const slug = proposalSlug(store, change);
+  const current = target === undefined ? null : entryAt(db, target.id, slug);
+  proposalBase(slug, change, current);
+
+  const verdict = await judgeProposal(
+    store,
+    judge,
+    repos,
+    { title: args.title, body: args.body },
+    target !== undefined && current !== null ? { repoId: target.id, entryId: current.id } : null,
+  );
+  if (verdict.duplicate !== null) {
+    logError(
+      "knowledge.propose",
+      new Error(`duplicate of ${verdict.duplicate.ref} (agent ${agentId})`),
+      store.dataDir,
+    );
+    return verdict.duplicate.kind === "entry"
+      ? `refused duplicate: already known as ${verdict.duplicate.ref}; propose a change with its slug and base version`
+      : `refused duplicate: already proposed as ${verdict.duplicate.ref}`;
+  }
+
+  const written = writeEntry(
+    store,
+    ref,
+    {
+      ...change,
+      proposal: {
+        contradicts: verdict.contradicts.map((entry) => entry.id),
+        onBehalfOf: personAuthor(store).name,
+        judgedBy: verdict.judgedBy,
+        judgeVersion: verdict.judgeVersion,
+      },
+    },
+    agentWriter(agentId),
+  );
+  if (written.kind !== "proposed") throw new Error("an agent's write must be a proposal");
+  const proposal = written.proposal;
+  const changes = proposal.baseVersion > 0 ? ` changes v${proposal.baseVersion}` : "";
+  return [
+    `proposed ${args.repo}/${proposal.id} for ${proposal.slug}${changes}`,
+    ...verdict.contradicts.map((entry) => `contradicts ${entry.ref}`),
+  ].join("\n");
+}
+
+// --- The tools ---------------------------------------------------------------------------
+
+/** The arguments' schemas; zod is loaded here and nowhere a hook runs. */
+async function schemas(global: boolean, areas: { ids: string[]; description: string } | null) {
+  const { z } = await import("zod");
+  const kind = z.enum(KINDS);
+  const [first, ...rest] = areas?.ids ?? [];
+  const area =
+    first === undefined
+      ? z.string().min(1)
+      : z.enum([first, ...rest]).describe(areas?.description ?? "");
+  return {
+    knowledge_search: z.object({
+      query: z.string().describe("Words. Empty lists the pinned entries, then the newest."),
+      repo: (global
+        ? z.enum(["all", "workspace", "shared"])
+        : z.enum(["all", "workspace", "project", "shared"])
+      ).optional(),
+      area: z.string().optional().describe("An area id."),
+      kind: kind.optional(),
+      limit: z.number().int().min(1).max(SEARCH_MAX_LIMIT).optional(),
+    }),
+    knowledge_get: z.object({
+      refs: z
+        .array(z.string().regex(REF))
+        .min(1)
+        .max(GET_MAX_REFS)
+        .describe("scope/slug references, as knowledge_search returns them."),
+    }),
+    knowledge_propose: z.object({
+      repo: z.enum(["workspace", "project", "shared"]),
+      title: z.string().min(1).max(TITLE_MAX),
+      kind,
+      area,
+      context: z.string().max(FIELD_MAX).optional(),
+      subject: z.string().max(FIELD_MAX).optional(),
+      body: z.string().min(1),
+      slug: z.string().regex(SLUG).max(80).optional().describe("For a change: the entry's slug."),
+      base_version: z
+        .number()
+        .int()
+        .min(1)
+        .optional()
+        .describe("For a change: the entry's version the change is based on."),
+    }),
+  };
+}
+
+/** One validated call against a freshly opened database. */
+async function runTool(
+  name: ToolName,
+  global: boolean,
+  args: unknown,
+  call: ToolCall,
+): Promise<string> {
+  const { dataDir, storeDir } = resolvePaths();
+  const db = openDb({ dataDir: storeDir, busyTimeoutMs: 2000 });
+  try {
+    let projectId: number | null = null;
+    if (!global) {
+      const project = resolveProject(db, call.projectDir ?? process.cwd(), Date.now());
+      // Nothing is read or written for knowledge in a project the person turned off.
+      if (project.disabled) return TURNED_OFF;
+      projectId = project.id;
+    }
+    const store = openStore({ db, dataDir });
+    const context = { projectId };
+    try {
+      requireSchema(store);
+      switch (name) {
+        case "knowledge_search":
+          return searchKnowledge(store, context, args as SearchArgs);
+        case "knowledge_get":
+          return getKnowledge(store, context, args as { refs: string[] });
+        case "knowledge_propose":
+          return await proposeKnowledge(
+            store,
+            context,
+            args as ProposeArgs,
+            call.agentId ?? UNKNOWN_AGENT,
+            makeJudge({ db, dataDir, toolPath: true }),
+          );
+      }
+    } catch (error) {
+      if (error instanceof KnowledgeError) return refusal(error);
+      throw error;
+    }
+  } finally {
+    db.close();
+  }
+}
+
+/**
+ * The tools knowledge offers in this mode. Listing opens no database, writes nothing and
+ * never throws: inside a project it reads the two taxonomy files for the area enum.
+ */
+export async function knowledgeTools(mode: ToolMode): Promise<ModuleTool[]> {
+  const global = mode === "global";
+  const areas = global ? null : areaEnum(resolvePaths().dataDir);
+  const schema = await schemas(global, areas);
+  return (global ? GLOBAL_KNOWLEDGE_TOOL_NAMES : KNOWLEDGE_TOOL_NAMES).map((name) => ({
+    name,
+    title: META[name].title,
+    annotations: META[name].annotations,
+    description: DESCRIPTIONS[name],
+    inputSchema: schema[name],
+    run: (args, call) => runTool(name, global, args, call),
+  }));
+}
