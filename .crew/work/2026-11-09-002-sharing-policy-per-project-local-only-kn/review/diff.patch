+
+  test("warns before a folder reaches the cap, and when the index left files out", () => {
+    const repo = ensureRepo(store, WORKSPACE);
+    for (let n = 0; n < 4001; n++) {
+      const id = `00000000-0000-4000-8000-${n.toString(16).padStart(12, "0")}`;
+      writeFileSync(
