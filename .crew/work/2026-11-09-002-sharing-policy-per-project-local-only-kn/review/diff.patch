+
+export interface Taxonomy {
+  version: number;
+  updated: string;
+  areas: { id: string; label: string }[];
+}
+
+/** An item of a block list in the frontmatter: `- scalar` or `- key: value`. */
+export type ListItem = string | { key: string; value: string };
