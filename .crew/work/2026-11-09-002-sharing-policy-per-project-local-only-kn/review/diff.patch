+interface LevelRow {
+  projectId: number;
+  level: string;
+  boundAlias: string;
+  source: string;
+}
+const levels = () =>
+  withDb((db) =>
+    db
+      .query<LevelRow, []>(
+        `SELECT project_id AS projectId, level, bound_alias AS boundAlias, source
+           FROM sharing_levels ORDER BY project_id`,
