+}
+const changes = () =>
+  withDb((db) =>
+    db.query<Change, []>("SELECT what, old, new, source FROM sharing_changes ORDER BY id").all(),
+  );
+
+const envFile = () =>
+  existsSync(join(dataDir, "env")) ? readFileSync(join(dataDir, "env"), "utf8") : "";
+
+describe("share project", () => {
