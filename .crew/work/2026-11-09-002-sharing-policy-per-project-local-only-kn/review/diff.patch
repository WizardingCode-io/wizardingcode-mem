+  "raisin",
+  "sorrel",
+  "tamarind",
+  "ugli",
+  "vanilla",
+  "walnut",
+  "yarrow",
+  "zucchini",
+  "almond",
+  "basil",
+  "cumin",
+  "dill",
+  "fennel",
+];
+const words = (...indexes: number[]) => indexes.map((i) => W[i]).join(" ");
+
+let fx: Fixture;
+let store: KnowledgeStore;
+let clock: number;
+let project: string;
+let projectId: number;
+const savedEnv: Record<string, string | undefined> = {};
+const ENV_KEYS = [
+  "WIZARDINGCODE_MEM_DATA_DIR",
