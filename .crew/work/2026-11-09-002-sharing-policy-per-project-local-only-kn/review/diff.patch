+
+  test("warns when a project matches two manifests", () => {
+    const projectId = fx.addProject("gitdir:/x/.git", "path:/x");
+    writeEntry(store, { scope: "project", projectId }, change(), person());
+    const twin = "knowledge/projects/twin";
