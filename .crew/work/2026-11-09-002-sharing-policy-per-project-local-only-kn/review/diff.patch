+  addArea,
+  readTaxonomy,
+  removeArea,
+  renameArea,
+} from "../../src/modules/knowledge/taxonomy.ts";
+import type { EntryChange, KnowledgeStore, Repo } from "../../src/modules/knowledge/types.ts";
