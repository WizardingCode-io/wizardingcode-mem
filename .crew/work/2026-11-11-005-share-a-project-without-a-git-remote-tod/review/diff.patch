+afterAll(() => cleanWorlds());
+
+const NAMED = 2;
+const FOLDER = `projects/wizardingcode-${projectFolderName(NAME).slice(0, 8)}`;
+
+/** The URLs the client asked for. */
+function spyFetch(w: World): string[] {
