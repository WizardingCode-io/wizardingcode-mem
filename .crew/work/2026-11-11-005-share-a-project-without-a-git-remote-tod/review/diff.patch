@@ -0,0 +1,87 @@
+// The name of a project (ADR 0028): the shared name a text makes, the one name a project
+// carries, and the change log's line for a name.
+import { describe, expect, test } from "bun:test";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { formatChange } from "../../src/sharing/format.ts";
+import { nameOf, sharedNameOf } from "../../src/sharing/names.ts";
+
+describe("sharedNameOf", () => {
+  test("slugs a title as the knowledge store does, under name:", () => {
+    expect(sharedNameOf("Estratégia de marca")).toEqual({
+      ok: true,
+      alias: "name:estrategia-de-marca",
+    });
+    expect(sharedNameOf("wizardingcode")).toEqual({ ok: true, alias: "name:wizardingcode" });
+    expect(sharedNameOf("  WizardingCode  ")).toEqual({ ok: true, alias: "name:wizardingcode" });
+    // The core of slugify collapses the hyphens: what is no shared slug as typed is one here.
+    expect(sharedNameOf("a--b")).toEqual({ ok: true, alias: "name:a-b" });
+    expect(sharedNameOf("-x-")).toEqual({ ok: true, alias: "name:x" });
+    expect(sharedNameOf("x".repeat(81))).toEqual({ ok: true, alias: `name:${"x".repeat(80)}` });
+  });
+
+  test("refuses a text with no letter or digit, with no word", () => {
+    expect(sharedNameOf("!!!")).toEqual({ ok: false, reason: "no-name" });
+    expect(sharedNameOf("")).toEqual({ ok: false, reason: "no-name" });
+    expect(sharedNameOf(" - ")).toEqual({ ok: false, reason: "no-name" });
+  });
+
+  test("refuses a reserved file name, naming the word, and appends nothing behind the person's back", () => {
+    expect(sharedNameOf("CON")).toEqual({ ok: false, reason: "no-name", word: "con" });
+    expect(sharedNameOf("lpt1")).toEqual({ ok: false, reason: "no-name", word: "lpt1" });
+    expect(sharedNameOf("console")).toEqual({ ok: true, alias: "name:console" });
+  });
+});
+
+describe("nameOf", () => {
+  test("the one shared name a project carries, or null", () => {
+    expect(nameOf(["path:/x", "name:a"])).toBe("name:a");
+    expect(nameOf(["name:a", "remote:github.com/a/b"])).toBe("name:a");
+    expect(nameOf(["path:/x"])).toBeNull();
+    expect(nameOf([])).toBeNull();
+    // Only a well-formed shared name counts.
+    expect(nameOf(["name:Bad"])).toBeNull();
+  });
+});
+
+describe("formatChange", () => {
+  const names = (id: number) => (id === 3 ? "wizardingcode" : null);
+
+  test("a project's level, the lists and a server as share status renders them today", () => {
+    expect(formatChange({ what: "project:3", old: "local", new: "knowledge" }, names)).toBe(
+      "project:3 local → knowledge",
+    );
+    expect(formatChange({ what: "project:3@abc", old: "knowledge", new: "all" }, names)).toBe(
+      "project:3@abc knowledge → all",
+    );
+    expect(formatChange({ what: "roots", old: "none", new: "workspace" }, names)).toBe(
+      "roots none → workspace",
+    );
+    expect(formatChange({ what: "areas@abc", old: "none", new: "workspace:sales" }, names)).toBe(
+      "areas@abc none → workspace:sales",
+    );
+    expect(formatChange({ what: "server:abc", old: "", new: "mem.example" }, names)).toBe(
+      "server:abc  → mem.example",
+    );
+  });
+
+  test("a shared name names the project and says none for an empty side", () => {
+    expect(formatChange({ what: "name:3", old: "name:a", new: "" }, names)).toBe(
+      "shared name of wizardingcode: name:a → none",
+    );
+    expect(formatChange({ what: "name:3", old: "", new: "name:wizardingcode" }, names)).toBe(
+      "shared name of wizardingcode: none → name:wizardingcode",
+    );
+    expect(formatChange({ what: "name:3", old: "name:a", new: "name:b" }, names)).toBe(
+      "shared name of wizardingcode: name:a → name:b",
+    );
+    expect(formatChange({ what: "name:9", old: "name:a", new: "" }, names)).toBe(
+      "shared name of project 9: name:a → none",
+    );
+  });
+
+  test("format.ts is a leaf, so the viewer's page and the CLI read one rule", () => {
+    const ROOT = join(import.meta.dir, "..", "..");
+    expect(readFileSync(join(ROOT, "src/sharing/format.ts"), "utf8")).not.toMatch(/^\s*import\b/m);
+  });
+});
diff --git a/tests/unit/store-migration-8.test.ts b/tests/unit/store-migration-8.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/store-migration-8.test.ts
@@ -0,0 +1,149 @@
+// Core migration 8 (ADR 0028): one shared name per project, held by a partial unique index
+// over `project_aliases`; the upgrade's copy; an older binary's refusal; the sharing
+// namespace's third migration, which gives `sharing_levels` the name's id.
+import { Database } from "bun:sqlite";
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { mkdtempSync, readdirSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  DB_FILE,
+  LATEST_VERSION,
+  MIGRATIONS,
+  openDb,
+  openExistingFile,
+  SchemaTooNewError,
+} from "../../src/store/db.ts";
+
+let dir: string;
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "wizardingcode-mem-migration-8-"));
+});
+afterEach(() => {
+  rmSync(dir, { recursive: true, force: true });
+});
+
+const open = () => openDb({ dataDir: dir, busyTimeoutMs: 2000 });
+
+const userVersion = (db: Database) =>
+  db.query<{ user_version: number }, []>("PRAGMA user_version").get()?.user_version;
+
+const indexes = (db: Database) =>
+  db
+    .query<{ name: string }, []>(
+      "SELECT name FROM sqlite_master WHERE type = 'index' ORDER BY name",
+    )
+    .all()
+    .map((row) => row.name);
+
+const columnsOf = (db: Database, table: string) =>
+  db
+    .query<{ name: string }, []>(`PRAGMA table_info(${table})`)
+    .all()
+    .map((column) => column.name);
+
+const addProject = (db: Database, key: string) =>
+  db.run("INSERT INTO projects (key, name, created_at) VALUES (?, ?, 1)", [key, key]);
+
+const addAlias = (db: Database, projectId: number, alias: string) =>
+  db.run("INSERT INTO project_aliases (alias, project_id) VALUES (?, ?)", [alias, projectId]);
+
+describe("migration 8: one shared name per project", () => {
+  test("a fresh store is at 8 and has the index", () => {
+    const db = open();
+    expect(LATEST_VERSION).toBe(8);
+    expect(userVersion(db)).toBe(8);
+    expect(indexes(db)).toContain("project_aliases_one_name");
+    db.close();
+  });
+
+  test("a second name for one project is refused; two path aliases are not", () => {
+    const db = open();
+    addProject(db, "path:/p");
+    addAlias(db, 1, "name:a");
+    expect(() => addAlias(db, 1, "name:b")).toThrow(/UNIQUE constraint failed/);
+    addAlias(db, 1, "path:/one");
+    addAlias(db, 1, "path:/two");
+    expect(db.query<{ n: number }, []>("SELECT count(*) AS n FROM project_aliases").get()?.n).toBe(
+      3,
+    );
+    db.close();
+  });
+
+  test("two projects may each carry one name", () => {
+    const db = open();
+    addProject(db, "path:/p");
+    addProject(db, "path:/q");
+    addAlias(db, 1, "name:a");
+    addAlias(db, 2, "name:b");
+    expect(
+      db
+        .query<{ alias: string }, []>("SELECT alias FROM project_aliases ORDER BY alias")
+        .all()
+        .map((row) => row.alias),
+    ).toEqual(["name:a", "name:b"]);
+    db.close();
+  });
+
+  test("a version 7 store is upgraded to 8 behind a copy named after 7", () => {
+    const before = openDb({
+      dataDir: dir,
+      busyTimeoutMs: 2000,
+      migrations: MIGRATIONS.slice(0, 7),
+    });
+    expect(userVersion(before)).toBe(7);
+    addProject(before, "path:/p");
+    addAlias(before, 1, "remote:github.com/acme/site");
+    before.close();
+
+    const db = open();
+    expect(userVersion(db)).toBe(8);
+    expect(indexes(db)).toContain("project_aliases_one_name");
+    expect(
+      db
+        .query<{ alias: string }, []>("SELECT alias FROM project_aliases")
+        .all()
+        .map((row) => row.alias),
+    ).toEqual(["remote:github.com/acme/site"]);
+    db.close();
+
+    const copies = readdirSync(join(dir, "backups")).filter((name) => name.endsWith(".db"));
+    expect(copies).toHaveLength(1);
+    expect(copies[0]).toMatch(/^wizardingcode-mem-\d+-v7-\d+\.db$/);
+    const copy = new Database(join(dir, "backups", copies[0] as string), { readonly: true });
+    expect(userVersion(copy)).toBe(7);
+    expect(indexes(copy)).not.toContain("project_aliases_one_name");
+    copy.close();
+  });
+
+  test("a binary that knows 7 refuses a version 8 store", () => {
+    open().close();
+    expect(() => openExistingFile(dir, DB_FILE, { latest: 7 })).toThrow(SchemaTooNewError);
+    const db = openExistingFile(dir, DB_FILE, { latest: 8 });
+    expect(db).not.toBeNull();
+    db?.close();
+  });
+});
+
+describe("sharing namespace 3: the name's id on a level", () => {
+  test("sharing_levels has the column name_id, nullable, after the ones it had", () => {
+    const db = open();
+    expect(columnsOf(db, "sharing_levels")).toEqual([
+      "project_id",
+      "destination",
+      "level",
+      "bound_alias",
+      "set_at",
+      "source",
+      "name_id",
+    ]);
+    const info = db
+      .query<{ name: string; notnull: number; dflt_value: string | null }, []>(
+        "PRAGMA table_info(sharing_levels)",
+      )
+      .all()
+      .find((column) => column.name === "name_id");
+    expect(info).toMatchObject({ notnull: 0, dflt_value: null });
+    db.close();
+  });
+});
