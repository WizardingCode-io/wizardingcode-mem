+    const before = head(other);
+    expect(() =>
+      commitAndPush(options(change, { tag: "v1.0.1", version: "1.0.1", sha: "0".repeat(40) })),
+    ).toThrow("v1.0.1 no longer names the commit that was judged");
+    expect(head(other)).toBe(before);
+  });
