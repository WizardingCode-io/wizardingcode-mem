+      ["latest", { kind: "moved", version: "0.9.0" }, "latest: moved to 0.9.0"],
+      ["latest", { kind: "would-move", version: "0.9.0" }, "latest: would move to 0.9.0 (dry run)"],
+      [
+        "latest",
+        { kind: "held-contract", tag: "v0.10.0", accepts: 4, previous: "v0.9.0", speaks: 3 },
