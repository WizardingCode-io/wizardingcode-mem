new file mode 100644
index 0000000..a43f583
--- /dev/null
+++ b/scripts/release/plan.ts
@@ -0,0 +1,147 @@
+// The first job of the distribution: whether this tag may be distributed, and what the other
+// jobs work from. Exits 1 with one sentence on a refusal.
+//
+//   bun scripts/release/plan.ts
+//
+// Environment: TAG, RELEASE_HOLD, DRY_RUN, GITHUB_REF, GITHUB_REPOSITORY, GH_TOKEN (for gh).
+import {
+  CONTRACT_FILE,
+  command,
+  decideHold,
+  decidePlan,
+  type Environment,
+  isVersionTag,
+  latestLine,
+  output,
+  type PlanFacts,
+  passingFacts,
+  planSummary,
+  previousPlain,
+  ReleaseError,
+  run,
+  summary,
+} from "./lib.ts";
+
+const git = (...args: string[]) => run(["git", ...args]);
+
+/** The commit a tag names, or null when there is no such tag. */
+function commitOf(tag: string): string | null {
+  const out = git("rev-parse", "--verify", "--quiet", `refs/tags/${tag}^{commit}`);
+  return out.code === 0 ? out.stdout.trim() : null;
+}
+
+/** The version of package.json at a commit, or null when it cannot be read. */
+function packageVersionAt(sha: string): string | null {
+  const out = git("show", `${sha}:package.json`);
+  if (out.code !== 0) return null;
+  try {
+    const version = (JSON.parse(out.stdout) as { version?: unknown }).version;
+    return typeof version === "string" ? version : null;
+  } catch {
+    return null;
+  }
+}
+
+/** The GitHub release of a tag, or null when there is none. Any other failure is said, not guessed. */
+function readRelease(tag: string): PlanFacts["release"] {
+  const out = run(["gh", "release", "view", tag, "--json", "isDraft,assets"]);
+  if (out.code !== 0) {
+    if (out.stderr.includes("release not found")) return null;
+    throw new ReleaseError(`could not read the release ${tag}: ${out.stderr.trim()}`);
+  }
+  const release = JSON.parse(out.stdout) as { isDraft: boolean; assets: Array<{ name: string }> };
+  return { isDraft: release.isDraft, assets: release.assets.map((asset) => asset.name) };
+}
+
+/** The environment `release` and its deployment branch rule, as the API gives them. */
+function readEnvironment(repo: string): Environment {
+  const failed = (stderr: string) =>
+    new ReleaseError(`could not read the environment release: ${stderr.trim()}`);
+  const environment = run(["gh", "api", `repos/${repo}/environments/release`]);
+  if (environment.code !== 0) {
+    if (environment.stderr.includes("HTTP 404"))
+      return { exists: false, policy: null, branches: [] };
+    throw failed(environment.stderr);
+  }
+  const policy = (
+    JSON.parse(environment.stdout) as { deployment_branch_policy: Environment["policy"] }
+  ).deployment_branch_policy;
+  const policies = run([
+    "gh",
+    "api",
+    `repos/${repo}/environments/release/deployment-branch-policies`,
+  ]);
+  if (policies.code !== 0) throw failed(policies.stderr);
+  const branches = (
+    JSON.parse(policies.stdout) as { branch_policies: Array<{ name: string; type: string }> }
+  ).branch_policies.map(({ name, type }) => ({ name, type }));
+  return { exists: true, policy, branches };
+}
+
+/** The contract file's text at a commit; "missing" when the tree has none, "unreadable" when it cannot be shown. */
+function contractAt(sha: string): "missing" | "unreadable" | string {
+  if (git("cat-file", "-e", `${sha}:${CONTRACT_FILE}`).code !== 0) return "missing";
+  const shown = git("show", `${sha}:${CONTRACT_FILE}`);
+  return shown.code === 0 ? shown.stdout : "unreadable";
+}
+
+command("plan", () => {
+  const tag = process.env.TAG ?? "";
+  const repo = process.env.GITHUB_REPOSITORY ?? "";
+  const facts = passingFacts(process.env.GITHUB_REF ?? "", tag);
+  // Each fact is read only once every earlier refusal has passed, so a later read that fails
+  // never hides an earlier refusal; a malformed tag is refused before it reaches any program.
+  const check = () => {
+    const decision = decidePlan(facts);
+    if (!decision.ok) throw new ReleaseError(decision.sentence);
+    return decision;
+  };
+  check();
+  facts.tagSha = commitOf(tag);
+  const sha = check().sha;
+  facts.onMain = git("merge-base", "--is-ancestor", sha, "origin/main").code === 0;
+  check();
+  facts.packageVersion = packageVersionAt(sha);
+  check();
+  facts.hasDistribute = git("cat-file", "-e", `${sha}:.github/workflows/distribute.yml`).code === 0;
+  check();
+  facts.tags = git("tag", "--merged", "origin/main", "--list", "v*")
+    .stdout.split("\n")
+    .map((line) => line.trim())
+    .filter(isVersionTag);
+  check();
+  facts.release = readRelease(tag);
+  check();
+  facts.environment = readEnvironment(repo);
+  const plan = check();
+
+  let hold = { held: false, byHand: false, outcome: null } as ReturnType<typeof decideHold>;
+  if (!plan.prerelease) {
+    const previous = previousPlain(tag, facts.tags);
+    const previousSha = previous === null ? null : commitOf(previous);
+    const atTag = contractAt(sha);
+    hold = decideHold({
+      tag,
+      atTag: atTag === "missing" || atTag === "unreadable" ? null : atTag,
+      previous,
+      atPrevious: previousSha === null ? "missing" : contractAt(previousSha),
+      releaseHold: process.env.RELEASE_HOLD === "true",
+    });
+  }
+  output("version", plan.version);
+  output("sha", plan.sha);
+  output("prerelease", String(plan.prerelease));
+  output("held", String(hold.held));
+  output(
+    "latest_line",
+    plan.prerelease || hold.held
+      ? ""
+      : latestLine({
+          version: plan.version,
+          dryRun: process.env.DRY_RUN === "true",
+          byHand: hold.byHand,
+        }),
+  );
+  for (const line of planSummary({ prerelease: plan.prerelease, hold: hold.outcome }))
+    summary(line);
+});
diff --git a/scripts/release/push.ts b/scripts/release/push.ts
new file mode 100644
index 0000000..e61011c
--- /dev/null
+++ b/scripts/release/push.ts
@@ -0,0 +1,233 @@
+// The one writer to another repository: the Homebrew tap's formula and the marketplace's two
+// manifests. A clone, an edit, a commit only when the tree changed, a push.
+//
+//   bun scripts/release/push.ts --target tap|marketplace
+//
+// Environment: TAG, SHA (the commit plan judged), VERSION, DRY_RUN, MARKETPLACE_TOKEN,
+// CHECKSUMS (the path of the release's checksums.txt; tap only), GITHUB_REPOSITORY.
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import {
+  command,
+  editManifests,
+  type Outcome,
+  parseChecksums,
+  ReleaseError,
+  type Runner,
+  renderFormula,
+  run,
+  summary,
+  summaryLine,
+} from "./lib.ts";
+
+const BOT = {
+  name: "github-actions[bot]",
+  email: "41898282+github-actions[bot]@users.noreply.github.com",
+};
+
+/**
+ * The environment of a git call to github.com: the token as an authorization header, so it is
+ * never in a remote's URL, in an argument or in a file of the clone.
+ */
+export function gitEnv(
+  token: string | null,
+  base: Record<string, string | undefined>,
+): Record<string, string | undefined> {
+  const env = { ...base, GIT_TERMINAL_PROMPT: "0" };
+  if (token === null) return env;
+  return {
+    ...env,
+    GIT_CONFIG_COUNT: "1",
+    GIT_CONFIG_KEY_0: "http.https://github.com/.extraheader",
+    GIT_CONFIG_VALUE_0: `Authorization: Basic ${Buffer.from(`x-access-token:${token}`).toString("base64")}`,
+  };
+}
+
+/** The commit a tag names in `git ls-remote`'s answer: the peeled line for an annotated tag. */
+export function tagNames(lsRemote: string, tag: string): string | null {
+  const commitOf = (ref: string): string | null => {
+    for (const line of lsRemote.split("\n")) {
+      const [sha, name] = line.trim().split(/\s+/);
+      if (name === ref && sha !== undefined) return sha;
+    }
+    return null;
+  };
+  return commitOf(`refs/tags/${tag}^{}`) ?? commitOf(`refs/tags/${tag}`);
+}
+
+export interface PushOptions {
+  /** The repository written to. */
+  remote: string;
+  /** This repository, where the tag lives. */
+  origin: string;
+  tag: string;
+  /** The commit plan judged the tag to name. */
+  sha: string;
+  version: string;
+  dryRun: boolean;
+  token: string | null;
+  /** Changes the clone; an outcome returned is the answer as it is, with nothing written. */
+  edit: (dir: string) => Outcome | null;
+  log: (line: string) => void;
+  runner?: Runner;
+}
+
+/** Writes the edit to the other repository's default branch, or says why nothing was written. */
+export function commitAndPush(options: PushOptions): Outcome {
+  const { remote, origin, tag, sha, version, token } = options;
+  const exec = options.runner ?? run;
+  // The values written name the tag: a tag moved since plan judged it stops here. This reads
+  // this repository, so it never carries the other repositories' token.
+  const refs = exec([
+    "git",
+    "ls-remote",
+    "--tags",
+    origin,
+    `refs/tags/${tag}`,
+    `refs/tags/${tag}^{}`,
+  ]);
+  if (refs.code !== 0)
+    throw new ReleaseError(`could not read the tag ${tag}: ${refs.stderr.trim()}`);
+  if (tagNames(refs.stdout, tag) !== sha)
+    throw new ReleaseError(
+      `${tag} no longer names the commit that was judged (${sha}); nothing was written`,
+    );
+
+  const dir = mkdtempSync(join(tmpdir(), "wcm-release-"));
+  const authed = gitEnv(token, process.env);
+  const git = (args: string[], env?: Record<string, string | undefined>) =>
+    exec(["git", ...args], env === undefined ? { cwd: dir } : { cwd: dir, env });
+  const must = (args: string[], env?: Record<string, string | undefined>) => {
+    const out = git(args, env);
+    if (out.code !== 0)
+      throw new ReleaseError(`git ${args[0]} failed in ${remote}: ${out.stderr.trim()}`);
+    return out.stdout;
+  };
+  try {
+    must(["clone", "--quiet", remote, "."], authed);
+    // Local to the clone, so the commit and a rebase both have an identity.
+    must(["config", "user.name", BOT.name]);
+    must(["config", "user.email", BOT.email]);
+
+    const early = options.edit(dir);
+    if (early !== null) return early;
+    if (must(["status", "--porcelain"]).trim() === "") return { kind: "already-at", version };
+    if (options.dryRun) {
+      options.log(must(["status", "--short"]));
+      must(["add", "-N", "."]);
+      options.log(must(["diff"]));
+      return { kind: "would-write", version };
+    }
+    must(["add", "-A"]);
+    must(["commit", "--quiet", "-m", `wizardingcode-mem ${version}`]);
+    const first = git(["push", "--quiet", "origin", "HEAD"], authed);
+    if (first.code !== 0) {
+      // GitHub's refusals by a rule: a protected branch (GH006), a ruleset (GH013).
+      if (/GH006|GH013|protected branch|repository rule violations/i.test(first.stderr))
+        throw new ReleaseError(
+          `the push to ${remote} was refused by a rule on its branch: it must accept a direct push from the token's owner`,
+        );
+      if (/\b403\b|[Pp]ermission/.test(first.stderr))
+        throw new ReleaseError(
+          `the push to ${remote} was refused: MARKETPLACE_TOKEN may lack contents write there`,
+        );
+      // Only a refusal because the remote moved is worth a second try; anything else (the
+      // network, the credentials) is said as git said it.
+      if (!/non-fast-forward|fetch first|\[rejected\]/.test(first.stderr))
+        throw new ReleaseError(`the push to ${remote} failed: ${first.stderr.trim()}`);
+      // Someone else pushed meanwhile: replay this one commit over theirs, once.
+      const rebased = git(["pull", "--rebase", "--quiet"], authed);
+      if (rebased.code !== 0) {
+        git(["rebase", "--abort"]);
+        throw new ReleaseError(
+          `the push to ${remote} was refused and the rebase failed: ${rebased.stderr.trim()}`,
+        );
+      }
+      const second = git(["push", "--quiet", "origin", "HEAD"], authed);
+      if (second.code !== 0)
+        throw new ReleaseError(`the push to ${remote} was refused twice: ${second.stderr.trim()}`);
+    }
+    return { kind: "written", version };
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+const REMOTES = {
+  tap: "https://github.com/WizardingCode-io/homebrew-wizardingcode.git",
+  marketplace: "https://github.com/WizardingCode-io/wizardingcode-plugins.git",
+};
+const FORMULA = "Formula/wizardingcode-mem.rb";
+const MANIFESTS = {
+  claude: ".claude-plugin/marketplace.json",
+  agents: ".agents/plugins/marketplace.json",
+};
+
+/** The formula for this release, rendered from the template beside this script's repository. */
+function editTap(version: string, checksumsPath: string): PushOptions["edit"] {
+  return (dir) => {
+    const root = new URL("../../", import.meta.url).pathname;
+    const template = readFileSync(
+      join(root, "packaging/homebrew/wizardingcode-mem.rb.template"),
+      "utf8",
+    );
+    const checksums = parseChecksums(readFileSync(checksumsPath, "utf8"));
+    mkdirSync(dirname(join(dir, FORMULA)), { recursive: true });
+    writeFileSync(join(dir, FORMULA), renderFormula(template, version, checksums));
+    return null;
+  };
+}
+
+/** The plugin's entry in the two manifests; neither is written when either is at a higher version. */
+function editMarketplace(version: string): PushOptions["edit"] {
+  return (dir) => {
+    const claude = join(dir, MANIFESTS.claude);
+    const agents = join(dir, MANIFESTS.agents);
+    const edited = editManifests(
+      readFileSync(claude, "utf8"),
+      readFileSync(agents, "utf8"),
+      version,
+    );
+    if (edited.outcome === "left-alone")
+      return { kind: "left-alone", higher: edited.higher as string };
+    writeFileSync(claude, edited.claude);
+    writeFileSync(agents, edited.agents);
+    return null;
+  };
+}
+
+function need(name: string): string {
+  const value = process.env[name];
+  if (value === undefined || value === "") throw new ReleaseError(`${name} is not set`);
+  return value;
+}
+
+if (import.meta.main) {
+  const flag = process.argv.indexOf("--target");
+  const target = process.argv[flag + 1];
+  if (flag === -1 || (target !== "tap" && target !== "marketplace")) {
+    process.stderr.write("usage: bun scripts/release/push.ts --target tap|marketplace\n");
+    process.exit(1);
+  }
+  command(target, () => {
+    const version = need("VERSION");
+    const onRunner = process.env.GITHUB_ACTIONS === "true";
+    const outcome = commitAndPush({
+      // The two overrides exist for the command's test, which writes to local repositories;
+      // on a runner they are never read, so the token's writer goes only where it is meant to.
+      remote: (onRunner ? undefined : process.env.PUSH_REMOTE) || REMOTES[target],
+      origin:
+        (onRunner ? undefined : process.env.PUSH_ORIGIN) ||
+        `https://github.com/${need("GITHUB_REPOSITORY")}.git`,
+      tag: need("TAG"),
+      sha: need("SHA"),
+      version,
+      dryRun: process.env.DRY_RUN === "true",
+      token: process.env.MARKETPLACE_TOKEN || null,
+      edit: target === "tap" ? editTap(version, need("CHECKSUMS")) : editMarketplace(version),
+      log: (line) => process.stdout.write(line.endsWith("\n") ? line : `${line}\n`),
+    });
+    summary(summaryLine(target, outcome));
+  });
+}
diff --git a/scripts/release/token.ts b/scripts/release/token.ts
new file mode 100644
index 0000000..7a8bedb
--- /dev/null
+++ b/scripts/release/token.ts
@@ -0,0 +1,57 @@
+// The marketplace token's state for one repository it must write: a missing, expired or
+// ungranted token fails with its own sentence, and one near its expiry is a warning.
+//
+//   bun scripts/release/token.ts <owner/repo>
+//
+// Environment: MARKETPLACE_TOKEN.
+import { command, decideToken, ReleaseError, run, summary } from "./lib.ts";
+
+/** One `gh api -i` answer: the status line, the headers, a blank line, the body. */
+function parse(answer: string): {
+  status: number | null;
+  expiration: string | null;
+  push: boolean | null;
+} {
+  const [head = "", ...rest] = answer.replaceAll("\r\n", "\n").split("\n\n");
+  const lines = head.split("\n");
+  const status = /^HTTP\/[\d.]+ (\d{3})/.exec(lines[0] ?? "");
+  const header = lines.find((line) =>
+    line.toLowerCase().startsWith("github-authentication-token-expiration:"),
+  );
+  let push: boolean | null = null;
+  try {
+    const body = JSON.parse(rest.join("\n\n")) as { permissions?: { push?: unknown } };
+    if (typeof body.permissions?.push === "boolean") push = body.permissions.push;
+  } catch {
+    // A body that is not JSON says nothing about the permission.
+  }
+  return {
+    status: status === null ? null : Number(status[1]),
+    expiration: header === undefined ? null : header.slice(header.indexOf(":") + 1).trim(),
+    push,
+  };
+}
+
+command("token", () => {
+  const repo = process.argv[2];
+  if (repo === undefined)
+    throw new ReleaseError("usage: bun scripts/release/token.ts <owner/repo>");
+  const token = process.env.MARKETPLACE_TOKEN ?? "";
+  // gh reads the token from its environment, so it is in no argument.
+  const answer =
+    token === ""
+      ? null
+      : run(["gh", "api", "-i", `repos/${repo}`], { env: { ...process.env, GH_TOKEN: token } });
+  const read =
+    answer === null ? { status: null, expiration: null, push: null } : parse(answer.stdout);
+  const state = decideToken({
+    token: token !== "",
+    ...read,
+    error: answer === null ? null : answer.stderr.trim(),
+    now: new Date(),
+    repo,
+  });
+  if (state.level === "error") throw new ReleaseError(state.message);
+  if (state.level === "warning") process.stdout.write(`::warning::${state.message}\n`);
+  summary(state.message);
+});
