+++ b/tests/unit/sharing-server-writes.test.ts
@@ -0,0 +1,205 @@
+// The sharing store's writes for a server operation (ADR 0027): the confirmation of a joined
+// server, the removal of its levels, and the change rows a server operation logs.
+import type { Database } from "bun:sqlite";
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { loadPolicy } from "../../src/sharing/policy.ts";
+import { wouldLeave } from "../../src/sharing/report.ts";
+import {
+  confirmServer,
+  counterOf,
+  levelRows,
+  logServerChange,
+  recentChanges,
+  removeServerLevels,
+  SETTINGS_SEEN_KEY,
+  settingsSeen,
+} from "../../src/sharing/store.ts";
+import { openDb, withWrite } from "../../src/store/db.ts";
+import { getMeta } from "../../src/store/meta.ts";
+
+let dir: string;
+let db: Database;
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "wizardingcode-mem-sharing-server-writes-"));
+  db = openDb({ dataDir: dir, busyTimeoutMs: 2000 });
+});
+afterEach(() => {
+  db.close();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+const NOW = 1_700_000_000_000;
+const ALIAS = "remote:github.com/acme/site";
+
+function project(id: number, alias = `${ALIAS}-${id}`): void {
+  db.run("INSERT INTO projects (id, key, name, created_at) VALUES (?, ?, ?, 1)", [
+    id,
+    `${alias}#${id}`,
+    `p${id}`,
+  ]);
+  db.run("INSERT INTO project_aliases (alias, project_id) VALUES (?, ?)", [alias, id]);
+}
+
+function server(
+  serverId: string,
+  url = `https://${serverId}.example.com`,
+  confirmedAt: number | null = null,
+): void {
+  db.run(
+    `INSERT INTO sharing_servers (server_id, url, name, device_id, device_alias, member_id,
+       member_name, role, contract, instance, confirmed_at, added_at)
+     VALUES (?, ?, ?, 'd', 'laptop', 'm', 'Ana', 'member', 1, 'i', ?, ?)`,
+    [serverId, url, `Team ${serverId}`, confirmedAt, NOW],
+  );
+}
+
+function level(projectId: number, destination: string, level: string): void {
+  db.run(
+    `INSERT INTO sharing_levels (project_id, destination, level, bound_alias, set_at, source)
+     VALUES (?, ?, ?, ?, ?, 'cli')`,
+    [projectId, destination, level, `${ALIAS}-${projectId}`, NOW],
+  );
+}
+
+function ledger(destination: string, uid: string): void {
+  db.run(
+    `INSERT INTO sharing_ledger (destination, item_kind, item_uid, direction, version, hash, policy_epoch, at)
+     VALUES (?, 'entry', ?, 'sent', 1, 'h', 1, ?)`,
+    [destination, uid, NOW],
+  );
+}
+
+const serverRow = (serverId: string) =>
+  db
+    .query<{ confirmed_at: number | null; roots: string; areas: string }, [string]>(
+      "SELECT confirmed_at, roots, areas FROM sharing_servers WHERE server_id = ?",
+    )
+    .get(serverId);
+
+const ledgerDestinations = () =>
+  db
+    .query<{ destination: string; item_uid: string }, []>(
+      "SELECT destination, item_uid FROM sharing_ledger ORDER BY destination, item_uid",
+    )
+    .all();
+
+describe("logServerChange and removeServerLevels", () => {
+  test("a server change is one row with the given what, old and new", () => {
+    logServerChange(db, "server:s1", "", "s1.example.com", NOW);
+    logServerChange(db, "server:s1", "mute", "", NOW + 1, "viewer");
+    expect(recentChanges(db, 5).reverse()).toMatchObject([
+      { at: NOW, source: "cli", what: "server:s1", old: "", new: "s1.example.com" },
+      { at: NOW + 1, source: "viewer", what: "server:s1", old: "mute", new: "" },
+    ]);
+  });
+
+  test("removeServerLevels deletes that server's levels only, logs each as the system's, and counts once", () => {
+    project(1);
+    project(2);
+    project(3);
+    level(1, "s1", "knowledge");
+    level(2, "s1", "all");
+    level(3, "s2", "knowledge");
+    const before = counterOf(db);
+    const removed = withWrite(db, () => removeServerLevels(db, "s1", NOW));
+    expect(removed).toEqual({ removed: [1, 2] });
+    expect(levelRows(db).map((row) => [row.projectId, row.destination])).toEqual([[3, "s2"]]);
+    expect(counterOf(db)).toBe(before + 1);
+    expect(recentChanges(db, 5).reverse()).toMatchObject([
+      { source: "system", what: "project:1@s1", old: "knowledge", new: "local" },
+      { source: "system", what: "project:2@s1", old: "all", new: "local" },
+    ]);
+    expect(removeServerLevels(db, "s1", NOW)).toEqual({ removed: [] });
+    expect(counterOf(db)).toBe(before + 1);
+  });
+});
+
+describe("confirmServer", () => {
+  test("the first server: confirmed, logged, the team rows moved, the lists copied, the baseline re-set", () => {
+    writeFileSync(
+      join(dir, "env"),
+      "WIZARDINGCODE_MEM_SHARE_ROOTS=workspace\nWIZARDINGCODE_MEM_SHARE_AREAS=workspace:sales,shared:ops\n",
+      { mode: 0o600 },
+    );
+    project(1);
+    project(2);
+    level(1, "team", "knowledge");
+    level(2, "team", "all");
+    ledger("team", "workspace:a");
+    ledger("team", "workspace:b");
+    server("s1", "https://one.example.com:8443");
+    const before = counterOf(db);
+    const outcome = confirmServer(db, dir, "s1", NOW + 5);
+    expect(outcome).toEqual({ first: true, moved: { levels: 2, ledger: 2 } });
+    expect(serverRow("s1")).toEqual({
+      confirmed_at: NOW + 5,
+      roots: "workspace",
+      areas: "shared:ops,workspace:sales",
+    });
+    expect(levelRows(db).map((row) => [row.projectId, row.destination, row.level])).toEqual([
+      [1, "s1", "knowledge"],
+      [2, "s1", "all"],
+    ]);
+    expect(ledgerDestinations()).toEqual([
+      { destination: "s1", item_uid: "workspace:a" },
+      { destination: "s1", item_uid: "workspace:b" },
+    ]);
+    expect(recentChanges(db, 1)[0]).toMatchObject({
+      at: NOW + 5,
+      source: "cli",
+      what: "server:s1",
+      old: "",
+      new: "one.example.com:8443",
+    });
+    expect(counterOf(db)).toBe(before + 1);
+    expect(settingsSeen(db)).toEqual({
+      roots: ["workspace"],
+      areas: ["shared:ops", "workspace:sales"],
+    });
+    // The loader reads the moved rows under the server, in force.
+    const policy = loadPolicy(db, dir, {}, "s1");
+    expect(policy.closed).toBe(false);
+    expect(policy.destinations.has("s1")).toBe(true);
+    expect(policy.levels.get("1@s1")?.level).toBe("knowledge");
+    expect(policy.levels.get("2@s1")?.level).toBe("all");
+    const report = wouldLeave(db, dir, {}, policy, { now: NOW, destination: "s1" });
+    expect(report.perProject).toEqual([
+      { id: 1, level: "knowledge", entries: 0, memories: 0 },
+      { id: 2, level: "all", entries: 0, memories: 0 },
+    ]);
+  });
+
+  test("with no team rows nothing moves; a second server moves nothing and is not the first", () => {
+    project(1);
+    server("s1");
+    db.run("DELETE FROM meta WHERE key = ?", [SETTINGS_SEEN_KEY]);
+    expect(confirmServer(db, dir, "s1", NOW)).toEqual({
+      first: true,
+      moved: { levels: 0, ledger: 0 },
+    });
+    expect(getMeta(db, SETTINGS_SEEN_KEY)).toBe(JSON.stringify({ roots: [], areas: [] }));
+    level(1, "team", "knowledge");
+    server("s2");
+    const before = counterOf(db);
+    expect(withWrite(db, () => confirmServer(db, dir, "s2", NOW + 1, "viewer"))).toEqual({
+      first: false,
+      moved: { levels: 0, ledger: 0 },
+    });
+    expect(serverRow("s2")?.confirmed_at).toBe(NOW + 1);
+    expect(levelRows(db).map((row) => row.destination)).toEqual(["team"]);
+    expect(counterOf(db)).toBe(before + 1);
+    expect(recentChanges(db, 1)[0]).toMatchObject({
+      what: "server:s2",
+      old: "",
+      new: "s2.example.com",
+      source: "viewer",
+    });
+  });
+
+  test("refuses a server that is not listed", () => {
+    expect(() => confirmServer(db, dir, "nope", NOW)).toThrow(/nope/);
+  });
+});
diff --git a/tests/unit/sync-boundary.test.ts b/tests/unit/sync-boundary.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/sync-boundary.test.ts
@@ -0,0 +1,197 @@
+// The sync's boundaries (ADR 0027): what the hooks may reach of it, what it may import, and
+// where each sharing table is named in SQL. Every rule is read from the sources, so a new
+// importer or a new statement in the wrong module fails here before it ships.
+import { describe, expect, test } from "bun:test";
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+
+const SRC = resolve(import.meta.dir, "../../src");
+
+/** Every `.ts` file under a folder of the sources, as `src/...` paths, sorted. */
+function filesUnder(folder: string): string[] {
+  const found: string[] = [];
+  const walk = (dir: string) => {
+    for (const name of readdirSync(dir)) {
+      const full = join(dir, name);
+      if (statSync(full).isDirectory()) walk(full);
+      else if (name.endsWith(".ts")) found.push(`src/${relative(SRC, full).split("\\").join("/")}`);
+    }
+  };
+  walk(join(SRC, folder.replace(/^src\/?/, "")));
+  return found.sort();
+}
+
+const sourceOf = (file: string): string => readFileSync(join(SRC, file.slice(4)), "utf8");
+
+/** The import specifiers of a module, as written: static, dynamic and `require`. */
+function importsOf(source: string): string[] {
+  return [
+    ...source.matchAll(/from\s+"([^"]+)"/g),
+    ...source.matchAll(/\bimport\(\s*"([^"]+)"\s*\)/g),
+    ...source.matchAll(/\brequire\(\s*"([^"]+)"\s*\)/g),
+  ].map((match) => match[1] as string);
+}
+
+/** The `src/...` path a relative specifier resolves to; null for a package or a non-`.ts` file. */
+function resolveSpec(from: string, spec: string): string | null {
+  if (!spec.startsWith(".") || !spec.endsWith(".ts")) return null;
+  const target = resolve(SRC, dirname(from.slice(4)), spec);
+  return `src/${relative(SRC, target).split("\\").join("/")}`;
+}
+
+/** The files a module imports directly. */
+function directImports(file: string): string[] {
+  return importsOf(sourceOf(file))
+    .map((spec) => resolveSpec(file, spec))
+    .filter((target): target is string => target !== null);
+}
+
+/** Every file reachable from one through its imports, itself excluded. */
+function reachable(entry: string): Set<string> {
+  const seen = new Set<string>();
+  const queue = [entry];
+  while (queue.length > 0) {
+    const file = queue.shift() as string;
+    for (const target of directImports(file)) {
+      if (seen.has(target)) continue;
+      seen.add(target);
+      queue.push(target);
+    }
+  }
+  seen.delete(entry);
+  return seen;
+}
+
+const under =
+  (folder: string) =>
+  (file: string): boolean =>
+    file.startsWith(`${folder}/`);
+
+/** `file: target` for every import of a file of `folder` into `where`, kept when `allowed` says no. */
+function importsInto(
+  folder: string,
+  where: (target: string) => boolean,
+  allowed: (file: string, target: string) => boolean = () => false,
+): string[] {
+  const found: string[] = [];
+  for (const file of filesUnder(folder)) {
+    for (const target of directImports(file)) {
+      if (where(target) && !allowed(file, target)) found.push(`${file}: ${target}`);
+    }
+  }
+  return found;
+}
+
+describe("the hooks", () => {
+  test("hook.ts reaches spawn.ts and nothing else of src/sync; handle.ts reaches nothing of it", () => {
+    const fromHook = [...reachable("src/cli/commands/hook.ts")].filter(under("src/sync")).sort();
+    expect(fromHook).toEqual(["src/sync/spawn.ts"]);
+    expect([...reachable("src/hooks/handle.ts")].filter(under("src/sync"))).toEqual([]);
+  });
+
+  test("spawn.ts imports no other module of src/sync", () => {
+    expect(directImports("src/sync/spawn.ts").filter(under("src/sync"))).toEqual([]);
+  });
+});
+
+describe("the modules", () => {
+  test("src/sync imports nothing of src/team but contract.ts, and src/team nothing of src/sync", () => {
+    expect(
+      importsInto(
+        "src/sync",
+        under("src/team"),
+        (_file, target) => target === "src/team/contract.ts",
+      ),
+    ).toEqual([]);
+    expect(importsInto("src/team", under("src/sync"))).toEqual([]);
+  });
+
+  test("the knowledge module and retrieval import nothing of src/sync or src/sharing", () => {
+    const forbidden = (target: string) => under("src/sync")(target) || under("src/sharing")(target);
+    expect(importsInto("src/modules/knowledge", forbidden)).toEqual([]);
+    expect(importsInto("src/retrieve", forbidden)).toEqual([]);
+  });
+
+  test("src/sync and src/backup never import each other", () => {
+    expect(importsInto("src/sync", under("src/backup"))).toEqual([]);
+    expect(importsInto("src/backup", under("src/sync"))).toEqual([]);
+  });
+});
+
+describe("the sharing tables", () => {
+  const LEDGER = [
+    "sharing_ledger",
+    "sharing_sent_hashes",
+    "sharing_refusals",
+    "sharing_conflicts",
+    "sharing_pending_rows",
+    "sharing_unbound",
+    "sharing_received_memories",
+  ];
+  /** The readers that reach the tables by SQL of their own, importing nothing of the sync. */
+  const READERS = [
+    "src/modules/knowledge/index-store.ts",
+    "src/modules/knowledge/contribute.ts",
+    "src/retrieve/received.ts",
+  ];
+  const BACKUP = "src/backup/backup.ts";
+  const sharing = under("src/sharing");
+  const ledgerAllowed = (file: string) =>
+    file === "src/sync/ledger.ts" ||
+    sharing(file) ||
+    file === BACKUP ||
+    file === "src/store/memories.ts" ||
+    READERS.includes(file);
+  const serversAllowed = (file: string) =>
+    ledgerAllowed(file) ||
+    ["src/sync/servers.ts", "src/sync/state.ts", "src/sync/spawn.ts"].includes(file);
+  const levelsAllowed = (file: string) =>
+    sharing(file) ||
+    file === BACKUP ||
+    file === "src/modules/knowledge/index-store.ts" ||
+    file === "src/retrieve/received.ts";
+  const changesAllowed = (file: string) => sharing(file) || file === BACKUP;
+  const RULES: [string, (file: string) => boolean][] = [
+    ...LEDGER.map((table): [string, (file: string) => boolean] => [table, ledgerAllowed]),
+    ["sharing_servers", serversAllowed],
+    ["sharing_muted_members", serversAllowed],
+    ["sharing_levels", levelsAllowed],
+    ["sharing_changes", changesAllowed],
+  ];
+  const names = (source: string, table: string) => new RegExp(`\\b${table}\\b`).test(source);
+
+  test("each table is named only where the design puts it", () => {
+    const offenders: string[] = [];
+    for (const file of filesUnder("src")) {
+      const source = sourceOf(file);
+      for (const [table, allowed] of RULES) {
+        if (names(source, table) && !allowed(file)) offenders.push(`${file}: ${table}`);
+      }
+    }
+    expect(offenders).toEqual([]);
+  });
+
+  test("status, doctor, the viewer, join and the knowledge tools name no sharing table", () => {
+    const quiet = [
+      "src/status/report.ts",
+      "src/doctor/checks.ts",
+      "src/ui/server.ts",
+      "src/ui/api.ts",
+      "src/sync/join.ts",
+      "src/modules/knowledge/tools.ts",
+    ];
+    for (const file of quiet) {
+      const source = sourceOf(file);
+      const named = RULES.map(([table]) => table).filter((table) => names(source, table));
+      expect({ file, named }).toEqual({ file, named: [] });
+    }
+  });
+
+  test("the ledger module and the server module exist and import nothing of the hooks' side", () => {
+    for (const file of ["src/sync/ledger.ts", "src/sync/servers.ts", "src/sync/state.ts"]) {
+      expect(filesUnder("src/sync")).toContain(file);
+      expect(directImports(file).filter(under("src/cli"))).toEqual([]);
+      expect(directImports(file).filter(under("src/hooks"))).toEqual([]);
+    }
+  });
+});
