+-- Entries received from a team server (ADR 0027): one row per received entry, a copy of the
+-- server's current revision kept apart from the person's repositories. Searchable through
+-- knowledge_fts under the reserved repo id 0, with entry_id '<serverId>|<uid>'.
+CREATE TABLE knowledge_received (
+  server_id TEXT NOT NULL, uid TEXT NOT NULL, scope TEXT NOT NULL, remote_alias TEXT,
+  project_id INTEGER NOT NULL DEFAULT 0, member_id TEXT NOT NULL, member_name TEXT NOT NULL,
+  id TEXT NOT NULL, slug TEXT NOT NULL, path TEXT NOT NULL, title TEXT NOT NULL, kind TEXT NOT NULL,
+  area TEXT NOT NULL, context TEXT NOT NULL DEFAULT '', subject TEXT NOT NULL DEFAULT '',
+  status TEXT NOT NULL, author TEXT NOT NULL, version INTEGER NOT NULL, body TEXT NOT NULL,
+  hash TEXT NOT NULL, revision INTEGER NOT NULL, received_at INTEGER NOT NULL, fts_rowid INTEGER,
+  PRIMARY KEY (server_id, uid)) WITHOUT ROWID;
+CREATE INDEX knowledge_received_project ON knowledge_received(project_id, server_id);
+CREATE INDEX knowledge_received_entry ON knowledge_received(id);
+-- The received reads: a search row joins its received row by fts_rowid, and an own entry with
+-- the same id hides a received copy (knowledge_entries is keyed by repository, so its id alone
+-- gets an index here).
+CREATE INDEX knowledge_received_fts ON knowledge_received(fts_rowid);
+CREATE INDEX knowledge_entries_id ON knowledge_entries(id);
diff --git a/src/modules/knowledge/received-ref.ts b/src/modules/knowledge/received-ref.ts
new file mode 100644
--- /dev/null
+++ b/src/modules/knowledge/received-ref.ts
@@ -0,0 +1,59 @@
+// A teammate's entry as the agents and the person name it (ADR 0027): `<server>:<slug>--<8 hex>`.
+// One place for the reference's grammar, its rendering from a hit, the provenance line and its
+// resolution to the received row, so the MCP tools, the hook's lines and the CLI agree. A leaf
+// of the module: it reads the index and the agent-safe names, nothing heavier, since the hook
+// imports it.
+import { agentName } from "../../core/agent-name.ts";
+import type { Db } from "../../store/db.ts";
+import { type Hit, type ReceivedScope, receivedByFile, serverByName } from "./index-store.ts";
+
+/** A received entry's reference: the server's name or id, then the file's name. */
+export const RECEIVED_REF = /^([^:/\s]{1,80}):([a-z0-9][a-z0-9-]{0,79})--([0-9a-f]{8})$/;
+/** The same with a name that holds a colon: never resolved, answered with the id to use. */
+const COLON_NAME_REF = /^(.+:.+):([a-z0-9][a-z0-9-]{0,79})--([0-9a-f]{8})$/;
+
+/** `from <member> via <server>`, through `agentName`; `(another device)` for this member's own. */
+export function provenanceOf(hit: Pick<Hit, "received" | "revisedBy">): string {
+  if (hit.received !== undefined) {
+    const who = agentName(hit.received.memberName);
+    const where = agentName(hit.received.serverName);
+    return `from ${who}${hit.received.ownDevice ? " (another device)" : ""} via ${where}`;
+  }
+  if (hit.revisedBy !== undefined) {
+    return `revised by ${agentName(hit.revisedBy.memberName)} via ${agentName(hit.revisedBy.serverName)}${hit.revisedBy.pinHeld ? " (pin held)" : ""}`;
+  }
+  return "";
+}
+
+/**
+ * Where a hit is fetched from: `scope/slug`, or `<server>:<slug>--<8 hex>` for a received one,
+ * the server by its name, or by its id when the name holds a colon (which no reference can carry).
+ */
+export function refOfHit(hit: Pick<Hit, "scope" | "slug" | "received">): string {
+  if (hit.received === undefined) return `${hit.scope}/${hit.slug}`;
+  const name = agentName(hit.received.serverName);
+  const server = name === "" || name.includes(":") ? hit.received.serverId : name;
+  return `${server}:${hit.slug}--${hit.received.id.slice(0, 8)}`;
+}
+
+/**
+ * A received reference's entry, or the sentence that says why it was not found: no such
+ * server, a name two servers share (the ids to use), a name with a colon (the id to use),
+ * or no such entry in the scope the reader sees.
+ */
+export function resolveReceivedRef(db: Db, ref: string, scope: ReceivedScope): Hit | string {
+  const match = RECEIVED_REF.exec(ref);
+  if (match === null) {
+    const colon = COLON_NAME_REF.exec(ref);
+    const named = colon === null ? null : serverByName(db, colon[1] as string);
+    if (named !== null && !("ambiguous" in named))
+      return `Not found: ${ref} (the server's name holds a colon; use its id: ${named.serverId}:${colon?.[2]}--${colon?.[3]})`;
+    return `Not found: ${ref}`;
+  }
+  const [, server, slug, hex8] = match as unknown as [string, string, string, string];
+  const found = serverByName(db, server);
+  if (found === null) return `Not found: ${ref} (${server}: no such server)`;
+  if ("ambiguous" in found)
+    return `Not found: ${ref} (two servers are named ${server}: use the id, one of ${found.ambiguous.join(", ")})`;
+  return receivedByFile(db, found.serverId, slug, hex8, scope) ?? `Not found: ${ref}`;
+}
diff --git a/src/retrieve/received.ts b/src/retrieve/received.ts
new file mode 100644
--- /dev/null
+++ b/src/retrieve/received.ts
@@ -0,0 +1,63 @@
+// Received memories in retrieval (ADR 0027): which of a project's rows are teammates' copies,
+// from which server, and whether an agent may see them now, by the retrieval's own SQL over
+// the sharing tables. Nothing is read when the tables are absent, so a store that never ran
+// the sharing schema retrieves as before, byte for byte.
+import { agentName } from "../core/agent-name.ts";
+import type { Db } from "../store/db.ts";
+
+/** The share of a brief's budget, and of a prompt's notes, received memories may take, after the person's own. */
+export const RECEIVED_SHARE = 1 / 3;
+
+export interface ReceivedMark {
+  /** The server's name, for the `(team: <name>)` marker; empty when the server is gone. */
+  server: string;
+  /** Listed, confirmed and unmuted server, unmuted member, and the project still bound to it. */
+  visible: boolean;
+}
+
+const tablesKnown = new WeakMap<Db, boolean>();
+function hasTables(db: Db): boolean {
+  let known = tablesKnown.get(db);
+  if (known === undefined) {
+    known =
+      (db
+        .query<{ n: number }, []>(
+          `SELECT count(*) AS n FROM sqlite_master
+            WHERE name IN ('sharing_received_memories', 'sharing_servers', 'sharing_muted_members', 'sharing_levels')`,
+        )
+        .get()?.n ?? 0) === 4;
+    tablesKnown.set(db, known);
+  }
+  return known;
+}
+
+/**
+ * The received memories of a project, by memory id: a row of a muted server or member, of a
+ * server with no row, or of a project no longer bound to the server reads as not visible and
+ * is left out of every brief and prompt. Empty without the sharing schema.
+ */
+export function receivedMarks(db: Db, projectId: number): Map<number, ReceivedMark> {
+  if (!hasTables(db)) return new Map();
+  const rows = db
+    .query<{ id: number; server: string; visible: number }, [number]>(
+      `SELECT r.memory_id AS id, COALESCE(s.name, '') AS server,
+              (s.server_id IS NOT NULL AND s.confirmed_at IS NOT NULL AND s.muted = 0
+               AND NOT EXISTS (SELECT 1 FROM sharing_muted_members mm
+                                WHERE mm.server_id = r.server_id AND mm.member_id = r.member_id)
+               AND EXISTS (SELECT 1 FROM sharing_levels l
+                            JOIN project_aliases a ON a.project_id = l.project_id AND a.alias = l.bound_alias
+                           WHERE l.destination = r.server_id AND l.level != 'local'
+                             AND l.project_id = m.project_id)) AS visible
+         FROM sharing_received_memories r
+         JOIN memories m ON m.id = r.memory_id
+         LEFT JOIN sharing_servers s ON s.server_id = r.server_id
+        WHERE m.project_id = ?`,
+    )
+    .all(projectId);
+  return new Map(rows.map((row) => [row.id, { server: row.server, visible: row.visible === 1 }]));
+}
+
+/** The origin a received note carries: `team: <server name>`, through the agent-safe rendering. */
+export function teamOrigin(mark: ReceivedMark): string {
+  return `team: ${agentName(mark.server)}`;
+}
diff --git a/src/sharing/migrations/0002_sharing_servers.sql b/src/sharing/migrations/0002_sharing_servers.sql
new file mode 100644
--- /dev/null
+++ b/src/sharing/migrations/0002_sharing_servers.sql
@@ -0,0 +1,72 @@
+-- The sync client (ADR 0027): the servers this machine joined, what it set aside, and what
+-- the ledger needs per server. Add-only: no core table is changed, but the core `memories`
+-- table gets two indexes of this namespace (at the end of this file), and `user_version` stays.
+-- The unique partial index over sharing_levels is created by the migration's run, after it
+-- resolves a project with more than one row above Nothing; it is not in this file.
+
+CREATE TABLE sharing_servers (
+  server_id TEXT PRIMARY KEY, url TEXT NOT NULL, name TEXT NOT NULL,
+  device_id TEXT NOT NULL, device_alias TEXT NOT NULL, member_id TEXT NOT NULL,
+  member_name TEXT NOT NULL, role TEXT NOT NULL, contract INTEGER NOT NULL,
+  instance TEXT NOT NULL, confirmed_at INTEGER, cursors TEXT NOT NULL DEFAULT '{}',
+  roots TEXT NOT NULL DEFAULT '', areas TEXT NOT NULL DEFAULT '',
+  muted INTEGER NOT NULL DEFAULT 0, stopped TEXT, snapshot_due INTEGER NOT NULL DEFAULT 1,
+  last_sweep_at INTEGER, last_sweep_max_id INTEGER NOT NULL DEFAULT 0,
+  last_sweep_epoch INTEGER, last_sweep_generation TEXT,
+  added_at INTEGER NOT NULL, last_push_at INTEGER, last_push_ok_at INTEGER,
+  last_pull_at INTEGER, last_pull_ok_at INTEGER, backlog INTEGER NOT NULL DEFAULT 0,
+  retry_at INTEGER, failures INTEGER NOT NULL DEFAULT 0,
+  last_error TEXT, last_error_at INTEGER, last_request_id TEXT
+) WITHOUT ROWID;
+
+CREATE TABLE sharing_muted_members (server_id TEXT NOT NULL, member_id TEXT NOT NULL,
+  PRIMARY KEY (server_id, member_id)) WITHOUT ROWID;
+
+-- A feed row set aside after ten failed applies, with its payload, so a retry needs no server.
+CREATE TABLE sharing_pending_rows (server_id TEXT NOT NULL, seq INTEGER NOT NULL,
+  uid TEXT NOT NULL, kind TEXT NOT NULL, payload TEXT NOT NULL, reason TEXT NOT NULL,
+  tries INTEGER NOT NULL, at INTEGER NOT NULL, PRIMARY KEY (server_id, seq)) WITHOUT ROWID;
+
+-- The local fingerprint when the row was written (an entry's index hash; a memory's hash at
+-- the last send or stale), the server instance, and why the row is what it is.
+ALTER TABLE sharing_ledger ADD COLUMN local_hash TEXT NOT NULL DEFAULT '';
+ALTER TABLE sharing_ledger ADD COLUMN instance TEXT NOT NULL DEFAULT '';
+ALTER TABLE sharing_ledger ADD COLUMN reason TEXT NOT NULL DEFAULT '';
+
+CREATE TABLE sharing_sent_hashes (destination TEXT NOT NULL, item_kind TEXT NOT NULL,
+  item_uid TEXT NOT NULL, hash TEXT NOT NULL, revision INTEGER NOT NULL, at INTEGER NOT NULL,
+  PRIMARY KEY (destination, item_kind, item_uid, hash)) WITHOUT ROWID;
+
+-- A refusal is never re-sent for its hash; a purged key is reason 'purged' with hash '*'.
+CREATE TABLE sharing_refusals (destination TEXT NOT NULL, item_kind TEXT NOT NULL,
+  item_uid TEXT NOT NULL, hash TEXT NOT NULL, reason TEXT NOT NULL, rule TEXT, at INTEGER NOT NULL,
+  PRIMARY KEY (destination, item_kind, item_uid, hash)) WITHOUT ROWID;
+
+-- The aliases the person unbound, waiting for the reconcile before a pull's first page.
+CREATE TABLE sharing_unbound (server_id TEXT NOT NULL, alias TEXT NOT NULL, at INTEGER NOT NULL,
+  PRIMARY KEY (server_id, alias)) WITHOUT ROWID;
+
+-- The person's text when a teammate's revision was applied over it, whatever happens to the
+-- proposal that carries it.
+CREATE TABLE sharing_conflicts (destination TEXT NOT NULL, item_uid TEXT NOT NULL, at INTEGER NOT NULL,
+  local_text TEXT NOT NULL, local_version INTEGER NOT NULL, local_hash TEXT NOT NULL,
+  server_revision INTEGER NOT NULL, server_hash TEXT NOT NULL, proposal_id TEXT,
+  resolved_at INTEGER, PRIMARY KEY (destination, item_uid, at)) WITHOUT ROWID;
+
+-- The provenance of a received memory, with the kind, importance and status as sent.
+CREATE TABLE sharing_received_memories (memory_id INTEGER PRIMARY KEY, server_id TEXT NOT NULL,
+  remote_uid TEXT NOT NULL, member_id TEXT NOT NULL, member_name TEXT NOT NULL,
+  revision INTEGER NOT NULL, hash TEXT NOT NULL,
+  remote_kind TEXT NOT NULL, remote_importance REAL NOT NULL, remote_status TEXT NOT NULL);
+CREATE UNIQUE INDEX sharing_received_memories_uid ON sharing_received_memories(server_id, remote_uid);
+
+-- The sweep's tick reads the memories changed since its last read through this index, and the
+-- rows inserted since through the rowid, so a quiet tick reads no memory row.
+CREATE INDEX sharing_memories_updated ON memories(updated_at, id);
+-- A received memory is deleted (a tombstone, a removal, a snapshot's comparison) with every
+-- superseded_by that pointed at it set back: that read gets its index, instead of a scan of
+-- the memories per deletion inside the write transaction.
+CREATE INDEX sharing_memories_superseded ON memories(superseded_by);
+-- The held-pin and the revised-by reads of the knowledge module look an own entry's applied row
+-- up by its local hash; the ledger's key leads with the destination.
+CREATE INDEX sharing_ledger_applied ON sharing_ledger(direction, item_kind, local_hash);
diff --git a/src/sync/client.ts b/src/sync/client.ts
new file mode 100644
--- /dev/null
+++ b/src/sync/client.ts
@@ -0,0 +1,281 @@
+// HTTP to one team server (ADR 0027): the contract header, the bearer token, a request id of
+// the contract's grammar on every request, a 3xx never followed, and every answer mapped to a
+// typed one, so the loop never reads a status code. The deadline runs on the injected timers.
+import { randomUUID } from "node:crypto";
+import {
+  CONTRACT,
+  CONTRACT_HEADER,
+  isLoopback,
+  type JoinAnswer,
+  type MeAnswer,
+  type PullPageShape,
+  type PushItemShape,
+  type PushResultShape,
+  REQUEST_ID_HEADER,
+} from "../team/contract.ts";
+import type { SyncContext } from "./context.ts";
+
+// --- The URL ----------------------------------------------------------------------------------
+
+export class ServerUrlError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "ServerUrlError";
+  }
+}
+
+/**
+ * A server URL as the client accepts it: an origin (no path, query or fragment), with no
+ * credentials, `https://` unless the host is loopback. The origin is what is stored.
+ */
+export function checkServerUrl(raw: string): string {
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    throw new ServerUrlError(`${raw} is not a URL`);
+  }
+  if (url.username !== "" || url.password !== "")
+    throw new ServerUrlError("the server URL carries credentials; the token is the device's");
+  if (url.protocol !== "https:" && !(url.protocol === "http:" && isLoopback(url.hostname)))
+    throw new ServerUrlError("the server URL needs https:// (http:// only for a loopback host)");
+  if (url.search !== "" || url.hash !== "")
+    throw new ServerUrlError("the server URL is an origin, without a query or a fragment");
+  if (url.pathname !== "/" && url.pathname !== "")
+    throw new ServerUrlError("the server URL is an origin, without a path");
+  return url.origin;
+}
+
+// --- The answers --------------------------------------------------------------------------------
+
+export type ClientFailure =
+  | { kind: "unauthorized"; status: 401; error: string; instance: string | null }
+  | { kind: "disabled"; status: 403; error: string }
+  | { kind: "forbidden"; status: 403; error: string }
+  | { kind: "contract"; status: 409; accepted: number[] }
+  | { kind: "gone"; status: 410; error: string; instance: string | null }
+  | { kind: "tooLarge"; status: 413 }
+  | { kind: "rate"; status: 429; retryAfterMs: number }
+  | { kind: "refused"; status: number; error: string }
+  | { kind: "server"; status: number; error: string }
+  | { kind: "redirect"; status: number | null }
+  | { kind: "network"; error: string }
+  | { kind: "deadline" }
+  | { kind: "aborted" };
+
+export type ClientAnswer<T> =
+  | { ok: true; status: number; body: T; requestId: string }
+  | ({ ok: false; requestId: string | null } & ClientFailure);
+
+export type ClientFailed = Extract<ClientAnswer<never>, { ok: false }>;
+
+/** A pull as the client makes it: the server's page size is its own (`pullItems`, `pullBytes`). */
+export interface PullInput {
+  since: number;
+  scope: "all" | "project";
+  projects?: readonly string[];
+  wait?: number;
+}
+
+export interface RequestOptions {
+  /** The caller's stop: the request ends as `aborted`. */
+  signal?: AbortSignal;
+  /** How long the whole request may take, on the context's timers; past it, `deadline`. */
+  deadlineMs?: number;
+}
+
+/** A pull not held waits this long for the whole answer; a held one adds the server's wait. */
+export const DEFAULT_DEADLINE_MS = 30_000;
+/** A rate limit the server names no wait for. */
+const RATE_DEFAULT_MS = 10_000;
+
+const requestId = (): string => randomUUID().replaceAll("-", "");
+
+function retryAfterMs(response: Response, body: Record<string, unknown>): number {
+  const header = Number(response.headers.get("retry-after"));
+  if (Number.isFinite(header) && header > 0) return header * 1000;
+  const field = body.retryAfterSec;
+  return typeof field === "number" && field > 0 ? field * 1000 : RATE_DEFAULT_MS;
+}
+
+const text = (body: Record<string, unknown>, key: string): string | null =>
+  typeof body[key] === "string" ? (body[key] as string) : null;
+
+/** The failure a status and a body mean to the client. */
+function failureOf(response: Response, body: Record<string, unknown>): ClientFailure {
+  const status = response.status;
+  const error = text(body, "error") ?? `status ${status}`;
+  const instance = text(body, "instance");
+  if (status >= 300 && status < 400) return { kind: "redirect", status };
+  if (status === 401) return { kind: "unauthorized", status, error, instance };
+  if (status === 403)
+    return error === "member disabled"
+      ? { kind: "disabled", status, error }
+      : { kind: "forbidden", status, error };
+  if (status === 409) {
+    const accepted = Array.isArray(body.accepted)
+      ? body.accepted.filter((value): value is number => typeof value === "number")
+      : [];
+    return { kind: "contract", status, accepted };
+  }
+  if (status === 410) return { kind: "gone", status, error, instance };
+  if (status === 413) return { kind: "tooLarge", status };
+  if (status === 429) return { kind: "rate", status, retryAfterMs: retryAfterMs(response, body) };
+  if (status >= 500) return { kind: "server", status, error };
+  return { kind: "refused", status, error };
+}
+
+// --- The client --------------------------------------------------------------------------------
+
+export interface ClientOptions {
+  url: string;
+  /** Null before a join: the join sends none. */
+  token: string | null;
+  /** The contract named in the header; the binary's unless a test says otherwise. */
+  contract?: number;
+}
+
+/** One server, one token. Every request goes through `request`, which never throws. */
+export class SyncClient {
+  private readonly url: string;
+  private readonly token: string | null;
+  private readonly contract: number;
+
+  constructor(
+    private readonly ctx: SyncContext,
+    options: ClientOptions,
+  ) {
+    this.url = options.url.replace(/\/+$/, "");
+    this.token = options.token;
+    this.contract = options.contract ?? CONTRACT;
+  }
+
+  join(code: string, label: string, name?: string): Promise<ClientAnswer<JoinAnswer>> {
+    return this.request<JoinAnswer>(
+      "POST",
+      "/v1/join",
+      { code, label, ...(name === undefined ? {} : { name }) },
+      {},
+      { token: false },
+    );
+  }
+
+  me(): Promise<ClientAnswer<MeAnswer>> {
+    return this.request<MeAnswer>("GET", "/v1/me", undefined, {});
+  }
+
+  /** The items in the spec's order; a withdraw is an item of `op: "withdraw"`. A push is never held, so it takes the default deadline. */
+  push(
+    items: PushItemShape[],
+    epoch: number,
+  ): Promise<ClientAnswer<{ results: PushResultShape[] }>> {
+    return this.request<{ results: PushResultShape[] }>("POST", "/v1/push", { items, epoch }, {});
+  }
+
+  pull(input: PullInput, options: RequestOptions = {}): Promise<ClientAnswer<PullPageShape>> {
+    const params = new URLSearchParams();
+    params.set("since", String(input.since));
+    params.set("scope", input.scope);
+    if (input.projects !== undefined && input.projects.length > 0)
+      params.set("projects", input.projects.join(","));
+    if (input.wait !== undefined && input.wait > 0) params.set("wait", String(input.wait));
+    return this.request<PullPageShape>("GET", `/v1/pull?${params.toString()}`, undefined, options);
+  }
+
+  /**
+   * One request: the headers, the deadline on the context's timers, the caller's signal, a
+   * 3xx refused, the body read as JSON, the status mapped. Never throws.
+   */
+  private async request<T>(
+    method: string,
+    path: string,
+    body: unknown,
+    options: RequestOptions,
+    extra: { token?: boolean } = {},
+  ): Promise<ClientAnswer<T>> {
+    const id = requestId();
+    const headers: Record<string, string> = {
+      [CONTRACT_HEADER]: String(this.contract),
+      [REQUEST_ID_HEADER]: id,
+      accept: "application/json",
+    };
+    if (extra.token !== false && this.token !== null)
+      headers.authorization = `Bearer ${this.token}`;
+    if (body !== undefined) headers["content-type"] = "application/json";
+
+    const controller = new AbortController();
+    let why: "deadline" | "aborted" | null = null;
+    const onAbort = () => {
+      why = "aborted";
+      controller.abort();
+    };
+    if (options.signal?.aborted) return { ok: false, requestId: null, kind: "aborted" };
+    options.signal?.addEventListener("abort", onAbort, { once: true });
+    const timer = this.ctx.timers.setTimeout(() => {
+      why = "deadline";
+      controller.abort();
+    }, options.deadlineMs ?? DEFAULT_DEADLINE_MS);
+
+    let response: Response;
+    try {
+      response = await this.ctx.fetch(`${this.url}${path}`, {
+        method,
+        headers,
+        ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+        redirect: "error",
+        signal: controller.signal,
+      });
+    } catch (error) {
+      this.ctx.timers.clearTimeout(timer);
+      options.signal?.removeEventListener("abort", onAbort);
+      if (why !== null) return { ok: false, requestId: null, kind: why };
+      const code = (error as { code?: unknown }).code;
+      const message = error instanceof Error ? error.message : String(error);
+      if (code === "UnexpectedRedirect" || /redirect/i.test(message))
+        return { ok: false, requestId: null, kind: "redirect", status: null };
+      return { ok: false, requestId: null, kind: "network", error: message };
+    }
+    let raw = "";
+    try {
+      raw = await response.text();
+    } catch (error) {
+      this.ctx.timers.clearTimeout(timer);
+      options.signal?.removeEventListener("abort", onAbort);
+      if (why !== null) return { ok: false, requestId: null, kind: why };
+      const message = error instanceof Error ? error.message : String(error);
+      return { ok: false, requestId: null, kind: "network", error: message };
+    }
+    this.ctx.timers.clearTimeout(timer);
+    options.signal?.removeEventListener("abort", onAbort);
+    const answered = response.headers.get(REQUEST_ID_HEADER) ?? id;
+
+    let parsed: unknown = null;
+    try {
+      parsed = raw === "" ? null : JSON.parse(raw);
+    } catch {
+      return {
+        ok: false,
+        requestId: answered,
+        kind: "server",
+        status: response.status,
+        error: "the answer is not JSON",
+      };
+    }
+    const record =
+      typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+        ? (parsed as Record<string, unknown>)
+        : {};
+    if (response.status >= 200 && response.status < 300) {
+      if (parsed === null || typeof parsed !== "object")
+        return {
+          ok: false,
+          requestId: answered,
+          kind: "server",
+          status: response.status,
+          error: "the answer is not JSON",
+        };
+      return { ok: true, status: response.status, body: parsed as T, requestId: answered };
+    }
+    return { ok: false, requestId: answered, ...failureOf(response, record) };
+  }
+}
diff --git a/src/sync/conflicts.ts b/src/sync/conflicts.ts
new file mode 100644
--- /dev/null
+++ b/src/sync/conflicts.ts
@@ -0,0 +1,178 @@
+// A teammate's revision of an own entry (ADR 0027, D-2 and D-8): applied to the file verbatim
+// but for the local pin, the ledger moved to it, and, when a local edit was in flight, the
+// person's text kept as a proposal with a conflicts row. The rollback test lives in the
+// outbound side's answers; what reaches here is a revision the server holds above ours.
+import { join } from "node:path";
+import { agentName } from "../core/agent-name.ts";
+import { parseEntry } from "../modules/knowledge/entry.ts";
+import { KnowledgeError } from "../modules/knowledge/errors.ts";
+import { hashOf, openRepo, readRegularFile, statusOf } from "../modules/knowledge/repo.ts";
+import { applyRevision, proposeConflict } from "../modules/knowledge/store.ts";
+import { openStore } from "../modules/knowledge/store-open.ts";
+import type { KnowledgeStore, ScopeRef, SyncWriter } from "../modules/knowledge/types.ts";
+import { parseEntryUid } from "../team/contract.ts";
+import type { SyncContext } from "./context.ts";
+import { closeConflict, openConflicts, sentRow, writeApplied, writeConflict } from "./ledger.ts";
+import { logError } from "./log.ts";
+import type { ServerRow } from "./servers.ts";
+
+export { closeConflict };
+
+/** What the pull hands here: the server's revision of an own entry, its text whole. */
+export interface RemoteRevision {
+  uid: string;
+  revision: number;
+  hash: string;
+  /** `frontmatter + body` as the server holds it. */
+  text: string;
+  member: { id: string; name: string };
+}
+
+export type ApplyOutcome =
+  | { kind: "applied"; version: number; hash: string }
+  | { kind: "conflict"; version: number; hash: string; proposalId: string }
+  | {
+      kind: "skipped";
+      why: "not-own" | "echo" | "unknown" | "dirty" | "locked";
+    };
+
+/** The enabled project an alias names, the lowest id when two share it. */
+export function projectByAlias(ctx: SyncContext, alias: string): number | null {
+  return (
+    ctx.db
+      .query<{ project_id: number }, [string]>(
+        `SELECT a.project_id FROM project_aliases a JOIN projects p ON p.id = a.project_id
+          WHERE a.alias = ? AND p.disabled = 0 ORDER BY a.project_id LIMIT 1`,
+      )
+      .get(alias)?.project_id ?? null
+  );
+}
+
+/** The repository reference an entry uid names on this machine; null when none. */
+export function refOfUid(ctx: SyncContext, uid: string): ScopeRef | null {
+  const parsed = parseEntryUid(uid);
+  if (parsed === null) return null;
+  if (parsed.scope !== "project") return { scope: parsed.scope };
+  const projectId = projectByAlias(ctx, parsed.remoteAlias);
+  return projectId === null ? null : { scope: "project", projectId };
+}
+
+interface Indexed {
+  slug: string;
+  path: string;
+  hash: string;
+}
+
+function indexedEntry(ctx: SyncContext, repoId: number, uuid: string): Indexed | null {
+  return ctx.db
+    .query<Indexed, [number, string]>(
+      "SELECT slug, path, hash FROM knowledge_entries WHERE repo_id = ? AND id = ?",
+    )
+    .get(repoId, uuid);
+}
+
+/**
+ * Applies a teammate's revision to the person's own entry. Skipped when the uid is not an own
+ * item of the server (a received copy is the received store's), when it is an echo of what
+ * was sent, when the entry is unknown here, when its path is dirty (retried by the next pull)
+ * or when another write holds the repository. Otherwise the file takes the text verbatim but
+ * for the local `pinned` line, the `applied` row is written and the sent row moved, and, when
+ * the file's hash before the apply differed from the sent row's `local_hash` (a local edit in
+ * flight), the person's text becomes a proposal and a conflicts row keeps everything.
+ */
+export function applyOwnRevision(
+  ctx: SyncContext,
+  server: ServerRow,
+  remote: RemoteRevision,
+  knowledge?: KnowledgeStore,
+): ApplyOutcome {
+  const serverId = server.serverId;
+  const own = sentRow(ctx.db, serverId, "entry", remote.uid);
+  if (own === null) return { kind: "skipped", why: "not-own" };
+  if (own.hash === remote.hash && own.version === remote.revision)
+    return { kind: "skipped", why: "echo" };
+  const parsed = parseEntryUid(remote.uid);
+  const ref = refOfUid(ctx, remote.uid);
+  if (parsed === null || ref === null) return { kind: "skipped", why: "unknown" };
+  const store =
+    knowledge ??
+    openStore({ db: ctx.db, dataDir: ctx.dataDir, env: ctx.env, now: () => ctx.clock.now });
+  const repo = openRepo(store, ref);
+  if (repo === null) return { kind: "skipped", why: "unknown" };
+  const indexed = indexedEntry(ctx, repo.id, parsed.uuid);
+  if (indexed === null) return { kind: "skipped", why: "unknown" };
+  if (statusOf(store, repo, [indexed.path]).length > 0) return { kind: "skipped", why: "dirty" };
+  const bytes = readRegularFile(join(repo.path, ...indexed.path.split("/")));
+  if (bytes === null) return { kind: "skipped", why: "unknown" };
+  const localText = new TextDecoder().decode(bytes);
+  // The file's own hash, not the index's: an edit committed by hand before the index was
+  // refreshed is an edit in flight all the same.
+  const fileHash = hashOf(bytes);
+  const edited = own.localHash !== "" && own.localHash !== fileHash;
+  const writer: SyncWriter = {
+    kind: "sync",
+    serverId,
+    serverName: server.name,
+    member: remote.member,
+  };
+  let applied: { version: number; hash: string };
+  try {
+    applied = applyRevision(store, ref, parsed.uuid, remote.text, writer, {
+      uid: remote.uid,
+      revision: remote.revision,
+    });
+  } catch (error) {
+    if (error instanceof KnowledgeError && error.code === "locked")
+      return { kind: "skipped", why: "locked" };
+    throw error;
+  }
+  const at = ctx.clock.now;
+  writeApplied(ctx, serverId, remote.uid, {
+    revision: remote.revision,
+    hash: remote.hash,
+    localHash: applied.hash,
+    instance: server.instance,
+    at,
+    // The ledger keeps the reviser's name as the agents see it (the hook's marker reads it),
+    // the member id standing in for an empty one, as the git author does.
+    reason: agentName(remote.member.name) || remote.member.id,
+  });
+  if (!edited) return { kind: "applied", ...applied };
+  // The person's text, committed here and not yet sent, becomes a proposal on the new base.
+  const local = parseEntry(localText, indexed.slug, null);
+  let proposalId: string | null = null;
+  try {
+    proposalId = proposeConflict(store, ref, parsed.uuid, localText, writer, applied).id;
+  } catch (error) {
+    logError(ctx, serverId, "conflict", error);
+  }
+  writeConflict(ctx, serverId, remote.uid, {
+    at,
+    localText,
+    localVersion: local.version,
+    localHash: fileHash,
+    serverRevision: remote.revision,
+    serverHash: remote.hash,
+    proposalId,
+  });
+  if (proposalId === null) return { kind: "applied", ...applied };
+  return { kind: "conflict", ...applied, proposalId };
+}
+
+/**
+ * At the sync's start: every open conflicts row whose proposal is no longer open, or is
+ * gone, is closed, so a crash between the store's write and the close leaves no row open.
+ */
+export function closeOrphanConflicts(ctx: SyncContext, serverId?: string): number {
+  let closed = 0;
+  const now = ctx.clock.now;
+  for (const row of openConflicts(ctx.db, serverId)) {
+    if (row.proposalId === null) continue;
+    const state = ctx.db
+      .query<{ state: string }, [string]>("SELECT state FROM knowledge_proposals WHERE id = ?")
+      .get(row.proposalId)?.state;
+    if (state === "open") continue;
+    closed += closeConflict(ctx.db, row.proposalId, now);
+  }
+  return closed;
+}
