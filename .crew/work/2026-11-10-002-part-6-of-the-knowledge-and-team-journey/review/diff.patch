+          read = readSync(0, one, 0, 1, null);
+        } catch {
+          return null;
+        }
+        if (read === 0) return null;
+        const byte = one[0] as number;
+        if (byte === 3 || byte === 4) return null;
+        if (byte === 13 || byte === 10) return line;
+        if (byte === 127 || byte === 8) {
+          line = line.slice(0, -1);
+          continue;
+        }
+        if (byte >= 32 && line.length < SECRET_MAX) line += String.fromCharCode(byte);
+      }
