+  main: number;
+  mainAliases: string[];
+  extra: Record<string, number>;
+}
+
+export const EMPTY_CURSORS: Readonly<Cursors> = { main: 0, mainAliases: [], extra: {} };
+
+export interface ServerRow {
+  serverId: string;
+  url: string;
+  name: string;
+  deviceId: string;
+  deviceAlias: string;
+  memberId: string;
+  memberName: string;
+  role: string;
