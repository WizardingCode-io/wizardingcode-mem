+ * Whether this connection's store has the sharing v2 tables, asked of `sqlite_master` once per
+ * open: a store opened without the sharing schema (`openExisting` never migrates) has no server
+ * row and every reader here says so without touching a table.
+ */
+const schemaKnown = new WeakMap<Db, boolean>();
+export function hasServerTables(db: Db): boolean {
+  let known = schemaKnown.get(db);
+  if (known === undefined) {
+    known = hasTable(db, "sharing_servers");
+    schemaKnown.set(db, known);
+  }
+  return known;
+}
+
+/** Every server row, pending ones included, by id. */
+export function listServers(db: Db): ServerRow[] {
+  if (!hasServerTables(db)) return [];
+  return db
+    .query<RawRow, []>(`SELECT ${COLUMNS} FROM sharing_servers ORDER BY server_id`)
+    .all()
+    .map(rowOf);
+}
+
+/** The rows the sweep, the pull and the spawn work on: confirmed, by id. */
+export function confirmedServers(db: Db): ServerRow[] {
+  return listServers(db).filter((row) => row.confirmedAt !== null);
+}
+
+/** True when at least one server is confirmed. */
+export function serversConfigured(db: Db): boolean {
+  return confirmedServers(db).length > 0;
+}
+
+export function serverById(db: Db, serverId: string): ServerRow | null {
+  if (!hasServerTables(db)) return null;
+  const raw = db
+    .query<RawRow, [string]>(`SELECT ${COLUMNS} FROM sharing_servers WHERE server_id = ?`)
+    .get(serverId);
+  return raw === null ? null : rowOf(raw);
+}
+
+/** The host of a server's URL, what a person names it by. */
+export function hostOf(url: string): string {
+  try {
+    return new URL(url).host;
+  } catch {
+    return url;
+  }
+}
+
+/** A reference (a name or a host) that matches more than one server. */
+export class ServerRefAmbiguous extends Error {
+  constructor(
+    readonly ref: string,
+    readonly ids: string[],
+  ) {
+    super(
+      `\`${ref}\` names ${ids.length === 2 ? "two" : ids.length} servers: ${ids.join(", ")}; use the id`,
+    );
+    this.name = "ServerRefAmbiguous";
+  }
+}
+
+/**
+ * The server a command names: by id first (an id is unique), else by name or host. A name or
+ * host that matches more than one server is refused with the ids listed.
+ */
+export function findServer(db: Db, ref: string): ServerRow | null {
+  const byId = serverById(db, ref);
+  if (byId !== null) return byId;
+  const matches = listServers(db).filter((row) => row.name === ref || hostOf(row.url) === ref);
+  if (matches.length > 1)
+    throw new ServerRefAmbiguous(
+      ref,
+      matches.map((row) => row.serverId),
+    );
+  return matches[0] ?? null;
+}
+
+/** What a join gives, written as a pending row (or as the new device of a listed server). */
+export interface Device {
+  deviceId: string;
+  deviceAlias: string;
+  memberId: string;
+  memberName: string;
+  role: string;
+  contract: number;
+  instance: string;
+}
+
+export interface PendingServer extends Device {
+  serverId: string;
+  url: string;
+  name: string;
+  addedAt: number;
+}
+
+/**
+ * Writes the row of a server just joined, `confirmed_at` null, replacing a pending row of the
+ * same id (an `add` run again). A confirmed row is never replaced here: `add` refuses it or
+ * takes the re-join path first.
+ */
+export function insertPending(db: Db, server: PendingServer): void {
+  withWrite(db, () => {
+    const existing = serverById(db, server.serverId);
+    if (existing !== null && existing.confirmedAt !== null)
+      throw new Error(`server ${server.serverId} is already confirmed`);
+    db.run(
+      `INSERT OR REPLACE INTO sharing_servers
+         (server_id, url, name, device_id, device_alias, member_id, member_name, role, contract,
+          instance, added_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+      [
+        server.serverId,
+        server.url,
+        server.name,
+        server.deviceId,
+        server.deviceAlias,
+        server.memberId,
+        server.memberName,
+        server.role,
+        server.contract,
+        server.instance,
+        server.addedAt,
+      ],
+    );
+  });
+}
+
+/**
+ * A re-join: the device columns replaced, the stop and the breaker cleared, a snapshot due.
+ * The ledger, the levels and the received items stay (the spec's re-join rule).
+ */
+export function replaceDevice(db: Db, serverId: string, device: Device): void {
+  db.run(
+    `UPDATE sharing_servers
+        SET device_id = ?, device_alias = ?, member_id = ?, member_name = ?, role = ?,
+            contract = ?, instance = ?, stopped = NULL, snapshot_due = 1, failures = 0,
+            retry_at = NULL, last_error = NULL, last_error_at = NULL
+      WHERE server_id = ?`,
+    [
+      device.deviceId,
+      device.deviceAlias,
+      device.memberId,
+      device.memberName,
+      device.role,
+      device.contract,
+      device.instance,
+      serverId,
+    ],
+  );
+}
+
+export function setStopped(db: Db, serverId: string, stopped: Stopped | null): void {
+  db.run("UPDATE sharing_servers SET stopped = ? WHERE server_id = ?", [stopped, serverId]);
+}
+
+export function setMuted(db: Db, serverId: string, muted: boolean): void {
+  db.run("UPDATE sharing_servers SET muted = ? WHERE server_id = ?", [muted ? 1 : 0, serverId]);
+}
+
+/** A rebuilt server: the new instance, and a snapshot due since the cursors belonged to the old one. */
+export function setInstance(db: Db, serverId: string, instance: string): void {
+  db.run("UPDATE sharing_servers SET instance = ?, snapshot_due = 1 WHERE server_id = ?", [
+    instance,
+    serverId,
+  ]);
+}
+
+/** The backlog summed over the confirmed, not stopped servers: what keeps an idle sync alive. */
+export function totalBacklog(db: Db): number {
+  return (
+    db
+      .query<{ n: number | null }, []>(
+        "SELECT sum(backlog) AS n FROM sharing_servers WHERE confirmed_at IS NOT NULL AND stopped IS NULL",
+      )
+      .get()?.n ?? 0
+  );
+}
+
+export function muteMember(db: Db, serverId: string, memberId: string, muted: boolean): void {
+  if (muted)
+    db.run("INSERT OR IGNORE INTO sharing_muted_members (server_id, member_id) VALUES (?, ?)", [
+      serverId,
+      memberId,
+    ]);
+  else
+    db.run("DELETE FROM sharing_muted_members WHERE server_id = ? AND member_id = ?", [
+      serverId,
+      memberId,
+    ]);
+}
+
+export function mutedMembers(db: Db, serverId: string): string[] {
+  if (!hasServerTables(db)) return [];
+  return db
+    .query<{ member_id: string }, [string]>(
+      "SELECT member_id FROM sharing_muted_members WHERE server_id = ? ORDER BY member_id",
+    )
+    .all(serverId)
+    .map((row) => row.member_id);
+}
+
+/** The server's own row and its mutes; the ledger's tables are `ledger.ts`'s to clear. */
+export function deleteServerRows(db: Db, serverId: string): void {
+  withWrite(db, () => {
+    db.run("DELETE FROM sharing_muted_members WHERE server_id = ?", [serverId]);
+    db.run("DELETE FROM sharing_servers WHERE server_id = ?", [serverId]);
+  });
+}
diff --git a/src/sync/spawn.ts b/src/sync/spawn.ts
new file mode 100644
--- /dev/null
+++ b/src/sync/spawn.ts
@@ -0,0 +1,101 @@
+// What the hooks and the viewer call to have the sync running: one statement over
+// `sharing_servers` and `meta`, one `process.kill(pid, 0)`, and a detached `sync --auto` when
+// there is a server and nothing says no. On a hook path: it imports nothing else of `src/sync/`,
+// and every failure fails open (no spawn).
+import type { Env } from "../settings/settings.ts";
+import type { Db } from "../store/db.ts";
+import {
+  clearSyncStop,
+  failedStartBackoffMs,
+  parseFailedStart,
+  parseLease,
+  parseStopFlag,
+  pidOfOwner,
+  processAlive,
+  SYNC_STOP_STALE_MS,
+} from "../store/meta.ts";
+import { spawnDetached } from "../util/self.ts";
+
+/** `WIZARDINGCODE_MEM_SYNC=off`: no spawn, and `--auto` exits at once (the tests' switch). */
+export const SYNC_SWITCH = "WIZARDINGCODE_MEM_SYNC";
+
+export type StartOutcome =
+  | "spawned"
+  | "off"
+  | "no-schema"
+  | "no-server"
+  | "running"
+  | "stopped"
+  | "backoff"
+  | "error";
+
+interface Snapshot {
+  servers: number;
+  lease: string | null;
+  stop: string | null;
+  failed: string | null;
+}
+
+const SNAPSHOT = `SELECT
+  (SELECT count(*) FROM sharing_servers WHERE confirmed_at IS NOT NULL AND stopped IS NULL) AS servers,
+  (SELECT value FROM meta WHERE key = 'sync.lease') AS lease,
+  (SELECT value FROM meta WHERE key = 'sync.stop') AS stop,
+  (SELECT value FROM meta WHERE key = 'sync.last_failed_start') AS failed`;
+
+/** Whether the store has the sharing schema, which `sqlite_master` tells once per connection. */
+const schemaKnown = new WeakMap<Db, boolean>();
+function hasSharingSchema(db: Db): boolean {
+  let known = schemaKnown.get(db);
+  if (known === undefined) {
+    known =
+      (db
+        .query<{ n: number }, []>(
+          "SELECT count(*) AS n FROM sqlite_master WHERE name = 'sharing_servers'",
+        )
+        .get()?.n ?? 0) > 0;
+    schemaKnown.set(db, known);
+  }
+  return known;
+}
+
+/**
+ * Spawns `sync --auto` when a confirmed, not stopped server is listed, no live process holds
+ * the lease, no stop flag is set (a stale one is cleared) and no young failed-start mark
+ * exists. Nothing on a store without the sharing schema. Never throws.
+ */
+export function startSync(
+  db: Db,
+  env: Env,
+  now: number,
+  spawn: (...args: string[]) => void = spawnDetached,
+  mode: "--auto" | "--once" = "--auto",
+): StartOutcome {
+  try {
+    if (env[SYNC_SWITCH] === "off") return "off";
+    if (!hasSharingSchema(db)) return "no-schema";
+    const snapshot = db.query<Snapshot, []>(SNAPSHOT).get();
+    if (snapshot === null || snapshot.servers === 0) return "no-server";
+    const lease = parseLease(snapshot.lease);
+    if (lease !== null && lease.until > now) {
+      const pid = pidOfOwner(lease.owner);
+      if (pid === null || processAlive(pid)) return "running";
+    }
+    const stop = parseStopFlag(snapshot.stop);
+    if (stop !== null) {
+      if (now - stop.at <= SYNC_STOP_STALE_MS) return "stopped";
+      clearSyncStop(db);
+    }
+    // A person's own run (`--once`, the viewer's button) is not held back by a failed start.
+    const failed = parseFailedStart(snapshot.failed);
+    if (
+      mode === "--auto" &&
+      failed !== null &&
+      now - failed.at < failedStartBackoffMs(failed.failures)
+    )
+      return "backoff";
+    spawn("sync", mode);
+    return "spawned";
+  } catch {
+    return "error";
+  }
+}
diff --git a/src/sync/state.ts b/src/sync/state.ts
new file mode 100644
--- /dev/null
+++ b/src/sync/state.ts
@@ -0,0 +1,427 @@
+// The per-server state: the cursors, the breaker, the last answers, and the report `status`,
+// `doctor` and the viewer read. Every write of the loop goes through `guarded`, which refuses
+// once the sync lease is no longer the process's own (the spec's rule 3).
+import { redact } from "../core/redact.ts";
+import { type Db, withWrite } from "../store/db.ts";
+import {
+  failedStartBackoffMs,
+  getMeta,
+  leaseOwned,
+  parseLease,
+  processAlive,
+  readFailedStart,
+  readSyncStop,
+  restoreHoldKey,
+  SYNC_LEASE,
+} from "../store/meta.ts";
+import type { ClientFailed } from "./client.ts";
+import type { SyncContext } from "./context.ts";
+import {
+  type Cursors,
+  hasServerTables,
+  hostOf,
+  listServers,
+  parseCursors,
+  readTokens,
+  type ServerRow,
+  STOPPED_REMEDIES,
+  type Stopped,
+} from "./servers.ts";
+
+/** The lease is no longer ours: the process writes nothing more and exits. */
+export class LeaseLost extends Error {
+  constructor() {
+    super("the sync lease is no longer ours");
+    this.name = "LeaseLost";
+  }
+}
+
+/**
+ * One write transaction that first checks the lease is still the context's (when the context
+ * holds one). A command that holds no lease (`share server …`) writes unguarded.
+ */
+export function guarded<T>(ctx: SyncContext, fn: () => T): T {
+  return withWrite(ctx.db, () => {
+    if (ctx.lease !== undefined && !leaseOwned(ctx.db, SYNC_LEASE, ctx.lease))
+      throw new LeaseLost();
+    return fn();
+  });
+}
+
+// --- The cursors ------------------------------------------------------------------------------
+
+export function cursorsOf(db: Db, serverId: string): Cursors {
+  const row = db
+    .query<{ cursors: string }, [string]>("SELECT cursors FROM sharing_servers WHERE server_id = ?")
+    .get(serverId);
+  return parseCursors(row?.cursors ?? "{}");
+}
+
+function writeCursors(db: Db, serverId: string, cursors: Cursors): void {
+  db.run("UPDATE sharing_servers SET cursors = ? WHERE server_id = ?", [
+    JSON.stringify(cursors),
+    serverId,
+  ]);
+}
+
+/** Which cursor: the main pull's, or the one of an alias past the main set. */
+export type CursorRef = "main" | { extra: string };
+
+/** Saves a cursor, keeping the larger of the stored and the new value: it never moves back. */
+export function setCursor(
+  ctx: SyncContext,
+  serverId: string,
+  which: CursorRef,
+  value: number,
+): void {
+  guarded(ctx, () => {
+    const cursors = cursorsOf(ctx.db, serverId);
+    if (which === "main") cursors.main = Math.max(cursors.main, value);
+    else cursors.extra[which.extra] = Math.max(cursors.extra[which.extra] ?? 0, value);
+    writeCursors(ctx.db, serverId, cursors);
+  });
+}
+
+/** Changes the cursors as a whole (the main set, an alias dropped); the cursors keep their floor. */
+export function updateCursors(
+  ctx: SyncContext,
+  serverId: string,
+  change: (cursors: Cursors) => Cursors,
+): Cursors {
+  return guarded(ctx, () => {
+    const before = cursorsOf(ctx.db, serverId);
+    const after = change(structuredClone(before));
+    after.main = Math.max(after.main, before.main);
+    for (const [alias, cursor] of Object.entries(after.extra))
+      after.extra[alias] = Math.max(cursor, before.extra[alias] ?? 0);
+    writeCursors(ctx.db, serverId, after);
+    return after;
+  });
+}
+
+// --- The state columns --------------------------------------------------------------------------
+
+export interface StatePatch {
+  snapshotDue?: boolean;
+  lastSweepAt?: number | null;
+  lastSweepMaxId?: number;
+  lastSweepEpoch?: number | null;
+  lastSweepGeneration?: string | null;
+  backlog?: number;
+  retryAt?: number | null;
+  failures?: number;
+  lastError?: string | null;
+  lastErrorAt?: number | null;
+  lastRequestId?: string | null;
+  lastPushAt?: number | null;
+  lastPushOkAt?: number | null;
+  lastPullAt?: number | null;
+  lastPullOkAt?: number | null;
+  roots?: string;
+  areas?: string;
+}
+
+const PATCH_COLUMNS: Readonly<Record<keyof StatePatch, string>> = {
+  snapshotDue: "snapshot_due",
+  lastSweepAt: "last_sweep_at",
+  lastSweepMaxId: "last_sweep_max_id",
+  lastSweepEpoch: "last_sweep_epoch",
+  lastSweepGeneration: "last_sweep_generation",
+  backlog: "backlog",
+  retryAt: "retry_at",
+  failures: "failures",
+  lastError: "last_error",
+  lastErrorAt: "last_error_at",
+  lastRequestId: "last_request_id",
+  lastPushAt: "last_push_at",
+  lastPushOkAt: "last_push_ok_at",
+  lastPullAt: "last_pull_at",
+  lastPullOkAt: "last_pull_ok_at",
+  roots: "roots",
+  areas: "areas",
+};
+
+function writePatch(db: Db, serverId: string, patch: StatePatch): void {
+  const sets: string[] = [];
+  const values: (string | number | null)[] = [];
+  for (const key of Object.keys(PATCH_COLUMNS) as (keyof StatePatch)[]) {
+    if (!(key in patch)) continue;
+    const value = patch[key];
+    if (value === undefined) continue;
+    sets.push(`${PATCH_COLUMNS[key]} = ?`);
+    values.push(typeof value === "boolean" ? (value ? 1 : 0) : value);
+  }
+  if (sets.length === 0) return;
+  values.push(serverId);
+  db.run(`UPDATE sharing_servers SET ${sets.join(", ")} WHERE server_id = ?`, values);
+}
+
+/** A guarded write of state columns; `last_error` goes through `redact`. */
+export function updateState(ctx: SyncContext, serverId: string, patch: StatePatch): void {
+  guarded(ctx, () => {
+    writePatch(ctx.db, serverId, {
+      ...patch,
+      ...(typeof patch.lastError === "string" ? { lastError: redact(patch.lastError) } : {}),
+    });
+  });
+}
+
+// --- The breaker ----------------------------------------------------------------------------------
+
+/** The first interval after a failure; it doubles per failure up to the cap. */
+export const BACKOFF_MIN_MS = 2_000;
+export const BACKOFF_MAX_MS = 10 * 60_000;
+/** The jitter added to an interval: up to a fifth of it. */
+const JITTER = 0.2;
+
+/** The wait after the n-th consecutive failure: 2 s doubling, with jitter, capped at ten minutes. */
+export function backoffMs(failures: number, random: () => number = Math.random): number {
+  const base = Math.min(BACKOFF_MIN_MS * 2 ** Math.max(0, failures - 1), BACKOFF_MAX_MS);
+  return Math.min(Math.floor(base * (1 + random() * JITTER)), BACKOFF_MAX_MS);
+}
+
+export type Answer = {
+  kind: "push" | "pull";
+  at: number;
+  requestId?: string;
+} & (
+  | { ok: true }
+  | {
+      ok: false;
+      error: string;
+      /** A 429's `Retry-After`: waited as given, and no failure for the breaker. */
+      retryAfterMs?: number;
+    }
+);
+
+/**
+ * A failed request as `recordAnswer` takes it: the failure's kind and its error when it has
+ * one, a rate limit's wait, and the request id when the server gave one. The one conversion
+ * the push and the pull make.
+ */
+export function failureAnswer(kind: Answer["kind"], failure: ClientFailed, at: number): Answer {
+  return {
+    kind,
+    ok: false,
+    at,
+    error: `${failure.kind}${"error" in failure ? `: ${failure.error}` : ""}`,
+    ...(failure.kind === "rate" ? { retryAfterMs: failure.retryAfterMs } : {}),
+    ...(failure.requestId === null ? {} : { requestId: failure.requestId }),
+  };
+}
+
+/**
+ * Records a server's answer: a success clears the breaker; a failure counts, stores the error
+ * redacted and sets `retry_at` by the backoff, or by `Retry-After` when the server named one.
+ */
+export function recordAnswer(ctx: SyncContext, serverId: string, answer: Answer): void {
+  guarded(ctx, () => {
+    const attempt = answer.kind === "push" ? "lastPushAt" : "lastPullAt";
+    const success = answer.kind === "push" ? "lastPushOkAt" : "lastPullOkAt";
+    const requestId = answer.requestId === undefined ? {} : { lastRequestId: answer.requestId };
+    if (answer.ok) {
+      writePatch(ctx.db, serverId, {
+        [attempt]: answer.at,
+        [success]: answer.at,
+        failures: 0,
+        retryAt: null,
+        lastError: null,
+        lastErrorAt: null,
+        ...requestId,
+      });
+      return;
+    }
+    const row = ctx.db
+      .query<{ failures: number }, [string]>(
+        "SELECT failures FROM sharing_servers WHERE server_id = ?",
+      )
+      .get(serverId);
+    const failures = row?.failures ?? 0;
+    const counted = answer.retryAfterMs === undefined ? failures + 1 : failures;
+    writePatch(ctx.db, serverId, {
+      [attempt]: answer.at,
+      failures: counted,
+      retryAt:
+        answer.retryAfterMs === undefined
+          ? answer.at + backoffMs(counted)
+          : answer.at + answer.retryAfterMs,
+      lastError: redact(answer.error),
+      lastErrorAt: answer.at,
+      ...requestId,
+    });
+  });
+}
+
+// --- The report ------------------------------------------------------------------------------------
+
+/** The server rows as `status`, `doctor` and the viewer read them. */
+export function serverRows(db: Db): ServerRow[] {
+  return listServers(db);
+}
+
+export type ServerState = "pending" | "token missing" | "ok" | "stopped";
+
+export interface WithdrawalHold {
+  reason: "restore" | "bulk";
+  at: number;
+  /** The withdrawals the last sweep held; 0 until a sweep looked. */
+  count: number;
+}
+
+export interface ServerStatus {
+  serverId: string;
+  name: string;
+  host: string;
+  url: string;
+  member: string;
+  memberId: string;
+  role: string;
+  contract: number;
+  state: ServerState;
+  stopped: Stopped | null;
+  /** What the person does next, when the state asks for something. */
+  remedy: string | null;
+  /** The cursors' sum: the main pull's and every extra alias's. */
+  cursor: number;
+  snapshotDue: boolean;
+  lastSweepAt: number | null;
+  lastPushAt: number | null;
+  lastPushOkAt: number | null;
+  lastPullAt: number | null;
+  lastPullOkAt: number | null;
+  backlog: number;
+  /** Uncommitted paths the last sweep counted; the outbound side fills it. */
+  dirtyPaths: number;
+  /** Rows set aside after ten failed applies; the ledger fills it. */
+  pendingRows: number;
+  openConflicts: number;
+  hold: WithdrawalHold | null;
+  failures: number;
+  retryAt: number | null;
+  lastError: string | null;
+  lastErrorAt: number | null;
+  muted: boolean;
+}
+
+/** The per-server counts the ledger gives (`ledger.ts`), beside the row's own columns. */
+export interface ServerCounts {
+  dirtyPaths: number;
+  pendingRows: number;
+  openConflicts: number;
+}
+
+export type CountsOf = (db: Db, serverId: string) => ServerCounts;
+
+const NO_COUNTS: CountsOf = () => ({ dirtyPaths: 0, pendingRows: 0, openConflicts: 0 });
+
+export function readHold(db: Db, serverId: string): WithdrawalHold | null {
+  const raw = getMeta(db, restoreHoldKey(serverId));
+  if (raw === null) return null;
+  try {
+    const hold = JSON.parse(raw) as Partial<WithdrawalHold>;
+    const count = typeof hold.count === "number" && hold.count >= 0 ? hold.count : 0;
+    return (hold.reason === "restore" || hold.reason === "bulk") && typeof hold.at === "number"
+      ? { reason: hold.reason, at: hold.at, count }
+      : { reason: "restore", at: 0, count };
+  } catch {
+    return { reason: "restore", at: 0, count: 0 };
+  }
+}
+
+/**
+ * One entry per server for `status`, the viewer and `doctor`: the state, its remedy, the
+ * cursors, the last answers, the backlog and a held withdrawal. Never a token. Nothing on a
+ * store without the sharing v2 tables.
+ */
+export function statusReport(
+  db: Db,
+  dataDir: string,
+  countsOf: CountsOf = NO_COUNTS,
+): ServerStatus[] {
+  if (!hasServerTables(db)) return [];
+  const tokens = readTokens(dataDir);
+  return listServers(db).map((row) => {
+    const counts = countsOf(db, row.serverId);
+    const stateOf = (): [ServerState, string | null] => {
+      if (row.confirmedAt === null) return ["pending", "share server add again"];
+      if (!(row.serverId in tokens)) return ["token missing", "share server rejoin"];
+      if (row.stopped !== null) return ["stopped", STOPPED_REMEDIES[row.stopped]];
+      return ["ok", null];
+    };
+    const [state, remedy] = stateOf();
+    return {
+      serverId: row.serverId,
+      name: row.name,
+      host: hostOf(row.url),
+      url: row.url,
+      member: row.memberName,
+      memberId: row.memberId,
+      role: row.role,
+      contract: row.contract,
+      state,
+      stopped: row.stopped,
+      remedy,
+      cursor:
+        row.cursors.main +
+        Object.values(row.cursors.extra).reduce((sum, cursor) => sum + cursor, 0),
+      snapshotDue: row.snapshotDue,
+      lastSweepAt: row.lastSweepAt,
+      lastPushAt: row.lastPushAt,
+      lastPushOkAt: row.lastPushOkAt,
+      lastPullAt: row.lastPullAt,
+      lastPullOkAt: row.lastPullOkAt,
+      backlog: row.backlog,
+      dirtyPaths: counts.dirtyPaths,
+      pendingRows: counts.pendingRows,
+      openConflicts: counts.openConflicts,
+      hold: readHold(db, row.serverId),
+      failures: row.failures,
+      retryAt: row.retryAt,
+      lastError: row.lastError,
+      lastErrorAt: row.lastErrorAt,
+      muted: row.muted,
+    };
+  });
+}
+
+// --- The sync's own state --------------------------------------------------------------------------
+
+export type SyncState =
+  | { kind: "not-running" }
+  | { kind: "running"; pid: number; version: string }
+  | { kind: "stopping"; who: string; at: number; pid: number; version: string }
+  | { kind: "stopped"; who: string; at: number }
+  | { kind: "start-failed"; at: number; reason: string; failures: number; nextTryAt: number }
+  /** An unexpired lease whose process is gone: the next spawn takes it. */
+  | { kind: "dead-holder"; pid: number; version: string };
+
+function holderOf(owner: string): { pid: number; version: string } {
+  const match = /^sync-(\d+)-(.+)$/.exec(owner);
+  return match === null
+    ? { pid: 0, version: "" }
+    : { pid: Number(match[1]), version: match[2] ?? "" };
+}
+
+/** What `status` says of the process: from the lease, the stop flag and the failed-start mark. */
+export function syncState(db: Db, now: number): SyncState {
+  const lease = parseLease(getMeta(db, SYNC_LEASE));
+  const stop = readSyncStop(db);
+  if (lease !== null && lease.until > now) {
+    const holder = holderOf(lease.owner);
+    if (holder.pid !== 0 && !processAlive(holder.pid)) return { kind: "dead-holder", ...holder };
+    return stop === null
+      ? { kind: "running", ...holder }
+      : { kind: "stopping", who: stop.who, at: stop.at, ...holder };
+  }
+  if (stop !== null) return { kind: "stopped", who: stop.who, at: stop.at };
+  const failed = readFailedStart(db);
+  if (failed !== null)
+    return {
+      kind: "start-failed",
+      at: failed.at,
+      reason: failed.reason,
+      failures: failed.failures,
+      nextTryAt: failed.at + failedStartBackoffMs(failed.failures),
+    };
+  return { kind: "not-running" };
+}
