+  staged: "0.7.0",
+  line: "0.9.0 is out (checked 3 h ago); the agents run 0.7.0",
+  agents:
+    "agents run 0.7.0 from /data/bin/wizardingcode-mem; this copy is 0.8.0: wizardingcode-mem install moves them to it",
+});
