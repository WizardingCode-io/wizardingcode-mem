+      },
+      "0.8.0 is ahead of the latest release 0.7.0 (checked 3 h ago)",
+      "quiet",
+      "ok",
+    ],
+    [
+      "off",
+      { ...base, mode: "off", line: "off (WIZARDINGCODE_MEM_UPDATE in /data/env)" },
