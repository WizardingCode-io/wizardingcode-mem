+    if (step === undefined) return run(cmd, more);
+    if ("answer" in step) return { code: 1, stdout: "", stderr: "", ...step.answer };
+    const real = run(cmd, more);
+    return {
+      code: real.code,
+      stdout: real.stdout + (step.add.stdout ?? ""),
+      stderr: real.stderr + (step.add.stderr ?? ""),
+    };
+  };
