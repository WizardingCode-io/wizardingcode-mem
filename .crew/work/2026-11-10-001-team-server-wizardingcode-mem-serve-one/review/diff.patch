+CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT NOT NULL) WITHOUT ROWID;
+CREATE TABLE members (
+  id TEXT PRIMARY KEY, name TEXT NOT NULL,
+  role TEXT NOT NULL CHECK (role IN ('admin','member')),
+  created_at INTEGER NOT NULL, disabled_at INTEGER
+);
+CREATE TABLE devices (
+  id TEXT PRIMARY KEY, alias TEXT NOT NULL UNIQUE,
+  member_id TEXT NOT NULL REFERENCES members(id),
+  token_hash TEXT NOT NULL UNIQUE, label TEXT NOT NULL,
+  created_at INTEGER NOT NULL, last_seen_at INTEGER, revoked_at INTEGER
+);
+CREATE TABLE invitations (
+  id TEXT PRIMARY KEY, code_hash TEXT NOT NULL UNIQUE,
+  role TEXT NOT NULL CHECK (role IN ('admin','member')),
+  name TEXT, for_member TEXT REFERENCES members(id),
+  created_by_device TEXT REFERENCES devices(id),
+  created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL,
+  used_at INTEGER, used_by_device TEXT REFERENCES devices(id), revoked_at INTEGER
+);
+CREATE TABLE entries (
+  uuid TEXT PRIMARY KEY, scope TEXT NOT NULL, remote_alias TEXT, slug TEXT NOT NULL,
+  created_by_member TEXT NOT NULL REFERENCES members(id),
+  revision INTEGER NOT NULL, hash TEXT NOT NULL, size INTEGER NOT NULL,
+  writer_member TEXT NOT NULL REFERENCES members(id),
+  writer_device TEXT NOT NULL REFERENCES devices(id),
+  updated_at INTEGER NOT NULL, withdrawn_at INTEGER,
+  locked_by_admin INTEGER NOT NULL DEFAULT 0,
+  mirror_revision INTEGER NOT NULL DEFAULT 0
+);
+CREATE INDEX entries_pending ON entries(uuid) WHERE mirror_revision < revision;
+CREATE INDEX entries_creator ON entries(created_by_member, scope);
+CREATE TABLE entry_revisions (
+  uuid TEXT NOT NULL REFERENCES entries(uuid), revision INTEGER NOT NULL,
+  seq INTEGER NOT NULL,
+  op TEXT NOT NULL CHECK (op IN ('send','withdraw')),
+  scope TEXT NOT NULL, remote_alias TEXT, slug TEXT NOT NULL,
+  frontmatter TEXT NOT NULL, body TEXT NOT NULL, hash TEXT NOT NULL,
+  writer_member TEXT NOT NULL, writer_device TEXT NOT NULL,
+  client_epoch INTEGER, at INTEGER NOT NULL,
+  PRIMARY KEY (uuid, revision)
+);
+CREATE INDEX entry_revisions_hash ON entry_revisions(uuid, hash, writer_device);
+CREATE INDEX entry_revisions_seq ON entry_revisions(seq);
+CREATE TABLE memories (
+  device_id TEXT NOT NULL REFERENCES devices(id), uid TEXT NOT NULL,
+  remote_alias TEXT NOT NULL, payload TEXT NOT NULL, hash TEXT NOT NULL,
+  size INTEGER NOT NULL, revision INTEGER NOT NULL, updated_at INTEGER NOT NULL,
+  member_id TEXT NOT NULL REFERENCES members(id), received_at INTEGER NOT NULL,
+  withdrawn_at INTEGER, locked_by_admin INTEGER NOT NULL DEFAULT 0,
+  PRIMARY KEY (device_id, uid)
+);
+CREATE TABLE changes (
+  seq INTEGER PRIMARY KEY AUTOINCREMENT,
+  kind TEXT NOT NULL CHECK (kind IN ('entry','memory')),
+  uid TEXT NOT NULL, key TEXT NOT NULL,
+  op TEXT NOT NULL CHECK (op IN ('upsert','tombstone','purge')),
+  scope TEXT NOT NULL, remote_alias TEXT, revision INTEGER NOT NULL, hash TEXT NOT NULL,
+  moved_to TEXT,
+  member_id TEXT NOT NULL, device_id TEXT NOT NULL, client_epoch INTEGER,
+  at INTEGER NOT NULL, current INTEGER NOT NULL DEFAULT 1
+);
+CREATE INDEX changes_key ON changes(key, seq);
+CREATE INDEX changes_scope ON changes(scope, remote_alias, current, seq);
+CREATE TABLE purged (key TEXT PRIMARY KEY, at INTEGER NOT NULL) WITHOUT ROWID;
+CREATE TABLE audit (
+  id INTEGER PRIMARY KEY AUTOINCREMENT, at INTEGER NOT NULL,
+  source TEXT NOT NULL, device_id TEXT, address TEXT,
+  action TEXT NOT NULL, target TEXT, detail TEXT NOT NULL DEFAULT ''
+);
diff --git a/src/team/mirror.ts b/src/team/mirror.ts
new file mode 100644
index 0000000..0e9da85
--- /dev/null
+++ b/src/team/mirror.ts
@@ -0,0 +1,817 @@
+// The mirror: an export of the entries to git repositories under `repos/`, one commit per
+// applied revision, written from the database by `serve mirror` (hourly, after a quiet minute
+// following a push, or by hand) and rebuilt from `entry_revisions` (D-10, D-26). Git runs
+// through part 1's runner, synchronously, in the child process; never on a request.
+import { existsSync, mkdirSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { slugify } from "../modules/knowledge/entry.ts";
+import {
+  commitPaths,
+  type GitHost,
+  headOf,
+  projectFolderName,
+  removePaths,
+  runGit,
+  stagePaths,
+  writeFileAtomic,
+} from "../modules/knowledge/repo.ts";
+import type { Identity } from "../modules/knowledge/types.ts";
+import { entryUid } from "../sharing/types.ts";
+import { type Db, teamPaths } from "./db.ts";
+import { HttpError, unknownItem } from "./errors.ts";
+import { OPERATOR, splitMemoryKey } from "./ids.ts";
+import { holdLease, MIRROR_LEASE, MIRROR_TTL_MS } from "./lease.ts";
+import type { TeamLog } from "./log.ts";
+import { deviceAlias, memoryFeedUid, parseFeedUid } from "./push.ts";
+import type { Timers } from "./signal.ts";
+import {
+  checkpointWal,
+  clearMeta,
+  deleteEntry,
+  deleteMemory,
+  deleteRevisions,
+  entryByUuid,
+  forEachRevision,
+  getMeta,
+  insertAudit,
+  insertChange,
+  insertPurged,
+  markPurged,
+  memberById,
+  memoryByKey,
+  pendingRevisionsAfter,
+  type RevisionRow,
+  resetMirrorRevisions,
+  revisionAt,
+  revisionsOf,
+  setMeta,
+  setMirrorRevision,
+  transaction,
+} from "./store.ts";
+
+export const SERVER_IDENTITY: Identity = {
+  name: "wizardingcode-mem serve",
+  email: "server@team.wizardingcode.invalid",
+};
+
+/** A commit's author: the member, under an address that names their id and resolves nowhere. */
+export function memberIdentity(member: { id: string; name: string }): Identity {
+  return { name: member.name, email: `${member.id}@members.wizardingcode.invalid` };
+}
+
+/** The slug of a name, or `fallback` when nothing of it survives: never the raw text. */
+function slugOf(text: string, fallback: string): string {
+  const letters = text
+    .normalize("NFKD")
+    .replace(/\p{M}+/gu, "")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "");
+  return letters === "" ? fallback : slugify(text);
+}
+
+/**
+ * The repository a scope and alias name, relative to `repos/`: `shared`; a project by the
+ * slug of its alias and a hash of it; a member's workspace by their id and the slug of their
+ * name. Built from ids and slugs, so a name such as `../x` stays under its parent.
+ */
+export function repoFolder(
+  scope: string,
+  remoteAlias: string | null,
+  member: { id: string; name: string } | null,
+): string {
+  if (scope === "shared") return "shared";
+  if (scope === "project") {
+    const alias = remoteAlias ?? "";
+    const slug = slugOf(alias.replace(/^remote:/, ""), "project");
+    return `projects/${slug}-${projectFolderName(alias).slice(0, 8)}`;
+  }
+  const who = member ?? { id: "unknown", name: "" };
+  return `members/${who.id}-${slugOf(who.name, "member")}`;
+}
+
+/** A fixed file name: two entries with one slug never collide, and a slug change is a rename. */
+export function fileNameFor(uuid: string, slug: string): string {
+  return `entries/${slug}--${uuid.slice(0, 8)}.md`;
+}
+
+export const MIRROR_GIT_TIMEOUT_MS = 60_000;
+
+/** The runner's host for the mirror: `repos/` as the ceiling, a long timeout, the volume's owner trusted. */
+export function mirrorHost(
+  dataDir: string,
+  env: Record<string, string | undefined>,
+  gitPath?: string,
+): GitHost {
+  const path = gitPath === undefined ? (env.PATH ?? "") : `${gitPath}:${env.PATH ?? ""}`;
+  return {
+    dataDir,
+    env: { ...env, PATH: path },
+    gitTimeoutMs: MIRROR_GIT_TIMEOUT_MS,
+    renew: null,
+    root: teamPaths(dataDir).repos,
+    extraConfig: ["-c", "safe.directory=*"],
+    logScope: "team",
+  };
+}
+
+export interface MirrorContext {
+  db: Db;
+  dataDir: string;
+  env: Record<string, string | undefined>;
+  gitPath?: string;
+  log: TeamLog;
+  now: () => number;
+}
+
+export interface MirrorRun {
+  commits: number;
+  errors: { folder: string; message: string }[];
+}
+
+/** The run's lease went to another holder: the run stops before it touches a repository again. */
+class MirrorLeaseLostError extends Error {
+  constructor() {
+    super("the mirror lease was lost to another holder");
+    this.name = "MirrorLeaseLostError";
+  }
+}
+
+/** A failure inside one repository, named by its folder. */
+class MirrorRepoError extends Error {
+  constructor(
+    readonly folder: string,
+    cause: unknown,
+  ) {
+    super(cause instanceof Error ? cause.message : String(cause));
+    this.name = "MirrorRepoError";
+  }
+}
+
+interface RepoMeta {
+  scope: string;
+  remoteAlias?: string;
+  memberId?: string;
+  memberName?: string;
+}
+
+const OPERATION = "mirror";
+
+/**
+ * The repository at `folder`, made when absent: `git init -q --template=`, `knowledge.json`,
+ * `entries/.gitkeep`, one commit by the server. A folder with `.git` and no HEAD (a run cut
+ * after init) is completed the same way. An `index.lock` left by a dead run is removed first:
+ * the caller holds the mirror lease, so no other run is alive.
+ */
+export function ensureMirrorRepo(
+  host: GitHost,
+  folder: string,
+  meta: RepoMeta,
+  now: number,
+): string {
+  mkdirSync(folder, { recursive: true, mode: 0o700 });
+  const gitDir = join(folder, ".git");
+  rmSync(join(gitDir, "index.lock"), { force: true });
+  if (!existsSync(gitDir)) {
+    runGit(host, null, ["init", "-q", "--template=", folder], { operation: OPERATION });
+  }
+  if (headOf(folder) === null) {
+    const manifest = {
+      format: 1,
+      scope: meta.scope,
+      ...(meta.remoteAlias === undefined ? {} : { remoteAlias: meta.remoteAlias }),
+      ...(meta.memberId === undefined ? {} : { memberId: meta.memberId }),
+      ...(meta.memberName === undefined ? {} : { memberName: meta.memberName }),
+      mirror: true,
+      createdAt: new Date(now).toISOString(),
+    };
+    writeFileAtomic(join(folder, "knowledge.json"), `${JSON.stringify(manifest, null, 2)}\n`);
+    mkdirSync(join(folder, "entries"), { recursive: true, mode: 0o700 });
+    writeFileAtomic(join(folder, "entries", ".gitkeep"), "");
+    const paths = ["knowledge.json", "entries/.gitkeep"];
+    stagePaths(host, { path: folder }, paths, OPERATION);
+    commitPaths(
+      host,
+      { path: folder },
+      paths,
+      `team: init ${meta.scope}`,
+      SERVER_IDENTITY,
+      OPERATION,
+    );
+  }
+  return folder;
+}
+
+interface Placed {
+  relative: string;
+  meta: RepoMeta;
+}
+
+/** Where a revision lives: the folder its scope, alias or creator names, and the manifest for it. */
+function placeOf(db: Db, revision: RevisionRow, creator: string): Placed {
+  if (revision.scope === "workspace") {
+    const name = memberById(db, creator)?.name ?? creator;
+    return {
+      relative: repoFolder("workspace", null, { id: creator, name }),
+      meta: { scope: "workspace", memberId: creator, memberName: name },
+    };
+  }
+  if (revision.scope === "project") {
+    return {
+      relative: repoFolder("project", revision.remote_alias, null),
+      meta: { scope: "project", remoteAlias: revision.remote_alias ?? "" },
+    };
+  }
+  return { relative: "shared", meta: { scope: "shared" } };
+}
+
+const uidOf = (revision: RevisionRow) =>
+  entryUid(
+    revision.scope as "workspace" | "shared" | "project",
+    revision.remote_alias,
+    revision.uuid,
+  );
+
+/**
+ * One revision as commits: a move removes the file from the previous folder in a commit
+ * there; a send writes the file (and removes the old name on a slug change); a withdraw
+ * removes it. With `only`, the folders outside the set are left as they are: a replay.
+ * Returns 1 when the revision reached a repository, 0 when `only` kept it out.
+ */
+function applyRevision(
+  db: Db,
+  host: GitHost,
+  root: string,
+  revision: RevisionRow,
+  previous: RevisionRow | null,
+  creator: string,
+  only: ReadonlySet<string> | null,
+  now: number,
+): number {
+  const here = placeOf(db, revision, creator);
+  const writer = memberById(db, revision.writer_member);
+  const author = memberIdentity({
+    id: revision.writer_member,
+    name: writer?.name ?? revision.writer_member,
+  });
+  const uid = uidOf(revision);
+  const trailers = `\n\nRevision: ${revision.revision}\nUid: ${uid}\nHash: ${revision.hash}\n`;
+  const file = fileNameFor(revision.uuid, revision.slug);
+  let touched = 0;
+  const inRepo = <T>(relative: string, fn: () => T): T => {
+    try {
+      return fn();
+    } catch (error) {
+      if (error instanceof MirrorLeaseLostError) throw error;
+      throw new MirrorRepoError(relative, error);
+    }
+  };
+
+  const livePrevious = previous !== null && previous.op === "send" ? previous : null;
+  const there = livePrevious === null ? null : placeOf(db, livePrevious, creator);
+  if (livePrevious !== null && there !== null && there.relative !== here.relative) {
+    if (only === null || only.has(there.relative)) {
+      inRepo(there.relative, () => {
+        const path = ensureMirrorRepo(host, join(root, there.relative), there.meta, now);
+        const oldFile = fileNameFor(livePrevious.uuid, livePrevious.slug);
+        if (existsSync(join(path, oldFile))) {
+          removePaths(host, { path }, [oldFile], OPERATION);
+          commitPaths(
+            host,
+            { path },
+            [oldFile],
+            `team: move ${uid}${trailers}`,
+            author,
+            OPERATION,
+            SERVER_IDENTITY,
+          );
+        }
+      });
+      touched = 1;
+    }
+  }
+
+  if (only !== null && !only.has(here.relative)) return touched;
+  inRepo(here.relative, () => {
+    const path = ensureMirrorRepo(host, join(root, here.relative), here.meta, now);
+    if (revision.op === "send") {
+      const paths = [file];
+      if (
+        livePrevious !== null &&
+        there?.relative === here.relative &&
+        livePrevious.slug !== revision.slug
+      ) {
+        const oldFile = fileNameFor(livePrevious.uuid, livePrevious.slug);
+        if (existsSync(join(path, oldFile))) {
+          removePaths(host, { path }, [oldFile], OPERATION);
+          paths.push(oldFile);
+        }
+      }
+      writeFileAtomic(join(path, file), revision.frontmatter + revision.body);
+      stagePaths(host, { path }, [file], OPERATION);
+      commitPaths(
+        host,
+        { path },
+        paths,
+        `team: send ${uid}${trailers}`,
+        author,
+        OPERATION,
+        SERVER_IDENTITY,
+      );
+    } else if (existsSync(join(path, file))) {
+      removePaths(host, { path }, [file], OPERATION);
+      commitPaths(
+        host,
+        { path },
+        [file],
+        `team: withdraw ${uid}${trailers}`,
+        author,
+        OPERATION,
+        SERVER_IDENTITY,
+      );
+    }
+  });
+  return 1;
+}
+
+/** Every folder a revision touches: its own, and the one it left on a move. */
+function foldersOf(
+  db: Db,
+  revision: RevisionRow,
+  previous: RevisionRow | null,
+  creator: string,
+): string[] {
+  const folders = [placeOf(db, revision, creator).relative];
+  if (previous !== null && previous.op === "send") {
+    const left = placeOf(db, previous, creator).relative;
+    if (left !== folders[0]) folders.push(left);
+  }
+  return folders;
+}
+
+interface PendingRow {
+  revision: RevisionRow;
+  creator: string;
+}
+
+/**
+ * The revisions the mirror has not exported, in the order of their `seq`: the keys read batch
+ * by batch, each row fetched as it is reached, so no sort and no batch holds the texts.
+ */
+function* pendingRevisions(db: Db): Generator<PendingRow> {
+  let after = 0;
+  for (;;) {
+    const keys = pendingRevisionsAfter(db, after);
+    if (keys.length === 0) return;
+    for (const key of keys) {
+      after = key.seq;
+      const revision = revisionAt(db, key.uuid, key.revision);
+      // Under the lease nothing deletes a revision, so a key without its row is a fault to see.
+      if (revision === null) throw new Error(`pending ${key.uuid}@${key.revision} has no row`);
+      yield { revision, creator: key.creator };
+    }
+  }
+}
+
+/** Set while a rebuild removes the repositories and resets the marks; a run that finds it finishes the rebuild. */
+const REBUILD_MARK = "mirror.rebuild";
+/**
+ * The folders a purge owes a replay, written in the erasure's transaction and cleared once the
+ * replay is whole; a run that finds it replays them before it exports anything.
+ */
+const REPLAY_MARK = "mirror.replay";
+
+type Owed = [string, RepoMeta][];
+
+/** The note: the folders owed, nothing, or `"all"` for a note that cannot be read (a rebuild then replays everything). */
+function owedReplay(db: Db): Map<string, RepoMeta> | "all" | null {
+  const raw = getMeta(db, REPLAY_MARK);
+  if (raw === null) return null;
+  try {
+    return new Map(JSON.parse(raw) as Owed);
+  } catch {
+    return "all";
+  }
+}
+
+/** The note with `touched` added, written back: what this purge replays. An unreadable note becomes a rebuild. */
+function noteOwed(
+  db: Db,
+  touched: ReadonlyMap<string, RepoMeta>,
+  now: number,
+): Map<string, RepoMeta> {
+  const noted = owedReplay(db);
+  if (noted === "all") setMeta(db, REBUILD_MARK, String(now));
+  const owed = noted instanceof Map ? noted : new Map<string, RepoMeta>();
+  for (const [folder, meta] of touched) owed.set(folder, meta);
+  if (owed.size > 0) setMeta(db, REPLAY_MARK, JSON.stringify([...owed]));
+  return owed;
+}
+
+const summary = (errors: MirrorRun["errors"]) =>
+  errors.length === 0
+    ? null
+    : errors.map((error) => `${error.folder}: ${error.message}`).join("; ");
+
+/**
+ * Takes the mirror lease and gives a host whose every git call renews it, or stops the run;
+ * `record` runs last, with the failures, whether `fn` returned or threw.
+ */
+function underMirrorLease<T>(
+  ctx: MirrorContext,
+  fn: (host: GitHost, failures: MirrorRun["errors"]) => T,
+  record: (failures: MirrorRun["errors"]) => void,
+): { result: T; failures: MirrorRun["errors"] } {
+  const lease = holdLease(ctx.db, MIRROR_LEASE, "mirror", MIRROR_TTL_MS, ctx.now);
+  const host: GitHost = {
+    ...mirrorHost(ctx.dataDir, ctx.env, ctx.gitPath),
+    renew: () => {
+      if (!lease.renew()) throw new MirrorLeaseLostError();
+    },
+  };
+  const failures: MirrorRun["errors"] = [];
+  try {
+    return { result: fn(host, failures), failures };
+  } catch (error) {
+    // A throw outside the per-revision blocks (a root that cannot be removed) is recorded too;
+    // a refusal is the caller's answer, not a run's failure.
+    if (!(error instanceof HttpError)) {
+      failures.push({
+        folder: "(run)",
+        message: error instanceof Error ? error.message : String(error),
+      });
+    }
+    throw error;
+  } finally {
+    record(failures);
+    lease.release();
+  }
+}
+
+/**
+ * The export: an owed replay first, then every pending revision in `seq` order, each as
+ * commits; a repository that fails is recorded and skipped for the rest of the run, the others
+ * go on; a lost lease ends the run. `rebuild` removes every repository first and replays from
+ * the start.
+ */
+export function runMirror(ctx: MirrorContext, options: { rebuild: boolean }): MirrorRun {
+  const root = teamPaths(ctx.dataDir).repos;
+  let commits = 0;
+  const { failures: errors } = underMirrorLease(
+    ctx,
+    (host, failures) => {
+      // A rebuild cut between the removal and the reset would leave every revision marked
+      // exported with no repository: the marker makes the next run finish it. A rebuild replays
+      // everything, so nothing stays owed beside it, and a note that cannot be read is one.
+      const owed = owedReplay(ctx.db);
+      if (options.rebuild || getMeta(ctx.db, REBUILD_MARK) !== null || owed === "all") {
+        setMeta(ctx.db, REBUILD_MARK, String(ctx.now()));
+        rmSync(root, { recursive: true, force: true });
+        resetMirrorRevisions(ctx.db);
+        clearMeta(ctx.db, REPLAY_MARK);
+        clearMeta(ctx.db, REBUILD_MARK);
+      } else if (owed !== null) {
+        replayOwed(ctx, host, owed, failures);
+      }
+      const failed = new Set(failures.map((failure) => failure.folder));
+      const skipped = new Set<string>();
+      for (const { revision, creator } of pendingRevisions(ctx.db)) {
+        if (skipped.has(revision.uuid)) continue;
+        const previous =
+          revision.revision > 1 ? revisionAt(ctx.db, revision.uuid, revision.revision - 1) : null;
+        const folders = foldersOf(ctx.db, revision, previous, creator);
+        if (folders.some((folder) => failed.has(folder))) {
+          skipped.add(revision.uuid);
+          continue;
+        }
+        try {
+          commits += applyRevision(
+            ctx.db,
+            host,
+            root,
+            revision,
+            previous,
+            creator,
+            null,
+            ctx.now(),
+          );
+          setMirrorRevision(ctx.db, revision.uuid, revision.revision);
+        } catch (error) {
+          if (error instanceof MirrorRepoError) {
+            failed.add(error.folder);
+            skipped.add(revision.uuid);
+            failures.push({ folder: error.folder, message: error.message });
+            continue;
+          }
+          failures.push({
+            folder: folders[0] as string,
+            message: error instanceof Error ? error.message : String(error),
+          });
+          break;
+        }
+      }
+    },
+    (failures) => {
+      setMeta(
+        ctx.db,
+        "mirror.last",
+        JSON.stringify({ at: ctx.now(), commits, error: summary(failures) }),
+      );
+    },
+  );
+  return { commits, errors };
+}
+
+/**
+ * Replays the exported revisions that touch `folders` after those folders were removed: a
+ * purge's rebuild, under the lease the caller holds. Revisions the mirror has not exported
+ * yet are left to the next run. The history is read one row at a time.
+ */
+function replayFolders(
+  ctx: MirrorContext,
+  host: GitHost,
+  folders: ReadonlyMap<string, RepoMeta>,
+  failures: MirrorRun["errors"],
+): void {
+  const root = teamPaths(ctx.dataDir).repos;
+  for (const folder of folders.keys()) rmSync(join(root, folder), { recursive: true, force: true });
+  const only = new Set(folders.keys());
+  const exported = new Map<string, { creator: string; mirrorRevision: number }>();
+  forEachRevision(ctx.db, (revision) => {
+    let entry = exported.get(revision.uuid);
+    if (entry === undefined) {
+      const row = entryByUuid(ctx.db, revision.uuid);
+      entry = {
+        creator: row?.created_by_member ?? revision.writer_member,
+        mirrorRevision: row?.mirror_revision ?? 0,
+      };
+      exported.set(revision.uuid, entry);
+    }
+    if (revision.revision > entry.mirrorRevision) return undefined;
+    const previous =
+      revision.revision > 1 ? revisionAt(ctx.db, revision.uuid, revision.revision - 1) : null;
+    try {
+      applyRevision(ctx.db, host, root, revision, previous, entry.creator, only, ctx.now());
+      return undefined;
+    } catch (error) {
+      failures.push({
+        folder:
+          error instanceof MirrorRepoError
+            ? error.folder
+            : placeOf(ctx.db, revision, entry.creator).relative,
+        message: error instanceof Error ? error.message : String(error),
+      });
+      return error instanceof MirrorRepoError ? undefined : false;
+    }
+  });
+  // A repository the purged entry alone had filled stays, with its init commit and nothing else.
+  for (const [relative, meta] of folders) {
+    try {
+      ensureMirrorRepo(host, join(root, relative), meta, ctx.now());
+    } catch (error) {
+      failures.push({
+        folder: relative,
+        message: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+}
+
+/** The owed replay, under the caller's lease: the mark is cleared only when no failure was added. */
+function replayOwed(
+  ctx: MirrorContext,
+  host: GitHost,
+  folders: ReadonlyMap<string, RepoMeta>,
+  failures: MirrorRun["errors"],
+): void {
+  const before = failures.length;
+  replayFolders(ctx, host, folders, failures);
+  if (failures.length === before) clearMeta(ctx.db, REPLAY_MARK);
+}
+
+interface Erased {
+  /** The rows erased: an entry's revisions, or the memory's one. */
+  rows: number;
+  feedRows: number;
+}
+
+/** The entry's rows gone and the folders its revisions touched noted; the feed's purge rows; the key kept. */
+function eraseEntry(db: Db, uuid: string, touched: Map<string, RepoMeta>, now: number): Erased {
+  const row = entryByUuid(db, uuid);
+  if (row === null) throw unknownItem();
+  for (const revision of revisionsOf(db, row.uuid)) {
+    const place = placeOf(db, revision, row.created_by_member);
+    touched.set(place.relative, place.meta);
+  }
+  const rows = deleteRevisions(db, row.uuid);
+  deleteEntry(db, row.uuid);
+  const feedRows = markPurged(db, row.uuid);
+  insertChange(db, {
+    kind: "entry",
+    uid: entryUid(row.scope as "workspace" | "shared" | "project", row.remote_alias, row.uuid),
+    key: row.uuid,
+    op: "purge",
+    scope: row.scope,
+    remoteAlias: row.remote_alias,
+    revision: row.revision,
+    hash: "",
+    movedTo: null,
+    memberId: OPERATOR.memberId,
+    deviceId: OPERATOR.deviceId,
+    clientEpoch: null,
+    at: now,
+  });
+  insertPurged(db, row.uuid, now);
+  return { rows, feedRows };
+}
+
+/** The memory's row gone; the feed's purge rows; the key kept. */
+function eraseMemory(db: Db, key: string, now: number): Erased {
+  const { deviceId, uid } = splitMemoryKey(key);
+  const row = memoryByKey(db, deviceId, uid);
+  if (row === null) throw unknownItem();
+  deleteMemory(db, deviceId, uid);
+  const feedRows = markPurged(db, key);
+  insertChange(db, {
+    kind: "memory",
+    uid: memoryFeedUid(deviceAlias(db, deviceId), uid),
+    key,
+    op: "purge",
+    scope: "project",
+    remoteAlias: row.remote_alias,
+    revision: row.revision,
+    hash: "",
+    movedTo: null,
+    memberId: OPERATOR.memberId,
+    deviceId: OPERATOR.deviceId,
+    clientEpoch: null,
+    at: now,
+  });
+  insertPurged(db, key, now);
+  return { rows: 1, feedRows };
+}
+
+export interface PurgeResult extends Erased {
+  /** Whether either truncating checkpoint cut the write-ahead log, or a reader held it both times. */
+  wal: "truncated" | "busy";
+  errors: MirrorRun["errors"];
+}
+
+/**
+ * Erasure (D-24), the operator's, under the mirror lease from the first step, so a run in
+ * progress is refused before anything is erased: one transaction removes the item's row (and
+ * an entry's revisions), turns its feed rows into `purge` rows, writes one more `purge` row,
+ * records the key, adds the folders a replay is owed to the note (with those an earlier purge
+ * still owes) and writes the audit row; a truncating checkpoint then cuts the write-ahead log;
+ * then every repository owed is removed and replayed, the note is cleared once that replay is
+ * whole, and the log is cut again once the lease is released. A replay that fails is recorded
+ * in `meta.mirror.last` and in the result, and the next purge or run finishes it.
+ */
+export function purgeItem(
+  ctx: MirrorContext,
+  kind: "entry" | "memory",
+  uid: string,
+  now: number,
+): PurgeResult {
+  const { db } = ctx;
+  const named = parseFeedUid(db, kind, uid, null);
+  if (named === null) throw unknownItem();
+  const { result, failures: errors } = underMirrorLease(
+    ctx,
+    (host, failures) => {
+      const { counts, owed } = transaction(db, () => {
+        const touched = new Map<string, RepoMeta>();
+        const erased =
+          kind === "entry"
+            ? eraseEntry(db, named.key, touched, now)
+            : eraseMemory(db, named.key, now);
+        const noted = noteOwed(db, touched, now);
+        insertAudit(db, {
+          at: now,
+          source: "cli",
+          action: "purged",
+          target: uid,
+          detail: `${kind}: ${erased.rows} rows, ${erased.feedRows} feed rows`,
+        });
+        return { counts: erased, owed: noted };
+      });
+      // Cut once here, so the purged frames do not wait for the replay.
+      const cut = checkpointWal(db);
+      if (owed.size > 0) replayOwed(ctx, host, owed, failures);
+      return { ...counts, cut };
+    },
+    (failures) => {
+      if (failures.length > 0) {
+        setMeta(
+          ctx.db,
+          "mirror.last",
+          JSON.stringify({ at: ctx.now(), commits: 0, error: summary(failures) }),
+        );
+      }
+    },
+  );
+  for (const error of errors) ctx.log.line({ level: "error", event: "mirror-replay", ...error });
+  // And once more with the lease released: the note's clearing and the release wrote frames of
+  // their own. Either cut moves every frame into the file and empties the log, the purged
+  // frames with them.
+  const { cut, ...counts } = result;
+  const wal: PurgeResult["wal"] = checkpointWal(db) || cut ? "truncated" : "busy";
+  return { ...counts, wal, errors };
+}
+
+// --- The child and its schedule --------------------------------------------------------
+
+/** One line of the child's output into the log: its own JSON when it is, the text otherwise. */
+function forwardLine(log: TeamLog, line: string): void {
+  try {
+    const parsed = JSON.parse(line) as Record<string, unknown>;
+    log.line({ ...parsed, child: "mirror" });
+  } catch {
+    log.line({ event: "mirror-output", text: line });
+  }
+}
+
+/**
+ * Runs the export as a child of this process (`command` is this binary's own `serve mirror
+ * --data <dir>` line, or a test's) and forwards its lines to the log; `signal` ends it early.
+ */
+export function spawnMirror(command: string[], log: TeamLog, signal: AbortSignal): Promise<void> {
+  const child = Bun.spawn(command, {
+    stdin: "ignore",
+    stdout: "pipe",
+    stderr: "pipe",
+  });
+  const onAbort = () => child.kill("SIGTERM");
+  signal.addEventListener("abort", onAbort, { once: true });
+  const forward = async (stream: ReadableStream<Uint8Array> | number | undefined) => {
+    if (!(stream instanceof ReadableStream)) return;
+    const text = await new Response(stream).text();
+    for (const line of text.split("\n")) if (line.trim() !== "") forwardLine(log, line);
+  };
+  return Promise.all([forward(child.stdout), forward(child.stderr), child.exited]).then(
+    ([, , code]) => {
+      signal.removeEventListener("abort", onAbort);
+      if (code !== 0) log.line({ level: "warn", event: "mirror-exit", code });
+    },
+  );
+}
+
+export const MIRROR_AFTER_PUSH_MS = 60_000;
+export const MIRROR_STOP_WAIT_MS = 20_000;
+
+export interface MirrorSchedule {
+  afterPush(): void;
+  hourly(): void;
+  stop(): Promise<void>;
+  child(): Promise<void> | null;
+}
+
+/**
+ * One timer and at most one child: a push arms or re-arms the quiet-minute timer, the hourly
+ * tick and the timer both run the export unless a run is alive; `stop` clears the timer,
+ * signals the child and waits for it, for at most `MIRROR_STOP_WAIT_MS`, leaving no timer.
+ */
+export function scheduleMirror(
+  ctx: { dataDir: string; log: TeamLog },
+  timers: Timers,
+  run: (dataDir: string, signal: AbortSignal) => Promise<void>,
+): MirrorSchedule {
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  let child: { done: Promise<void>; controller: AbortController } | null = null;
+  const launch = () => {
+    if (child !== null) return;
+    const controller = new AbortController();
+    const done = run(ctx.dataDir, controller.signal)
+      .catch((error: unknown) => ctx.log.error("team.mirror", error))
+      .finally(() => {
+        child = null;
+      });
+    child = { done, controller };
+  };
+  return {
+    afterPush: () => {
+      if (timer !== null) timers.clearTimeout(timer);
+      timer = timers.setTimeout(() => {
+        timer = null;
+        launch();
+      }, MIRROR_AFTER_PUSH_MS);
+    },
+    hourly: launch,
+    child: () => child?.done ?? null,
+    stop: async () => {
+      if (timer !== null) {
+        timers.clearTimeout(timer);
+        timer = null;
+      }
+      const running = child;
+      if (running === null) return;
+      running.controller.abort();
+      await new Promise<void>((resolve) => {
+        const limit = timers.setTimeout(resolve, MIRROR_STOP_WAIT_MS);
+        running.done.then(() => {
+          timers.clearTimeout(limit);
+          resolve();
+        });
+      });
+    },
+  };
+}
